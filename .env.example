# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Core server ----
APP_ENV=development
APP_PORT=8080
# Public base URL the server is reached at (used to build Paystack callback
# URLs and any other absolute links). No trailing slash.
APP_BASE_URL=http://localhost:8080

# ---- Database ----
# Normal tenant traffic. In Docker Compose this is the gatstogo_app role
# (restricted, subject to Row Level Security). Rotated via
# GATSTOGO_APP_ROLE_PASSWORD below, not set directly here in that setup.
APP_DATABASE_URL=postgres://gatstogo_app:change_this_strong_password_app@localhost:5432/gatstogo?sslmode=disable
# Platform-level reads/writes (admin console, cross-tenant lookups, plant
# provisioning). The gatstogo_admin role, which bypasses Row Level Security.
ADMIN_DATABASE_URL=postgres://gatstogo_admin:change_this_strong_password_admin@localhost:5432/gatstogo?sslmode=disable

# Passwords applied to the gatstogo_app / gatstogo_admin Postgres roles by
# migrations/0003_role_credentials.up.sql (via the docker-compose `migrate`
# service). Must match the passwords embedded in APP_DATABASE_URL /
# ADMIN_DATABASE_URL above. Rotate these for any real deployment.
GATSTOGO_APP_ROLE_PASSWORD=change_this_strong_password_app
GATSTOGO_ADMIN_ROLE_PASSWORD=change_this_strong_password_admin

# ---- Sessions (Redis) ----
REDIS_URL=redis://localhost:6379/0

# Server-side secret used to derive CSRF tokens for authenticated sessions
# (HMAC key) and to sign/encrypt anything else session-related that needs a
# static server secret. Generate with: openssl rand -base64 32
SESSION_HMAC_SECRET=

# ---- Payments (Paystack) ----
# https://dashboard.paystack.com/#/settings/developers
# Same secret key is used both to call the API and to verify the
# X-Paystack-Signature header on incoming webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- SMS ----
# No real provider is wired up yet (see internal/sms) -- messages are only
# logged. Left here as a placeholder for when one is added.
SMS_PROVIDER=logging
