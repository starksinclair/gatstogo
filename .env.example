# Copy to .env and fill in real values. Never commit the real .env file.
#
# Teammate quickstart:
#   make env && make up
# Full DB / Neon / Cloud Run guide: docs/DATABASE.md

# ---- Core server ----
APP_ENV=development
APP_PORT=8080
# Public base URL the server is reached at (used to build Paystack callback
# URLs and any other absolute links). No trailing slash.
APP_BASE_URL=http://localhost:8080

# This app's own real domain, no subdomain, no scheme, no trailing dot --
# "gatstogo.ng" in production, "localhost" for the local dev loop
# (sunrise.localhost:8080). Required: internal/middleware.Tenant refuses to
# resolve a plant for any request whose Host isn't exactly
# "<slug>.APP_BASE_DOMAIN" (optionally with a :port). This is a real
# security boundary, not just routing config -- get it wrong (or leave it
# matching an attacker-reachable value) and a spoofed Host header can
# resolve a real tenant plant, which several handlers then trust to build
# absolute URLs (most seriously, the owner "forgot password" email's reset
# link).
APP_BASE_DOMAIN=localhost

# ---- Database ----
# Local Docker Compose builds APP_DATABASE_URL / ADMIN_DATABASE_URL inside
# the container from GATSTOGO_*_ROLE_PASSWORD below (host "postgres").
# The two lines here are only for running the server on the host against
# compose Postgres (mapped to localhost:5435) or a local Postgres.
#
# Neon (Cloud Run): see docs/DATABASE.md -- migrate with MIGRATE_DATABASE_URL
# (direct owner), run the app with pooled gatstogo_app / gatstogo_admin URLs.
# APP_DATABASE_URL=postgres://gatstogo_app:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require
# ADMIN_DATABASE_URL=postgres://gatstogo_admin:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require
APP_DATABASE_URL=postgres://gatstogo_app:change_this_strong_password_app@localhost:5435/gatstogo?sslmode=disable
ADMIN_DATABASE_URL=postgres://gatstogo_admin:change_this_strong_password_admin@localhost:5435/gatstogo?sslmode=disable

# Passwords applied to gatstogo_app / gatstogo_admin by migration 0003
# (via `gtg migrate` / the compose migrate service). Must match the
# passwords embedded in the URLs above when not using compose's constructed URLs.
GATSTOGO_APP_ROLE_PASSWORD=change_this_strong_password_app
GATSTOGO_ADMIN_ROLE_PASSWORD=change_this_strong_password_admin

# Neon migrate only (owner + direct host, not pooler). Unused by docker compose.
# MIGRATE_DATABASE_URL=postgres://neondb_owner:SECRET@ep-xxxx.eu-west-2.aws.neon.tech/gatstogo?sslmode=require

# ---- Sessions (Redis) ----
# Compose overrides this to redis://redis:6379/0 inside the app container.
REDIS_URL=redis://localhost:6379/0

# Server-side secret used to derive CSRF tokens for authenticated sessions
# (HMAC key). Must be base64 and decode to ≥16 bytes.
# Local teammate default (NOT for production). Rotate with:
#   openssl rand -base64 32
SESSION_HMAC_SECRET=dGVhbW1hdGUtbG9jYWwtZGV2LWhtYWMtMzJiISE=

# ---- Payments (Paystack) ----
# https://dashboard.paystack.com/#/settings/developers
# Required at startup. Use a test secret for local; buy-gas needs a real sk_test_*.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_key
PAYSTACK_PUBLIC_KEY=

# Real, deliverable inbox GatsToGo controls. Paystack's Initialize API
# requires an email per transaction even though the customer buy form only
# collects a name and phone number; each ticket gets a unique
# {this}+{reference}@... variant (Gmail-style "+tag" addressing) so mail
# still lands here but stays distinguishable per ticket. Optional --
# defaults to gatstogofficial@gmail.com if unset.
TICKET_NOTIFICATION_EMAIL=gatstogofficial@gmail.com

# ---- Email (Resend) ----
# Optional: if unset, reset emails are only logged (LoggingSender).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- SMS ----
# Use logging for local/dev. Use termii in production once the values below
# are set from your Termii dashboard.
SMS_PROVIDER=logging
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com
