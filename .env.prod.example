# Production / Cloud Run example. Copy values into Secret Manager or
# `gcloud run services update ... --set-env-vars` / `--set-secrets`.
# Never commit real values. Local Docker uses `.env` (see .env.example).
# Full walkthrough: docs/DATABASE.md

# ---- Core server (required) ----
APP_ENV=production
# Cloud Run injects PORT; leave APP_PORT unset in Cloud Run.
# APP_PORT=8080

# Public HTTPS origin of this Cloud Run service (or custom domain), no
# trailing slash. Used for Paystack callbacks and absolute links.
APP_BASE_URL=https://YOUR-SERVICE-XXXX.europe-west2.run.app

# Apex domain for tenant hosts: <slug>.APP_BASE_DOMAIN
# Prefer one domain for marketing + plants (e.g. gatstogo.com).
APP_BASE_DOMAIN=gatstogo.com

# ---- Database (Neon) — required at runtime ----
# Create roles via `gtg migrate` first (MIGRATE_DATABASE_URL = direct owner).
# Cloud Run must use the *pooled* endpoint + sslmode=require.
APP_DATABASE_URL=postgres://gatstogo_app:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require
ADMIN_DATABASE_URL=postgres://gatstogo_admin:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require

# Laptop/CI migrate only (direct host). Not needed on the Cloud Run service.
# MIGRATE_DATABASE_URL=postgres://neondb_owner:SECRET@ep-xxxx.eu-west-2.aws.neon.tech/gatstogo?sslmode=require
# GATSTOGO_APP_ROLE_PASSWORD=...
# GATSTOGO_ADMIN_ROLE_PASSWORD=...

# ---- Sessions (Upstash Redis) — required ----
REDIS_URL=rediss://default:SECRET@xxxxx.upstash.io:6379

# Generate: openssl rand -base64 32
SESSION_HMAC_SECRET=

# ---- Payments (Paystack) — required ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TICKET_NOTIFICATION_EMAIL=gatstogofficial@gmail.com

# ---- Email (Resend) — optional ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=GatsToGo <noreply@gatstogo.com>

# ---- SMS — optional ----
# Set SMS_PROVIDER=termii when TERMII_* values are configured.
SMS_PROVIDER=logging
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_BASE_URL=https://api.ng.termii.com

# ---- Plant logos (GCS) — optional; not wired in code yet ----
# GCS_BUCKET=gatstogo-plant-logos
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/gatstogo-plant-logos
