# Production / Cloud Run example. Copy to a secret manager or
# `gcloud run services update ... --set-env-vars` / `--set-secrets`.
# Never commit real values. Local Docker still uses `.env` (see .env.example).

# ---- Core server ----
APP_ENV=production
# Cloud Run injects PORT; leave APP_PORT unset in Cloud Run.
# APP_PORT=8080

# Public HTTPS origin of this Cloud Run service (or custom domain), no
# trailing slash. Used for Paystack callbacks and absolute links.
APP_BASE_URL=https://gatstogo-xxxxx-ew.a.run.app

# Apex domain for tenant hosts: <slug>.APP_BASE_DOMAIN
# Example production: gatstogo.ng  →  sunrise.gatstogo.ng
APP_BASE_DOMAIN=gatstogo.ng

# ---- Database (Neon) ----
# Create two Postgres roles in the same Neon project (gatstogo_app with RLS,
# gatstogo_admin that bypasses RLS), matching migrations/0001 + 0003.
# Use Neon's *pooled* endpoint for Cloud Run; use the *direct* endpoint
# when running migrations.
# Region: pick the same metro as Cloud Run (e.g. europe-west2 / AWS eu-west-2).
APP_DATABASE_URL=postgres://gatstogo_app:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require
ADMIN_DATABASE_URL=postgres://gatstogo_admin:SECRET@ep-xxxx-pooler.eu-west-2.aws.neon.tech/gatstogo?sslmode=require

# Only needed when applying migrations against Neon (direct host, not pooler):
# GATSTOGO_APP_ROLE_PASSWORD=...
# GATSTOGO_ADMIN_ROLE_PASSWORD=...

# ---- Sessions (Upstash Redis) ----
# Upstash console → Redis → Connect → Redis URL (TLS).
# Example shape (rediss = TLS):
REDIS_URL=rediss://default:SECRET@xxxxx.upstash.io:6379

# Generate: openssl rand -base64 32
SESSION_HMAC_SECRET=

# ---- Plant logos (GCS) ----
# Bucket for uploaded plant logos. Cloud Run should use the runtime service
# account (ADC) with roles/storage.objectAdmin on this bucket -- no JSON
# key file in the container.
# Code still writes local disk today (internal/uploads); these vars are the
# intended contract once logos move to GCS.
GCS_BUCKET=gatstogo-plant-logos
# Public base URL for objects (bucket with public read, or a CDN / load
# balancer in front). Stored paths in plants.logo_path should resolve under
# this base, e.g. https://storage.googleapis.com/gatstogo-plant-logos/...
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/gatstogo-plant-logos
# Optional if not using the default Cloud Run project credentials:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ---- Payments (Paystack) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
TICKET_NOTIFICATION_EMAIL=gatstogofficial@gmail.com

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=GatsToGo <noreply@gatstogo.ng>

# ---- SMS ----
SMS_PROVIDER=logging
