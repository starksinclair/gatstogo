package pages

import "gatstogo/web/templates/components"

// This file backs the owner "forgot password" flow (cmd/server/auth.go's
// ownerForgotPassword*/ownerResetPassword* handlers) -- two small pages
// reusing authShell's (owner_login.templ) exact visual chrome (the same
// split-screen photo/branding, and every CSS class it already relies on
// in owner-admin.css) rather than generalizing authShell itself into a
// shared shell + swappable content slot. authShell's own form markup is
// hardcoded inline, not already split out that way, and touching it here
// would mean changing a signature two other pages (OwnerLogin, AdminLogin)
// already call -- a real refactor to save avoiding some duplication
// between two small, unlikely-to-diverge-further pages, not something
// this pass needs. Same small-duplication precedent already used
// elsewhere this build (e.g. splashOverlay's wiring script, duplicated
// rather than shared between opsShell and authShell).

// OwnerForgotPassword: enter a phone number, get a generic "if an account
// exists" confirmation either way -- see ownerForgotPasswordSubmitHandler
// for why (anti-enumeration: a phone-number-exists oracle is real
// information to withhold from an unauthenticated visitor).
templ OwnerForgotPassword(plantName string, errorMsg string, submitted bool, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ plantName } owner sign in</title>
			<link rel="icon" type="image/png" href="/static/images/gatstogo.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/owner-admin.css"/>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					var splashOverlay = document.querySelector("[data-splash-overlay]");
					if (!splashOverlay) return;
					var splashMessage = splashOverlay.querySelector("[data-splash-message]");
					document.querySelectorAll("form[data-splash]").forEach(function (form) {
						form.addEventListener("submit", function () {
							if (splashMessage) splashMessage.textContent = form.dataset.splash;
							splashOverlay.hidden = false;
							requestAnimationFrame(function () { splashOverlay.classList.add("open"); });
						});
					});
				});
			</script>
		</head>
		<body>
			<div class="login-page">
				<div class="login-visual">
					<a class="login-visual-brand" href="/">
						<img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/>
						<span>GATSTOGO</span>
					</a>
					<div class="login-visual-copy">
						<h2>Run your plant from anywhere.</h2>
						<p>Sign in to see today's sales, cash position, and shift activity, live.</p>
					</div>
				</div>
				<div class="login-form-col">
					if submitted {
						<div class="login-card">
							<div class="login-brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>GATSTOGO</span></div>
							<div>
								<h1>Check your email</h1>
								<p class="login-sub">If an account exists for that phone number, we've sent password reset instructions to the email on file. The link expires in an hour.</p>
							</div>
							<a class="btn primary full-width" href="/owner/login" style="text-decoration:none;">Back to sign in</a>
						</div>
					} else {
						<form class="login-card" method="post" action="/owner/forgot-password" data-splash="Sending reset link">
							<div class="login-brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>GATSTOGO</span></div>
							<div>
								<h1>Forgot your password?</h1>
								<p class="login-sub">Enter your phone number and we'll email a reset link to the address on file.</p>
							</div>
							if errorMsg != "" {
								<div class="owner-error login-error">
									@components.Icon("warning-circle")
									{ errorMsg }
								</div>
							}
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<div class="field">
								<label for="phone">Phone number</label>
								<input id="phone" type="tel" name="phone" placeholder="0803 000 0000" autocomplete="tel" required autofocus/>
							</div>
							<button class="btn primary full-width" type="submit">Send reset link</button>
							<p class="login-sub" style="margin-top:4px;"><a href="/owner/login">Back to sign in</a></p>
						</form>
					}
				</div>
			</div>
			@splashOverlay()
		</body>
	</html>
}

// OwnerResetPassword: set a new password, from a link with a real,
// unexpired token (tokenValid, checked non-destructively via
// passwordreset.Peek at GET time -- see ownerResetPasswordPageHandler).
// An invalid/expired token shows a dead end with a link back to request a
// new one, instead of a form that's just going to fail at submission.
templ OwnerResetPassword(plantName string, errorMsg string, token string, tokenValid bool, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ plantName } owner sign in</title>
			<link rel="icon" type="image/png" href="/static/images/gatstogo.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/owner-admin.css"/>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					var splashOverlay = document.querySelector("[data-splash-overlay]");
					if (!splashOverlay) return;
					var splashMessage = splashOverlay.querySelector("[data-splash-message]");
					document.querySelectorAll("form[data-splash]").forEach(function (form) {
						form.addEventListener("submit", function () {
							if (splashMessage) splashMessage.textContent = form.dataset.splash;
							splashOverlay.hidden = false;
							requestAnimationFrame(function () { splashOverlay.classList.add("open"); });
						});
					});

					document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
						var input = document.getElementById(button.dataset.passwordToggle);
						if (!input) return;
						button.addEventListener("click", function () {
							var showing = input.type === "text";
							input.type = showing ? "password" : "text";
							button.setAttribute("aria-label", showing ? "Show password" : "Hide password");
							button.innerHTML = showing
								? '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"/></svg>'
								: '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M53.92,34.62A8,8,0,1,0,42.08,45.38L61.32,66.55C25,88.84,9.38,123.2,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208a127.11,127.11,0,0,0,52.07-10.83l22,24.21a8,8,0,1,0,11.84-10.76Zm47.33,75.84,41.67,45.85a32,32,0,0,1-41.67-45.85ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.16,133.16,0,0,1,25,128c4.69-8.79,19.66-33.39,47.35-49.38l18,19.75a48,48,0,0,0,63.66,70l14.73,16.2A112,112,0,0,1,128,192Zm6-95.43a8,8,0,0,1,3-15.72,48.16,48.16,0,0,1,38.77,42.64,8,8,0,0,1-7.22,8.71,6.39,6.39,0,0,1-.75,0,8,8,0,0,1-8-7.26A32.09,32.09,0,0,0,134,96.57Zm113.28,34.69c-.42.94-10.55,23.37-33.36,43.8a8,8,0,1,1-10.67-11.92A132.77,132.77,0,0,0,231.05,128a133.15,133.15,0,0,0-23.12-30.77C185.67,75.19,158.78,64,128,64a118.37,118.37,0,0,0-19.36,1.57A8,8,0,1,1,106,49.79,134,134,0,0,1,128,48c34.88,0,66.57,13.26,91.66,38.35,18.83,18.83,27.3,37.62,27.65,38.41A8,8,0,0,1,247.31,131.26Z"/></svg>';
						});
					});
				});
			</script>
		</head>
		<body>
			<div class="login-page">
				<div class="login-visual">
					<a class="login-visual-brand" href="/">
						<img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/>
						<span>GATSTOGO</span>
					</a>
					<div class="login-visual-copy">
						<h2>Run your plant from anywhere.</h2>
						<p>Sign in to see today's sales, cash position, and shift activity, live.</p>
					</div>
				</div>
				<div class="login-form-col">
					if !tokenValid {
						<div class="login-card">
							<div class="login-brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>GATSTOGO</span></div>
							<div>
								<h1>This link is invalid or expired</h1>
								<p class="login-sub">Password reset links only work once, and expire after an hour. Request a new one below.</p>
							</div>
							<a class="btn primary full-width" href="/owner/forgot-password" style="text-decoration:none;">Request a new link</a>
						</div>
					} else {
						<form class="login-card" method="post" action="/owner/reset-password" data-splash="Resetting password">
							<div class="login-brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>GATSTOGO</span></div>
							<div>
								<h1>Set a new password</h1>
								<p class="login-sub">Choose a new password for your owner login.</p>
							</div>
							if errorMsg != "" {
								<div class="owner-error login-error">
									@components.Icon("warning-circle")
									{ errorMsg }
								</div>
							}
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="token" value={ token }/>
							<div class="field">
								<label for="new-password">New password</label>
								<div class="field-password">
									<input id="new-password" type="password" name="new_password" autocomplete="new-password" required autofocus/>
									<button type="button" class="field-password-toggle" data-password-toggle="new-password" aria-label="Show password">
										@components.Icon("eye")
									</button>
								</div>
							</div>
							<div class="field">
								<label for="new-password-confirm">Confirm new password</label>
								<input id="new-password-confirm" type="password" name="new_password_confirm" autocomplete="new-password" required/>
							</div>
							<button class="btn primary full-width" type="submit">Reset password</button>
						</form>
					}
				</div>
			</div>
			@splashOverlay()
		</body>
	</html>
}
