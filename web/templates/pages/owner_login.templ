package pages

templ OwnerLogin(plantName string, errorMsg string, csrfToken string) {
	@authShell(plantName+" owner sign in", "Owner sign in", errorMsg, "/owner/login", csrfToken)
}

templ authShell(title string, heading string, errorMsg string, action string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/static/images/gatstogo.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/owner-admin.css"/>
		</head>
		<body>
			<div class="login-page">
				<form class="panel panel-pad login-card" method="post" action={ templ.SafeURL(action) }>
					<div class="login-brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>GATSTOGO</span></div>
					<h1>{ heading }</h1>
					if errorMsg != "" {
						<div class="badge badge-danger login-error">{ errorMsg }</div>
					}
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="field">
						<label>Phone number</label>
						<input type="tel" name="phone" placeholder="0803 000 0000" autocomplete="tel" required autofocus/>
					</div>
					<div class="field">
						<label>Password</label>
						<input type="password" name="password" autocomplete="current-password" required/>
					</div>
					<button class="btn primary full-width" type="submit">Sign in</button>
				</form>
			</div>
		</body>
	</html>
}
