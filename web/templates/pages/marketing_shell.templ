package pages

import (
	"time"

	"gatstogo/web/templates/components"
)

// currentYear feeds the footer's copyright line -- computed at render
// time rather than hardcoded, so it doesn't go stale.
func currentYear() int {
	return time.Now().Year()
}

// marketingPageShell wraps every public marketing page (landing, pricing,
// about, legal, signup) in one shared header + footer. This is GatsToGo's
// own fixed platform identity, not tenant-themed like customerPageShell
// in customer_home.templ -- there's no per-plant color/logo here, just
// marketing.css's own :root palette.
templ marketingPageShell(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/static/images/gatstogo.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/marketing.css"/>
			<script>
				// Themed <select> replacement -- see themedSelect
				// (owner_admin.templ) for the shared markup this wires up
				// and why (CSS alone can restyle a <select>'s closed box
				// but never its open dropdown list cross-browser).
				// Progressive enhancement: the real <select name="...">
				// stays in the DOM and is still exactly what gets
				// submitted with the form; marketing.css only hides it (in
				// favor of the custom trigger+listbox) once a shell has
				// the js-ready class this loop adds, so a page where this
				// script fails to run still has a fully working, if
				// plainer, native dropdown instead of nothing. Exact same
				// wiring as opsShell's own copy (owner_admin.templ) --
				// duplicated rather than shared, since the admin console
				// and the public marketing site don't otherwise share a
				// script file to put this in.
				document.addEventListener("DOMContentLoaded", function () {
					document.querySelectorAll("[data-select]").forEach(function (shell) {
						var nativeSelect = shell.querySelector(".select-native");
						var trigger = shell.querySelector(".select-trigger");
						var valueLabel = shell.querySelector(".select-value");
						var list = shell.querySelector(".select-list");
						var items = Array.prototype.slice.call(list ? list.querySelectorAll('[role="option"]') : []);
						if (!nativeSelect || !trigger || !list || !items.length) return;

						var highlighted = 0;

						function syncFromNative() {
							items.forEach(function (li, i) {
								var isSelected = li.dataset.value === nativeSelect.value;
								li.setAttribute("aria-selected", isSelected ? "true" : "false");
								li.classList.toggle("selected", isSelected);
								if (isSelected) {
									valueLabel.textContent = li.textContent;
									highlighted = i;
								}
							});
						}
						function highlightItem(index) {
							items.forEach(function (li, i) { li.classList.toggle("highlighted", i === index); });
							if (items[index].scrollIntoView) items[index].scrollIntoView({ block: "nearest" });
						}
						function openList() {
							document.querySelectorAll(".select-shell.open").forEach(function (openShell) {
								if (openShell !== shell) closeList(openShell);
							});
							shell.classList.add("open");
							trigger.setAttribute("aria-expanded", "true");
							list.hidden = false;
							highlightItem(highlighted);
						}
						function closeList(target) {
							target = target || shell;
							target.classList.remove("open");
							target.querySelector(".select-trigger").setAttribute("aria-expanded", "false");
							target.querySelector(".select-list").hidden = true;
						}
						function selectItem(index) {
							var li = items[index];
							if (!li) return;
							nativeSelect.value = li.dataset.value;
							nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
							syncFromNative();
							closeList();
							trigger.focus();
						}

						trigger.addEventListener("click", function () {
							shell.classList.contains("open") ? closeList() : openList();
						});
						trigger.addEventListener("keydown", function (event) {
							if (event.key === "ArrowDown" || event.key === "ArrowUp") {
								event.preventDefault();
								if (!shell.classList.contains("open")) { openList(); return; }
								var dir = event.key === "ArrowDown" ? 1 : -1;
								highlighted = (highlighted + dir + items.length) % items.length;
								highlightItem(highlighted);
							} else if (event.key === "Enter" || event.key === " ") {
								event.preventDefault();
								shell.classList.contains("open") ? selectItem(highlighted) : openList();
							} else if (event.key === "Escape" && shell.classList.contains("open")) {
								event.preventDefault();
								closeList();
							}
						});
						items.forEach(function (li, i) {
							li.addEventListener("click", function () { selectItem(i); });
							li.addEventListener("mouseenter", function () { highlighted = i; highlightItem(i); });
						});
						document.addEventListener("click", function (event) {
							if (shell.classList.contains("open") && !shell.contains(event.target)) closeList();
						});

						syncFromNative();
						nativeSelect.setAttribute("tabindex", "-1");
						nativeSelect.setAttribute("aria-hidden", "true");
						shell.classList.add("js-ready");
					});
				});
			</script>
		</head>
		<body>
			@marketingHeader()
			@content
			@marketingFooter()
		</body>
	</html>
}

templ marketingHeader() {
	<header class="mkt-header">
		<div class="mkt-header-inner">
			<a class="brand-lockup" href="/">
				<img class="brand-mark" src="/static/images/gatstogo.png" alt="GatsToGo"/>
				<strong>GATSTOGO</strong>
			</a>
			<nav class="mkt-nav">
				<a href="/#how-it-works">How it works</a>
				<a href="/pricing">Pricing</a>
				<a href="/about">About</a>
			</nav>
			<div class="mkt-header-actions">
				<a class="button-primary" href="/get-started">
					Get started
					@components.Icon("arrow-right")
				</a>
			</div>
		</div>
	</header>
}

templ marketingFooter() {
	<footer class="mkt-footer">
		<div class="wrap">
			<div class="mkt-footer-top">
				<div class="brand-lockup">
					<img class="brand-mark" src="/static/images/gatstogo.png" alt="GatsToGo"/>
					<strong>GATSTOGO</strong>
				</div>
				<p class="mkt-footer-tagline">Sales, staff, and receipts for LPG plants, in one place: a branded page for customers to buy gas, a terminal for staff to redeem and fill, and a live dashboard for owners.</p>
			</div>
			<div class="mkt-footer-cols">
				<div>
					<div class="mkt-footer-heading">Product</div>
					<a href="/#how-it-works">How it works</a>
					<a href="/pricing">Pricing</a>
					<a href="/get-started">Get started</a>
				</div>
				<div>
					<div class="mkt-footer-heading">Company</div>
					<a href="/about">About</a>
				</div>
				<div>
					<div class="mkt-footer-heading">Legal</div>
					<a href="/terms">Terms of Service</a>
					<a href="/privacy">Privacy Policy</a>
				</div>
			</div>
			<div class="mkt-footer-bottom">
				<span>© { currentYear() } GatsToGo. All rights reserved.</span>
			</div>
		</div>
	</footer>
}
