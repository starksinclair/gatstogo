package pages

import (
	"strconv"

	"gatstogo/internal/payments"
	"gatstogo/web/templates/components"
)

// SignupViewData backs GET/POST /get-started (cmd/server/marketing.go).
// Password fields are deliberately never echoed back on a validation
// error -- everything else is, so a mistyped price doesn't cost the
// visitor re-typing their whole plant name and slug too.
type SignupViewData struct {
	CSRFToken string
	ErrorMsg  string
	Submitted bool

	Name    string
	Slug    string
	City    string
	Address string
	Phone   string
	State   string

	LegalBusinessName   string
	CACNumber           string
	NMDPRALicenseNumber string

	BankCode          string
	BankAccountNumber string
	// Banks backs the Bank <select> -- live-fetched (with fallback) once
	// per page render, see payments.Client.BanksWithFallback.
	Banks []payments.Bank

	OwnerName     string
	OwnerPhone    string
	OwnerEmail    string
	StartingPrice string

	PrimaryColor    string
	ButtonColor     string
	SecondaryColor  string
	ButtonTextColor string

	// Tab is the /get-started tab that opens first: "owner" or "buyer".
	Tab string
	// Source tags where a buyer came from (?src=); saved with the sign-up.
	Source string

	// The two launch-offer counters are independent: founding plant
	// applications and registered gas buyers each count toward their own 50.
	OwnerSpotsClaimed int
	OwnerSpotsTotal   int
	BuyerSpotsClaimed int
	BuyerSpotsTotal   int

	BuyerErrorMsg  string
	BuyerSubmitted bool
	BuyerOfferRank int
	BuyerName      string
	BuyerPhone     string
	BuyerEmail     string
	BuyerState     string
}

const (
	socialXURL        = "https://x.com/Gatstogo"
	socialFacebookURL = "https://www.facebook.com/1437783132749660"
)

const buyerShareURL = "https://wa.me/?text=Hello%2C%20I%27d%20like%20to%20buy%20gas%20from%20you%20online%20and%20pay%20from%20my%20phone.%20Gas%20plants%20can%20set%20up%20for%20free%20on%20GatsToGo%3A%20https%3A%2F%2Fgatstogo.com%2Fget-started"

func spotsLeft(claimed int, total int) int {
	if claimed >= total {
		return 0
	}
	return total - claimed
}

func spotsPercent(claimed int, total int) int {
	if total <= 0 || claimed <= 0 {
		return 0
	}
	if claimed >= total {
		return 100
	}
	return claimed * 100 / total
}

templ Signup(data SignupViewData) {
	@marketingPageShell("Get started | GatsToGo", signupContent(data))
}

// socialLinks is the "follow us" strip shown on both forms and in both
// success messages so launch updates reach people who sign up.
templ socialLinks(heading string) {
	<div class="social-follow">
		<span class="social-follow-label">{ heading }</span>
		<div class="social-follow-links">
			<a class="social-link" href={ templ.SafeURL(socialXURL) } target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
				<span>Follow on X</span>
			</a>
			<a class="social-link" href={ templ.SafeURL(socialFacebookURL) } target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21.9v-8.2h2.8l.5-3.3h-3.3V8.3c0-.9.4-1.7 1.8-1.7h1.6V3.7c-.3 0-1.3-.2-2.4-.2-2.5 0-4.1 1.5-4.1 4.2v2.7H7.7v3.3h2.7v8.2z"></path></svg>
				<span>Like us on Facebook</span>
			</a>
		</div>
	</div>
}

// spotsBanner is the launch-offer counter: an empty-state invitation while
// nobody has claimed a spot yet, then a live "N of 50 left" bar.
templ spotsBanner(kind string, claimed int, total int, emptyTitle string, emptyText string, liveLabel string, fullText string) {
	if claimed <= 0 {
		<div class="spots-banner spots-empty" data-spots={ kind }>
			<svg class="spots-medal" viewBox="0 0 64 64" aria-hidden="true">
				<circle cx="32" cy="26" r="18" fill="#006B4D"></circle>
				<circle cx="32" cy="26" r="12" fill="none" stroke="#10B981" stroke-width="3"></circle>
				<path d="M22 42l-6 16 12-5 4 8 4-14zM42 42l6 16-12-5-4 8-4-14z" fill="#10B981"></path>
				<path d="M32 18l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.8z" fill="#FFFFFF"></path>
			</svg>
			<div class="spots-empty-body">
				<strong>{ emptyTitle }</strong>
				<p>{ emptyText }</p>
				<div class="spots-count spots-count-inline"><span class="spots-num">{ strconv.Itoa(spotsLeft(claimed, total)) }</span><span class="spots-of">of { strconv.Itoa(total) } { liveLabel }</span></div>
				<div class="spots-bar" role="img" aria-label={ strconv.Itoa(spotsLeft(claimed, total)) + " of " + strconv.Itoa(total) + " spots left" }><span style="width:0%"></span></div>
			</div>
		</div>
	} else if claimed >= total {
		<div class="spots-banner spots-full" data-spots={ kind }>
			<div class="spots-count"><span class="spots-num">0</span><span class="spots-of">of { strconv.Itoa(total) } { liveLabel }</span></div>
			<div class="spots-full-body">
				<strong>All { strconv.Itoa(total) } spots are gone</strong>
				<p>{ fullText }</p>
			</div>
			<div class="spots-bar" role="img" aria-label="No spots left"><span style="width:100%"></span></div>
		</div>
	} else {
		<div class="spots-banner" data-spots={ kind }>
			<div class="spots-count"><span class="spots-num">{ strconv.Itoa(spotsLeft(claimed, total)) }</span><span class="spots-of">of { strconv.Itoa(total) } { liveLabel }</span></div>
			<div class="spots-bar" role="img" aria-label={ strconv.Itoa(spotsLeft(claimed, total)) + " of " + strconv.Itoa(total) + " spots left" }><span style={ "width:" + strconv.Itoa(spotsPercent(claimed, total)) + "%" }></span></div>
		</div>
	}
}

templ signupContent(data SignupViewData) {
	<main>
		if data.Submitted {
			<div class="signup-submitted">
				<div class="icon-badge">
					@components.Icon("check-circle")
				</div>
				<h1>We've got your application</h1>
				<p>Thanks for telling us about your plant. Your page is now under review, so it will not go live yet. Look out for our email and SMS: once we verify your information, we'll contact you and confirm your platform login details.</p>
				@socialLinks("Follow us for launch updates")
				<a class="button-primary" href="/">Back to homepage</a>
			</div>
		} else if data.BuyerSubmitted {
			<div class="signup-submitted">
				<div class="icon-badge">
					@components.Icon("check-circle")
				</div>
				<h1>You're on the list</h1>
				if data.BuyerOfferRank > 0 {
					<p>You've got offer spot <strong>{ strconv.Itoa(data.BuyerOfferRank) } of 50</strong>: ₦1,000 off your first gas order on GatsToGo. We'll text you when a gas plant near you goes live.</p>
				} else {
					<p>The first 50 offers are taken, but we'll still text you when a gas plant near you goes live.</p>
				}
				<p>The more plants join, the sooner you can buy. Know a gas station near you? Tell them about GatsToGo.</p>
				@socialLinks("Follow us for launch updates")
				<a class="button-primary" href={ templ.SafeURL(buyerShareURL) } target="_blank" rel="noopener">Tell my gas plant on WhatsApp</a>
			</div>
		} else {
			<div class="signup-tabs" role="tablist" aria-label="Who are you?">
				<button type="button" role="tab" class="signup-tab" data-tab-btn="owner" aria-selected={ strconv.FormatBool(data.Tab != "buyer") }>I sell gas</button>
				<button type="button" role="tab" class="signup-tab" data-tab-btn="buyer" aria-selected={ strconv.FormatBool(data.Tab == "buyer") }>I buy gas</button>
			</div>
			<div class="signup-panel" data-tab-panel="buyer" hidden?={ data.Tab != "buyer" }>
				<div class="signup-layout signup-split signup-buyer">
					<div class="signup-head">
						<div class="section-eyebrow">For gas buyers</div>
						<h1>Get ₦1,000 off your first gas order</h1>
						<p class="lede">Tell us where you are. We'll text you when a gas plant near you joins GatsToGo, so you can pay from your phone and skip the queue.</p>
						@spotsBanner("buyer", data.BuyerSpotsClaimed, data.BuyerSpotsTotal,
							"Be the first customer to use our service",
							"The first buyer gets ₦1,000 off their first order, and we'll shout you out on our social media.",
							"₦1,000 offers left",
							"This offer has been claimed by 50 buyers, but you can still join the list and we'll text you when a plant near you goes live.")
						@socialLinks("Follow us for launch updates")
						if data.BuyerErrorMsg != "" {
							<div class="inline-alert">
								@components.Icon("warning-circle")
								{ data.BuyerErrorMsg }
							</div>
						}
					</div>
					<aside class="signup-aside">
						<div class="signup-aside-block">
							<div class="signup-aside-title">What you get</div>
							<ul class="signup-ready">
								<li>@components.Icon("check-circle") <span><strong>₦1,000 off</strong> Your first gas order on GatsToGo</span></li>
								<li>@components.Icon("phone") <span><strong>A text from us</strong> When a gas plant near you goes live</span></li>
								<li>@components.Icon("shield-check") <span><strong>No payment now</strong> Just your name, phone and state</span></li>
							</ul>
						</div>
						<div class="signup-aside-block signup-aside-next">
							<div class="signup-aside-title">What happens next</div>
							<ol class="signup-next">
								<li><strong>You register</strong> It takes under a minute.</li>
								<li><strong>Tell your gas plant</strong> We give you a message to send them on WhatsApp.</li>
								<li><strong>Buy and save</strong> Pay from your phone and get ₦1,000 off.</li>
							</ol>
						</div>
					</aside>
					<form class="signup-form" method="post" action="/get-started/buyer">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<input type="hidden" name="src" value={ data.Source }/>
						<div class="field-underline">
							<label for="buyer_name">Your name</label>
							<input id="buyer_name" type="text" name="buyer_name" value={ data.BuyerName } placeholder="Ada Nwosu" required/>
						</div>
						<div class="field-underline">
							<label for="buyer_phone">Phone number</label>
							<input id="buyer_phone" type="tel" name="buyer_phone" value={ data.BuyerPhone } placeholder="0803 000 0000" required/>
						</div>
						<div class="field-underline">
							<label for="buyer_email">Email (optional)</label>
							<input id="buyer_email" type="email" name="buyer_email" value={ data.BuyerEmail } placeholder="ada@example.com"/>
						</div>
						<div class="field-underline">
							<label>State</label>
							@themedSelect("buyer_state", stateSelectOptions(), data.BuyerState)
						</div>
						<label class="signup-consent">
							<input type="checkbox" name="accept_contact" value="yes" required/>
							<span>Text me when a gas plant near me joins GatsToGo. I've read the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
						</label>
						<button class="button-primary" type="submit">Claim my ₦1,000 off</button>
						<p class="signup-submit-note">No payment needed. The offer applies to your first order on GatsToGo.</p>
					</form>
				</div>
			</div>
			<div class="signup-panel" data-tab-panel="owner" hidden?={ data.Tab == "buyer" }>
			<div class="signup-layout signup-split">
				<div class="signup-head">
					<div class="section-eyebrow">Get started</div>
					<h1>Tell us about your plant</h1>
					<p class="lede">About 5 minutes. We set up your branded page and owner login, and review every application before it goes live.</p>
					@spotsBanner("owner", data.OwnerSpotsClaimed, data.OwnerSpotsTotal,
						"Be the first plant on GatsToGo",
						"Get the 1st Founding Plant badge on your dashboard for good, and we'll feature you on our social media.",
						"founding spots left",
						"Spots have run out because so many plants applied, but applications are still open. Apply now and we'll review yours.")
					@socialLinks("Follow us for launch updates")
					if data.ErrorMsg != "" {
						<div class="inline-alert">
							@components.Icon("warning-circle")
							{ data.ErrorMsg }
						</div>
					}
				</div>
				<aside class="signup-aside">
					<div class="signup-aside-block">
						<div class="signup-aside-title">Have these ready</div>
						<ul class="signup-ready">
							<li>@components.Icon("identification-badge") <span><strong>CAC number</strong> RC (company) or BN (business name)</span></li>
							<li>@components.Icon("shield-check") <span><strong>NMDPRA licence number</strong> From your Licence to Operate</span></li>
							<li>@components.Icon("bank") <span><strong>Business bank account</strong> Where customer payments settle</span></li>
							<li>@components.Icon("phone") <span><strong>Your phone and email</strong> For your owner login and updates</span></li>
						</ul>
					</div>
					<div class="signup-aside-block signup-aside-next">
						<div class="signup-aside-title">What happens next</div>
						<ol class="signup-next">
							<li><strong>We verify your details</strong> CAC, NMDPRA licence, and bank account.</li>
							<li><strong>We contact you</strong> By email and SMS, with your login details.</li>
							<li><strong>You go live</strong> Customers can buy gas on your page.</li>
						</ol>
					</div>
					<div class="signup-aside-block signup-aside-price">
						<strong>1.5% per online sale.</strong> No setup or monthly fee. <a href="/pricing">See pricing</a>
					</div>
				</aside>
				<form class="signup-form" method="post" action="/get-started">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

					<div class="field-group">
						<div class="field-group-heading"><span class="step-num">01</span>Plant details</div>
						<div class="field-underline">
							<label for="name">Plant name</label>
							<input id="name" type="text" name="name" value={ data.Name } placeholder="Sunrise Gas Plant" required autofocus/>
						</div>
						<div class="field-underline">
							<label for="slug">Web address</label>
							<input id="slug" type="text" name="slug" value={ data.Slug } placeholder="sunrise" pattern="[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?" required/>
							<p class="slug-preview">Customers will find you at <strong>{ slugOrPlaceholder(data.Slug) }</strong>.{ AppBaseDomain }</p>
						</div>
						<div class="field-grid">
							<div class="field-underline">
								<label for="city">City</label>
								<input id="city" type="text" name="city" value={ data.City } placeholder="Owerri"/>
							</div>
							<div class="field-underline">
								<label for="phone">Plant phone number</label>
								<input id="phone" type="tel" name="phone" value={ data.Phone } placeholder="0803 000 0000"/>
							</div>
						</div>
						<div class="field-underline">
							<label for="address">Address</label>
							<input id="address" type="text" name="address" value={ data.Address } placeholder="12 Wetheral Road"/>
						</div>
						<div class="field-underline">
							<label for="starting_price">Starting price per kg (₦)</label>
							<input id="starting_price" type="text" name="starting_price" value={ data.StartingPrice } placeholder="1200" inputmode="decimal" required/>
							<p class="field-hint">You can change this any time from your dashboard once you're live.</p>
						</div>
					</div>

					<div class="field-group">
						<div class="field-group-heading"><span class="step-num">02</span>Business details</div>
						<div class="field-grid">
							<div class="field-underline">
								<label for="legal_business_name">Legal business name</label>
								<input id="legal_business_name" type="text" name="legal_business_name" value={ data.LegalBusinessName } placeholder="As registered with CAC" required/>
							</div>
							<div class="field-underline">
								<label for="cac_number">CAC registration number</label>
								<input id="cac_number" type="text" name="cac_number" value={ data.CACNumber } placeholder="RC 1234567 or BN 1234567" required/>
								<p class="field-hint">RC for a registered company, BN for a business name.</p>
							</div>
						</div>
						<div class="field-grid">
							<div class="field-underline">
								<label>State</label>
								@themedSelect("state", stateSelectOptions(), data.State)
							</div>
							<div class="field-underline">
								<label for="nmdpra_license_number">NMDPRA licence number</label>
								<input id="nmdpra_license_number" type="text" name="nmdpra_license_number" value={ data.NMDPRALicenseNumber } placeholder="Licence number" required/>
								<p class="field-hint">As shown on your NMDPRA Licence to Operate.</p>
							</div>
						</div>
					</div>

					<div class="field-group">
						<div class="field-group-heading"><span class="step-num">03</span>Payout details</div>
						<p class="field-hint field-group-intro">Customer payments settle straight to this account. GatsToGo keeps 1.5% automatically, no manual payouts. The account name must match your business.</p>
						<div class="field-grid">
							<div class="field-underline">
								<label>Bank</label>
								@themedSelect("bank_code", bankSelectOptions(data.Banks), data.BankCode)
							</div>
							<div class="field-underline">
								<label for="bank_account_number">Account number</label>
								<input id="bank_account_number" type="text" name="bank_account_number" value={ data.BankAccountNumber } placeholder="0123456789" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" required/>
							</div>
						</div>
						</div>

					<div class="field-group">
						<div class="field-group-heading"><span class="step-num">04</span>Owner login</div>
						<div class="field-grid">
							<div class="field-underline">
								<label for="owner_name">Your name</label>
								<input id="owner_name" type="text" name="owner_name" value={ data.OwnerName } placeholder="Ada Nwosu" required/>
							</div>
							<div class="field-underline">
								<label for="owner_phone">Your phone number</label>
								<input id="owner_phone" type="tel" name="owner_phone" value={ data.OwnerPhone } placeholder="0803 000 0000" required/>
							</div>
						</div>
						<div class="field-underline">
							<label for="owner_email">Your email</label>
							<input id="owner_email" type="email" name="owner_email" value={ data.OwnerEmail } placeholder="ada@sunrisegas.ng" required/>
						</div>
						<div class="field-grid">
							<div class="field-underline">
								<label for="owner_password">Password</label>
								<input id="owner_password" type="password" name="owner_password" autocomplete="new-password" minlength="8" required/>
								<p class="field-hint">At least 8 characters.</p>
							</div>
							<div class="field-underline">
								<label for="owner_password_confirm">Confirm password</label>
								<input id="owner_password_confirm" type="password" name="owner_password_confirm" autocomplete="new-password" minlength="8" required/>
							</div>
						</div>
						<p class="field-hint">This is what you'll use to log in to your plant's dashboard once it's approved: your phone number and this password, at your own plant's login page.</p>
					</div>

					<details class="advanced-group">
						<summary>
							<span>Brand kit</span>
							<small>Optional. Use our default look now, or set yours up later.</small>
						</summary>
						<div class="advanced-body">
							<div class="field-grid">
								<div class="field-underline">
									<label for="primary_color">Primary color</label>
									<input id="primary_color" type="text" name="primary_color" value={ data.PrimaryColor } placeholder="#006B4D"/>
								</div>
								<div class="field-underline">
									<label for="button_color">Button color</label>
									<input id="button_color" type="text" name="button_color" value={ data.ButtonColor } placeholder="#006B4D"/>
								</div>
							</div>
							<div class="field-grid">
								<div class="field-underline">
									<label for="secondary_color">Secondary color</label>
									<input id="secondary_color" type="text" name="secondary_color" value={ data.SecondaryColor } placeholder="#10B981"/>
								</div>
								<div class="field-underline">
									<label for="button_text_color">Button text color</label>
									<input id="button_text_color" type="text" name="button_text_color" value={ data.ButtonTextColor } placeholder="#F8FAFC"/>
								</div>
							</div>
							<p class="field-hint">Leave these blank to use the GatsToGo default customer-site look. Invalid colors are ignored safely.</p>
						</div>
					</details>

					<label class="signup-consent">
						<input type="checkbox" name="accept_terms" value="yes" required/>
						<span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> and have read the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>. I'm authorised to register this business.</span>
					</label>
					<button class="button-primary" type="submit">Submit application</button>
					<p class="signup-submit-note">We verify your bank account during review and email you if anything needs fixing.</p>
				</form>
				<script>
					(function () {
						var form = document.querySelector(".signup-form");
						var alertBox = document.querySelector(".signup-head .inline-alert");
						if (!form || !alertBox) return;
						alertBox.scrollIntoView({ block: "center" });
						function dismiss() {
							alertBox.remove();
							form.removeEventListener("input", dismiss);
							form.removeEventListener("change", dismiss);
						}
						form.addEventListener("input", dismiss);
						form.addEventListener("change", dismiss);
					})();
				</script>
				<script>
					(function () {
						var input = document.getElementById("slug");
						var preview = document.querySelector(".slug-preview strong");
						if (!input || !preview) return;
						input.addEventListener("input", function () {
							var v = input.value.toLowerCase().replace(/[^a-z0-9-]/g, "");
							if (v !== input.value) input.value = v;
							preview.textContent = v || "yourname";
						});
					})();
				</script>
			</div>
			</div>
			<script>
				(function () {
					var btns = document.querySelectorAll("[data-tab-btn]");
					var panels = document.querySelectorAll("[data-tab-panel]");
					function show(which, push) {
						btns.forEach(function (b) { b.setAttribute("aria-selected", b.dataset.tabBtn === which ? "true" : "false"); });
						panels.forEach(function (p) { p.hidden = p.dataset.tabPanel !== which; });
						if (push && window.history && history.replaceState) {
							var u = new URL(window.location.href);
							u.searchParams.set("for", which);
							history.replaceState(null, "", u.toString());
						}
					}
					btns.forEach(function (b) { b.addEventListener("click", function () { show(b.dataset.tabBtn, true); }); });
				})();
			</script>
		}
	</main>
}

// slugOrPlaceholder shows a live-ish preview of the customer-facing web
// address as the visitor types -- "yourslug" as a placeholder before
// they've typed anything, so the field never reads as blank/broken.
func slugOrPlaceholder(slug string) string {
	if slug == "" {
		return "yourname"
	}
	return slug
}

templ PlantUnderReview(name string, appBaseURL string) {
	@marketingPageShell(name+" is under review | GatsToGo", plantUnderReviewContent(name, appBaseURL))
}

templ plantUnderReviewContent(name string, appBaseURL string) {
	<main>
		<div class="signup-submitted review-state">
			<div class="review-panel">
				<div class="icon-badge">
					@components.Icon("clock-counter-clockwise")
				</div>
				<div class="section-eyebrow">Application under review</div>
				<h1>{ name } is not live yet</h1>
				<p>We are verifying this plant before customers can buy gas from it. Once approved, the owner will receive an email and SMS with the next steps for using the platform.</p>
				<div class="review-steps" aria-label="Application progress">
					<div class="review-step is-done"><span>1</span><strong>Application received</strong></div>
					<div class="review-step is-current"><span>2</span><strong>Verification in progress</strong></div>
					<div class="review-step"><span>3</span><strong>Plant page goes live after approval</strong></div>
				</div>
				<a class="button-primary" href={ templ.SafeURL(appBaseURL) }>Back to GatsToGo</a>
			</div>
		</div>
	</main>
}
