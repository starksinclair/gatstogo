package pages

import (
	"gatstogo/internal/domain"
	"gatstogo/web/templates/components"
)

templ TicketConfirmation(plant *domain.Plant, paid bool, code string, amount string, sizeKg string) {
	{{ theme := customerTheme(plant) }}
	@customerPageShell(theme, theme.Name+" | Payment", ticketConfirmationContent(theme, paid, code, amount, sizeKg))
}

templ ticketConfirmationContent(theme customerHomeTheme, paid bool, code string, amount string, sizeKg string) {
	<div class="page">
		<div class="wrap">
			<header class="site-header">
				@customerBrand(theme)
				<nav class="site-nav">
					<a href="/receipts">
						@components.Icon("receipt")
						Receipts
					</a>
				</nav>
			</header>
			<main class="lookup-layout">
				if paid {
					<div class="lookup-icon lookup-icon-success">
						@components.Icon("check-circle")
					</div>
					<h1 class="page-headline">Payment received</h1>
					<p class="lede">You paid { amount }. That covers { sizeKg } of gas. Show this code to the attendant when you reach the front.</p>
					<div class="after-payment">
						<div class="section-eyebrow">Your code</div>
						<div class="code-row">
							<div class="code-preview">{ code }</div>
							<button type="button" class="copy-button" data-copy={ code } aria-label="Copy code">
								@components.Icon("copy")
								<span class="copy-label">Copy</span>
							</button>
						</div>
						<p class="fine-print">Keep this code. You will also need it if you look up this purchase on the receipts page.</p>
					</div>
				} else {
					<div class="lookup-icon">
						@components.Icon("hourglass-medium")
					</div>
					<h1 class="page-headline">Payment not confirmed yet</h1>
					<p class="lede">We have not received confirmation of your payment yet. If money left your account, this page will not update itself -- check <a href="/receipts">My receipts</a> in a minute, or contact the plant if it still has not arrived.</p>
				}
				<a class="button-primary full-width" href="/">Buy again</a>
			</main>
		</div>
	</div>
}
