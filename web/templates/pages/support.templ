package pages

import "gatstogo/web/templates/components"

// Public support pages linked from the footer. See
// cmd/server/support_pages.go for the handlers. Answers here describe how
// the product actually works; anything that depends on an individual
// plant's own policy (refunds, delivery, opening hours) sends the
// customer to that plant instead of promising something on its behalf.

// LoginFinder: owners type their plant's web address and are sent to that
// plant's own /owner/login. errorMsg explains a failed lookup.
templ LoginFinder(input string, errorMsg string) {
	@marketingPageShell("Owner sign in | GatsToGo", loginFinderContent(input, errorMsg))
}

templ loginFinderContent(input string, errorMsg string) {
	<main class="support-page">
		<div class="wrap support-narrow">
			<div class="section-eyebrow">Owner sign in</div>
			<h1>Sign in to your plant</h1>
			<p class="support-lede">Each plant has its own login page. Enter your plant's web address and we'll take you there.</p>
			<form class="finder" method="get" action="/login">
				if errorMsg != "" {
					<div class="inline-alert" role="alert">
						@components.Icon("warning-circle")
						{ errorMsg }
					</div>
				}
				<label for="plant">Your plant's web address</label>
				<div class="finder-field">
					<input id="plant" name="plant" type="text" value={ input } placeholder="sunrise" autocomplete="off" autocapitalize="none" spellcheck="false" required autofocus/>
					<span class="finder-suffix">.gatstogo.ng</span>
				</div>
				<button class="button-primary" type="submit">
					Continue to sign in
					@components.Icon("arrow-right")
				</button>
			</form>
			<div class="finder-notes">
				<p><strong>Staff?</strong> Sign in on your plant's terminal with your PIN. Your manager has the link.</p>
				<p><strong>Don't know your web address?</strong> It's in the approval email and SMS we sent you. Still stuck? <a href="/contact">Contact us</a>.</p>
				<p><strong>Not on GatsToGo yet?</strong> <a href="/get-started">Apply to get started</a>.</p>
			</div>
		</div>
	</main>
}

// Contact: who to reach for what.
templ Contact(contactEmail string) {
	@marketingPageShell("Contact | GatsToGo", contactContent(contactEmail))
}

templ contactContent(contactEmail string) {
	<main class="support-page">
		<div class="wrap">
			<div class="support-head">
				<div class="section-eyebrow">Contact</div>
				<h1>Talk to us.</h1>
				<p class="support-lede">Whether you run a plant or buy gas from one, here's the quickest way to the right answer.</p>
			</div>
			<div class="contact-grid">
				<div class="contact-card">
					<span class="contact-card-label">Run an LPG plant?</span>
					<h2>Bring your plant online</h2>
					<p>Apply in about 5 minutes. We review every application and contact you by email and SMS.</p>
					<a class="text-button" href="/get-started">Apply to get started</a>
				</div>
				<div class="contact-card">
					<span class="contact-card-label">Already on GatsToGo?</span>
					<h2>Owner support</h2>
					<p>Questions about your dashboard, payouts, staff, or business details.</p>
					<a class="text-button" href={ templ.SafeURL("mailto:" + contactEmail) }>{ contactEmail }</a>
				</div>
				<div class="contact-card">
					<span class="contact-card-label">Buying gas?</span>
					<h2>Contact your plant</h2>
					<p>For an order, refund, or opening hours, call the plant: their number is on their GatsToGo page.</p>
					<a class="text-button" href="/help/buying-gas">Customer help</a>
				</div>
			</div>
			<div class="contact-more">
				<div class="about-contact-row">
					<span>General enquiries</span>
					<a href={ templ.SafeURL("mailto:" + contactEmail) }>{ contactEmail }</a>
				</div>
				<div class="about-contact-row">
					<span>Report a problem</span>
					<p>Spotted something wrong or a security issue? Email us with the details and the page you were on.</p>
				</div>
			</div>
		</div>
	</main>
}
