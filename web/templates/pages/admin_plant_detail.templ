package pages

import "gatstogo/web/templates/components"

// AdminPlantDetailData backs GET /admin/plants/{id} -- a dedicated page
// for reviewing one plant's full record, not just the summary row the
// Plants table (adminConsoleContent) shows. This is specifically the only
// place an admin can see the business/regulatory/settlement fields
// collected at onboarding (internal/plants.CreateParams) before deciding
// whether to Activate a self-serve /get-started submission -- without it,
// Activate was a blind click.
type AdminPlantDetailData struct {
	ID      string
	Name    string
	Slug    string
	City    string
	Address string
	Phone   string
	TermiiSenderID string
	EffectiveTermiiSenderID string

	RawStatus    string
	Status       string
	BadgeCSS     string
	Domain       string
	DomainStatus string
	DomainBadge  string

	State             string
	LegalBusinessName string
	CACNumber         string
	NMDPRALicense     string

	BankName        string
	BankAccount     string // masked, same treatment as the owner dashboard's own Plant profile panel
	BankAccountName string
	SubaccountCode  string

	OwnerName  string
	OwnerPhone string
	OwnerEmail string

	StaffCount int64
	PriceCount int64
	OpenShifts int64
	Txns7d     int64
	Volume30d  string
	FirstTxn   string
	LastTxn    string
	CreatedAt  string
	UpdatedAt  string

	Activity []OwnerActivityRow

	CSRFToken string
}

templ AdminPlantDetail(data AdminPlantDetailData) {
	@opsShell(data.Name+" | Admin console", "Admin", adminNavLinks(), adminPlantDetailContent(data), "/admin/logout", data.CSRFToken, "Plant review", data.Name)
}

templ adminPlantDetailContent(data AdminPlantDetailData) {
	<div class="topline">
		<div>
			<a class="back-link" href="/admin#plants">← All plants</a>
			<div class="eyebrow">Platform admin console</div>
			<h1>{ data.Name }</h1>
			<div class="meta-row">
				<span class={ "badge " + data.BadgeCSS }>{ data.Status }</span>
				<span class="sep"></span>
				<span class="mono">{ data.Slug }</span>
				<span class="sep"></span>
				<span>Created { data.CreatedAt }</span>
			</div>
		</div>
		<div class="toolbar action-strip">
			switch data.RawStatus {
				case "active":
					@plantStatusForm(data.ID, "suspended", "Suspend", data.CSRFToken, statusConfirm{
						Title: "Suspend " + data.Name + "?",
						Desc:  "Its customer page, staff terminal, and owner login all go offline immediately. You can reactivate it any time.",
						Tone:  "warning",
					})
				case "suspended":
					@plantStatusForm(data.ID, "active", "Reactivate", data.CSRFToken, statusConfirm{
						Title: "Reactivate " + data.Name + "?",
						Desc:  "Its customer page, staff terminal, and owner login all come back online immediately.",
						Tone:  "ok",
					})
					@plantStatusForm(data.ID, "closed", "Close", data.CSRFToken, statusConfirm{
						Title: "Close " + data.Name + "?",
						Desc:  "Like suspending, this takes everything offline immediately. Unlike suspending, there's no reactivate button for a closed plant in this console.",
						Tone:  "danger",
					})
				case "provisioning":
					@plantStatusForm(data.ID, "active", "Activate", data.CSRFToken, statusConfirm{
						Title: "Activate " + data.Name + "?",
						Desc:  "Its customer page, staff terminal, and owner login all go live immediately. Review the business and payout details below first.",
						Tone:  "ok",
					})
			}
		</div>
	</div>
	<div class="kpi-row kpi-band detail-band">
		<div class="kpi-item">@kpiLabel("receipt", "Transactions 7d")<div class="kpi">{ formatThousands(data.Txns7d) }</div><div class="kpi-small">Last txn · { data.LastTxn }</div></div>
		<div class="kpi-item">@kpiLabel("gas-pump", "Volume 30d")<div class="kpi">{ data.Volume30d }</div><div class="kpi-small">Paid ticket weight</div></div>
		<div class="kpi-item">@kpiLabel("users", "Staff")<div class="kpi">{ data.StaffCount }</div><div class="kpi-small">{ data.OpenShifts } open shifts</div></div>
		<div class="kpi-item">@kpiLabel("money", "Prices set")<div class="kpi">{ data.PriceCount }</div><div class="kpi-small">First txn · { data.FirstTxn }</div></div>
	</div>
	<div class="settings">
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Business details</h2>
				<p>The registered business. Check these against the CAC and NMDPRA records before activating.</p>
			</div>
			<div class="settings-body">
				<dl class="settings-records">
					<div><dt>Legal business name</dt><dd>{ data.LegalBusinessName }</dd></div>
					<div><dt>State</dt><dd>{ data.State }</dd></div>
					<div><dt>CAC number</dt><dd>@verifyValue(data.CACNumber, verifyCACURL, "Verify on CAC")</dd></div>
					<div><dt>NMDPRA license</dt><dd>@verifyValue(data.NMDPRALicense, verifyNMDPRAURL, "Verify on NMDPRA")</dd></div>
				</dl>
			</div>
		</section>
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Payout details</h2>
				<p>Where customer payments settle. The account must belong to this plant.</p>
			</div>
			<div class="settings-body">
				<dl class="settings-records">
					<div><dt>Bank</dt><dd>{ data.BankName }</dd></div>
					<div><dt>Account number</dt><dd class="mono">{ data.BankAccount }</dd></div>
					<div><dt>Account name</dt><dd>{ data.BankAccountName }</dd></div>
					<div><dt>Paystack subaccount</dt><dd>@verifyValue(data.SubaccountCode, paystackSubaccURL, "Open in Paystack")</dd></div>
				</dl>
			</div>
		</section>
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Owner access</h2>
				<p>Who signs in to this plant's owner dashboard.</p>
			</div>
			<div class="settings-body">
				<dl class="settings-records">
					<div><dt>Name</dt><dd>{ data.OwnerName }</dd></div>
					<div><dt>Phone</dt><dd class="mono">{ data.OwnerPhone }</dd></div>
					<div><dt>Email</dt><dd>{ data.OwnerEmail }</dd></div>
				</dl>
			</div>
		</section>
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Plant record</h2>
				<p>Location, contact, and web address on GatsToGo.</p>
			</div>
			<div class="settings-body">
				<dl class="settings-records">
					<div><dt>Address</dt><dd>{ data.Address }</dd></div>
					<div><dt>Phone</dt><dd>{ data.Phone }</dd></div>
					<div><dt>Domain status</dt><dd><span class={ "badge " + data.DomainBadge }>{ data.DomainStatus }</span></dd></div>
					<div><dt>Custom domain</dt><dd>{ data.Domain }</dd></div>
					<div><dt>Updated</dt><dd>{ data.UpdatedAt }</dd></div>
				</dl>
			</div>
		</section>
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Messaging</h2>
				<p>The SMS sender name customers see on receipts and codes.</p>
			</div>
			<div class="settings-body">
				<form method="post" action={ templ.SafeURL("/admin/plants/" + data.ID + "/messaging") } class="settings-rate-form detail-inline-form">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="field">
						<label for="termii-sender">Termii sender ID</label>
						<input id="termii-sender" type="text" name="termii_sender_id" value={ data.TermiiSenderID } placeholder={ data.EffectiveTermiiSenderID }/>
					</div>
					<button class="btn primary" type="submit">@components.Icon("check") Save sender ID</button>
				</form>
				<p class="muted detail-hint">Leave blank to use the project default sender ID.</p>
			</div>
		</section>
		<section class="settings-section">
			<div class="settings-intro">
				<h2>Activity</h2>
				<p>Everything recorded for this plant, newest first.</p>
			</div>
			<div class="settings-body">
				<div class="timeline">
					if len(data.Activity) == 0 {
						@emptyState("activity", "No activity recorded for this plant yet.")
					}
					for _, row := range data.Activity {
						<div class="timeline-item"><strong>{ row.Action }</strong><span class="muted">{ row.Detail }</span></div>
					}
				</div>
			</div>
		</section>
	</div>
}
