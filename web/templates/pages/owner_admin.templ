type OwnerTicketRow struct {
	Reference string
	Code      string
	Customer  string
	Phone     string
	Kg        string
	NetKg     string
	Rate      string
	Amount    string
	Channel   string
	Pump      string
	Status    string
	When      string
	PaidAt    string
	FilledAt  string
	BadgeCSS  string
}

// shortTicketRef trims a ticket reference's redundant plant-slug prefix
// for table display -- every reference on this one-plant dashboard
// already shares the same slug (tickets.NewReference always mints
// "{slug}-{suffix}"), so repeating "sunrise-" on every single row was
// pure noise, and also happened to be the single widest column in the
// table. Falls back to the untouched reference if it doesn't start with
// the expected prefix, so this only ever removes known redundancy, never
// hides real data. The void-ticket form still posts the full row.Reference
// unchanged -- this affects display only.
func shortTicketRef(reference, plantSlug string) string {
	prefix := plantSlug + "-"
	if trimmed := strings.TrimPrefix(reference, prefix); trimmed != reference {
		return trimmed
	}
	return reference
}

type OwnerStaffRow struct {
	ID          string
