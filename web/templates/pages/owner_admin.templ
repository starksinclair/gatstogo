templ OwnerDashboard(data OwnerDashboardData) {
	@opsShell(data.PlantName+" owner dashboard", "Owner", ownerNav(), ownerDashboardContent(data), "/owner/logout", data.CSRFToken)
}

templ AdminConsole(data AdminConsoleData) {
	@opsShell("GatsToGo admin console", "Admin", adminNav(), adminConsoleContent(data), "/admin/logout", data.CSRFToken)
}

templ opsShell(title string, railLabel string, nav templ.Component, content templ.Component, logoutAction string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			@components.BrandFavicons()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/owner-admin.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@lottiefiles/lottie-player@2.0.12/dist/lottie-player.js" defer></script>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					document.querySelectorAll("[data-tabs]").forEach(function (root) {
						function show(tab) {
							root.querySelectorAll("[data-tab]").forEach(function (button) {
								button.classList.toggle("active", button.dataset.tab === tab);
							});
							root.querySelectorAll("[data-tab-panel]").forEach(function (panel) {
								panel.classList.toggle("active", panel.dataset.tabPanel === tab);
							});
						}

						// Mobile off-canvas drawer -- the exact same .rail markup
						// used on desktop, just toggled via a fixed-position
						// transform below the 1020px breakpoint (see owner-
						// admin.css). Replaces what used to be a <select>
						// dropdown standing in for the whole sidebar on mobile.
						//
						// body.rail-locked's own overflow:hidden (owner-admin.css)
						// isn't enough on its own on real mobile browsers -- iOS
						// Safari in particular still lets the page scroll behind a
						// fixed element despite overflow:hidden on <body>. The
						// robust fix is to also pin <body> itself with
						// position:fixed and a negative top offset equal to the
						// current scroll position while the drawer is open, then
						// undo that and restore the exact scroll position on
						// close -- the standard technique for this, not a novel
						// one. Without it, a page scrolled down before opening the
						// drawer leaves the (still torso still scrollable)
						// background moving underneath a supposedly-fixed drawer,
						// which is exactly the "sidebar drifts away while
						// scrolling" bug this replaces.
						var lockedScrollY = 0;
						var toggleButtons = root.querySelectorAll("[data-rail-toggle]");
						function setExpanded(expanded) {
							// Drives the toggle button's hamburger<->X morph
							// (owner-admin.css's .rail-toggle[aria-expanded]
							// rules) off the same attribute a screen reader
							// needs anyway, rather than a separate class.
							toggleButtons.forEach(function (btn) {
								btn.setAttribute("aria-expanded", expanded ? "true" : "false");
							});
						}
						function openDrawer() {
							lockedScrollY = window.scrollY;
							document.body.classList.add("rail-locked");
							document.body.style.top = (-lockedScrollY) + "px";
							root.classList.add("rail-open");
							setExpanded(true);
						}
						function closeDrawer() {
							root.classList.remove("rail-open");
							document.body.classList.remove("rail-locked");
							document.body.style.top = "";
							window.scrollTo(0, lockedScrollY);
							setExpanded(false);
						}
						toggleButtons.forEach(function (button) {
							button.addEventListener("click", function () {
								root.classList.contains("rail-open") ? closeDrawer() : openDrawer();
							});
						});
						var backdrop = root.querySelector("[data-rail-backdrop]");
						if (backdrop) backdrop.addEventListener("click", closeDrawer);
						document.addEventListener("keydown", function (event) {
							if (event.key === "Escape") closeDrawer();
						});

						root.querySelectorAll("[data-tab]").forEach(function (button) {
							button.addEventListener("click", function () {
								show(button.dataset.tab);
								// A nav click on mobile is navigation, not just a
								// state change -- close the drawer the same way
								// tapping a link in any mobile nav drawer would.
								closeDrawer();
							});
						});

						// Themed <select> replacement (see themedSelect in
						// owner_admin.templ for the markup this wires up and why:
						// CSS alone can restyle a <select>'s closed box but never
						// its open dropdown list cross-browser). Progressive
						// enhancement -- the real <select name="..."> stays in
						// the DOM and is still exactly what actually gets
						// submitted with the form; owner-admin.css only hides it
						// (in favor of the custom trigger+listbox) once a shell
						// has the js-ready class this loop adds, so a page where
						// this script fails to run still has a fully working,
						// if plainer, native dropdown instead of nothing.
						root.querySelectorAll("[data-select]").forEach(function (shell) {
							var nativeSelect = shell.querySelector(".select-native");
							var trigger = shell.querySelector(".select-trigger");
							var valueLabel = shell.querySelector(".select-value");
							var list = shell.querySelector(".select-list");
							var items = Array.prototype.slice.call(list ? list.querySelectorAll('[role="option"]') : []);
							if (!nativeSelect || !trigger || !list || !items.length) return;

							var highlighted = 0;

							function syncFromNative() {
								items.forEach(function (li, i) {
									var isSelected = li.dataset.value === nativeSelect.value;
									li.setAttribute("aria-selected", isSelected ? "true" : "false");
									li.classList.toggle("selected", isSelected);
									if (isSelected) {
										valueLabel.textContent = li.textContent;
										highlighted = i;
									}
								});
							}
							function highlightItem(index) {
								items.forEach(function (li, i) { li.classList.toggle("highlighted", i === index); });
								if (items[index].scrollIntoView) items[index].scrollIntoView({ block: "nearest" });
							}
							function openList() {
								document.querySelectorAll(".select-shell.open").forEach(function (openShell) {
									if (openShell !== shell) closeList(openShell);
								});
								shell.classList.add("open");
								trigger.setAttribute("aria-expanded", "true");
								list.hidden = false;
								highlightItem(highlighted);
							}
							function closeList(target) {
								target = target || shell;
								target.classList.remove("open");
								target.querySelector(".select-trigger").setAttribute("aria-expanded", "false");
								target.querySelector(".select-list").hidden = true;
							}
							function selectItem(index) {
								var li = items[index];
								if (!li) return;
								nativeSelect.value = li.dataset.value;
								nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
								syncFromNative();
								closeList();
								trigger.focus();
							}

							trigger.addEventListener("click", function () {
								shell.classList.contains("open") ? closeList() : openList();
							});
							trigger.addEventListener("keydown", function (event) {
								if (event.key === "ArrowDown" || event.key === "ArrowUp") {
									event.preventDefault();
									if (!shell.classList.contains("open")) { openList(); return; }
									var dir = event.key === "ArrowDown" ? 1 : -1;
									highlighted = (highlighted + dir + items.length) % items.length;
									highlightItem(highlighted);
								} else if (event.key === "Enter" || event.key === " ") {
									event.preventDefault();
									shell.classList.contains("open") ? selectItem(highlighted) : openList();
								} else if (event.key === "Escape" && shell.classList.contains("open")) {
									event.preventDefault();
									event.stopPropagation(); // don't also close the mobile drawer
									closeList();
								}
							});
							items.forEach(function (li, i) {
								li.addEventListener("click", function () { selectItem(i); });
								li.addEventListener("mouseenter", function () { highlighted = i; highlightItem(i); });
							});
							document.addEventListener("click", function (event) {
								if (shell.classList.contains("open") && !shell.contains(event.target)) closeList();
							});

							syncFromNative();
							// Only once the custom trigger+listbox is actually
							// wired up and taking over does the native select
							// get pulled out of the tab order and accessibility
							// tree -- it's still what's found first (and works
							// fully natively) if this script never runs at all.
							nativeSelect.setAttribute("tabindex", "-1");
							nativeSelect.setAttribute("aria-hidden", "true");
							shell.classList.add("js-ready");
						});

						// A write action (set price, add staff, ...) redirects back
						// to #<tab> so the owner lands back where they were, not on
						// Overview -- see cmd/server/owner_write.go.
						var hashTab = location.hash.replace("#", "");
						var hashTarget = hashTab && root.querySelector('[data-tab-panel="' + hashTab + '"]');
						var initial = root.querySelector("[data-tab].active");
						show(hashTarget ? hashTab : (initial ? initial.dataset.tab : "overview"));
					});
				});

				// Confirmation modal -- replaces window.confirm() (a native,
				// unstyleable browser popup that also freezes the whole page
				// while open) for every action that flips something a plant
				// or staff member depends on: suspend, close, deactivate,
				// void. Driven entirely by data-confirm-* attributes on the
				// triggering <form>, so nothing about what a form posts or
				// where it posts to changes -- see plantStatusForm and the
				// Staff/Sales tables' own forms in this file for the
				// attributes it reads.
				//
				// A form's first submit is always intercepted and shown as
				// the modal instead; only clicking the modal's own Confirm
				// button does the real submit, via a one-time
				// confirmBypass flag so that second, real submit doesn't
				// loop back through this same listener.
				document.addEventListener("DOMContentLoaded", function () {
					var overlay = document.querySelector("[data-confirm-overlay]");
					if (!overlay) return;
					var modal = overlay.querySelector(".confirm-modal");
					var titleEl = overlay.querySelector("[data-confirm-title-el]");
					var descEl = overlay.querySelector("[data-confirm-desc-el]");
					var okBtn = overlay.querySelector("[data-confirm-ok]");
					var cancelBtn = overlay.querySelector("[data-confirm-cancel]");
					var pendingForm = null;
					var pendingTrigger = null;

					function open(form, trigger) {
						pendingForm = form;
						pendingTrigger = trigger;
						modal.dataset.tone = form.dataset.confirmTone || "warning";
						titleEl.textContent = form.dataset.confirmTitle || "Are you sure?";
						descEl.textContent = form.dataset.confirmDesc || "";
						okBtn.textContent = form.dataset.confirmLabel || "Confirm";
						overlay.hidden = false;
						// rAF so the hidden -> visible transition actually
						// animates instead of snapping (a display/visibility
						// change and its transition can't start in the same
						// paint frame).
						requestAnimationFrame(function () { overlay.classList.add("open"); });
						okBtn.focus();
					}
					function close() {
						overlay.classList.remove("open");
						if (pendingTrigger) pendingTrigger.focus();
						pendingForm = null;
						pendingTrigger = null;
						setTimeout(function () { overlay.hidden = true; }, 150);
					}

					document.querySelectorAll("form[data-confirm-title]").forEach(function (form) {
						form.addEventListener("submit", function (event) {
							if (form.dataset.confirmBypass === "1") {
								delete form.dataset.confirmBypass;
								return; // the real, confirmed submit -- let it through
							}
							event.preventDefault();
							open(form, event.submitter || form.querySelector('button[type="submit"]'));
						});
					});
					okBtn.addEventListener("click", function () {
						if (!pendingForm) return;
						var form = pendingForm;
						close();
						form.dataset.confirmBypass = "1";
						if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
					});
					cancelBtn.addEventListener("click", close);
					overlay.addEventListener("click", function (event) {
						if (event.target === overlay) close();
					});
					document.addEventListener("keydown", function (event) {
						if (event.key === "Escape" && !overlay.hidden) close();
					});
				});

				// Full-screen branded splash for the couple of forms in this
				// console carrying data-splash (Create plant -- see
				// splash.templ's own comment for why there's no matching
				// "hide" call anywhere: the real POST this triggers either
				// redirects into the new plant's own console or back to this
				// same form with an error, and either way this whole document
				// gets replaced). If a confirm-modal form also ever needs
				// this, it composes for free -- the modal's own Confirm
				// button calls form.requestSubmit(), which fires this exact
				// listener same as a direct submit would.
				document.addEventListener("DOMContentLoaded", function () {
					var splashOverlay = document.querySelector("[data-splash-overlay]");
					if (!splashOverlay) return;
					var splashMessage = splashOverlay.querySelector("[data-splash-message]");
					document.querySelectorAll("form[data-splash]").forEach(function (form) {
						form.addEventListener("submit", function () {
							if (splashMessage) splashMessage.textContent = form.dataset.splash;
							splashOverlay.hidden = false;
							requestAnimationFrame(function () { splashOverlay.classList.add("open"); });
						});
					});
				});

				// File input filename display -- see .file-field/.file-native
				// (owner-admin.css) for why the real <input type="file"> is
				// visually hidden and a <label for="..."> styled as .btn is
				// the actual clickable trigger (a label click natively opens
				// the file picker with zero JS needed, so choosing and
				// submitting a file both still work even if this never runs
				// -- only the filename text stays "No file chosen").
				document.addEventListener("DOMContentLoaded", function () {
					document.querySelectorAll("[data-file-input]").forEach(function (shell) {
						var input = shell.querySelector(".file-native");
						var nameEl = shell.querySelector("[data-file-name]");
						if (!input || !nameEl) return;
						input.addEventListener("change", function () {
							nameEl.textContent = input.files && input.files.length ? input.files[0].name : "No file chosen";
						});
					});
				});

				// Brand color fields keep a human-editable hex input and a
				// native color picker in sync. The text field remains the
				// only named/submitted control, so server-side validation
				// still goes through ownerHexColorOrDefault.
				document.addEventListener("DOMContentLoaded", function () {
					var hex = /^#?[0-9A-Fa-f]{6}$/;
					function normalizeHex(value) {
						value = (value || "").trim().toUpperCase();
						if (value.length === 6) value = "#" + value;
						return value;
					}
					document.querySelectorAll("[data-color-field]").forEach(function (field) {
						var text = field.querySelector("[data-color-text]");
						var picker = field.querySelector("[data-color-picker]");
						if (!text || !picker) return;

						text.addEventListener("input", function () {
							var value = normalizeHex(text.value);
							if (hex.test(text.value.trim())) picker.value = value;
						});
						picker.addEventListener("input", function () {
							text.value = picker.value.toUpperCase();
							text.setCustomValidity("");
						});
						text.addEventListener("blur", function () {
							var raw = text.value.trim();
							var value = normalizeHex(raw);
							text.value = value;
							text.setCustomValidity(raw === "" || hex.test(raw) ? "" : "Use a 6-digit hex color, like #006B4D");
						});
					});
				});
			</script>
		</head>
		<body>
			<div class="shell" data-tabs>
				<div class="mobile-topbar">
					<button class="rail-toggle" type="button" data-rail-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-rail">
						<span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
					</button>
					<div class="brand">@components.BrandMark("mark", "dark-container", "GatsToGo")<span>{ railLabel } workspace</span></div>
				</div>
				<div class="rail-backdrop" data-rail-backdrop></div>
				<aside class="rail" id="mobile-rail">
					<div class="brand">
						@components.BrandMark("mark", "dark-container", "GatsToGo")
						<span>GATSTOGO</span>
					</div>
					<div class="rail-label">{ railLabel } workspace</div>
					@nav
					<div class="rail-note">
						<strong>Real numbers only.</strong>
						Everything on this dashboard reflects what's actually happened. Sections stay empty until there's something real to show.
					</div>
					<form
						method="post"
						action={ templ.SafeURL(logoutAction) }
						class="rail-signout"
						data-confirm-title="Sign out?"
						data-confirm-desc="You'll need to sign in again to get back to this dashboard."
						data-confirm-label="Sign out"
						data-confirm-tone="warning"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="nav-button" type="submit">
							<span class="nav-button-label">
								@components.Icon("sign-out")
								Sign out
							</span>
						</button>
					</form>
				</aside>
				<main class="main">
					@content
				</main>
			</div>
			<div class="confirm-overlay" data-confirm-overlay hidden>
				<div class="confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="confirm-modal-title" aria-describedby="confirm-modal-desc">
					<div class="confirm-icon">
						<span class="confirm-icon-warn">
							@components.Icon("warning-circle")
						</span>
						<span class="confirm-icon-ok">
							@components.Icon("check-circle")
						</span>
					</div>
					<h2 id="confirm-modal-title" data-confirm-title-el></h2>
					<p id="confirm-modal-desc" data-confirm-desc-el></p>
					<div class="confirm-actions">
						<button type="button" class="btn" data-confirm-cancel>Cancel</button>
						<button type="button" class="btn primary" data-confirm-ok></button>
					</div>
				</div>
			</div>
			@splashOverlay()
		</body>
	</html>
}

templ kpiLabel(icon string, label string) {
	<div class="kpi-label">
		@components.Icon(icon)
		{ label }
	</div>
}

// emptyState is the "nothing here yet" content shown in place of a table
// or timeline once its data list is empty -- a small looping
// illustration (one of web/static/lottie/*.json, picked per section to
// actually match what the section is about) above the existing copy.
// lottie is just the file's base name ("sales", "shifts", ...), never a
// full path or user input, so building the src by concatenation here is
// safe.
templ emptyState(lottie string, message string) {
	<div class="empty">
		<lottie-player class="empty-lottie" src={ "/static/lottie/" + lottie + ".json" } autoplay loop></lottie-player>
		{ message }
	</div>
}

templ navButton(active bool, tab string, icon string, label string) {
	<button class={ "nav-button", templ.KV("active", active) } type="button" data-tab={ tab }>
		<span class="nav-button-label">
			@components.Icon(icon)
			{ label }
		</span>
	</button>
}

templ ownerNav() {
	<nav class="rail-nav" aria-label="Owner sections">
		@navButton(true, "overview", "squares-four", "Overview")
		@navButton(false, "sales", "receipt", "Sales")
		@navButton(false, "reviews", "check-circle", "Reviews")
		@navButton(false, "operations", "money", "Operations")
		@navButton(false, "staff", "users", "Staff")
		@navButton(false, "settings", "gear", "Settings")
	</nav>
}

templ adminNav() {
	<nav class="rail-nav" aria-label="Admin sections">
		@navButton(true, "overview", "squares-four", "Overview")
		@navButton(false, "applications", "list-checks", "Applications")
		@navButton(false, "plants", "factory", "Plants")
		@navButton(false, "activity", "clock-counter-clockwise", "Admin activity")
	</nav>
}

// navLink mirrors navButton's exact markup and CSS classes, but as a real
// <a href="/admin#tab"> instead of a JS-driven data-tab button. adminNav's
// buttons only work because opsShell's own script finds a matching
// [data-tab-panel] on the SAME page they live on (adminConsoleContent) --
// a page outside that tab shell entirely, like adminPlantDetailContent
// (web/templates/pages/admin_plant_detail.templ), has no tab panels at
// all, so a data-tab button there would be a silent dead click. A real
// link instead does a real navigation back to /admin, landing on the
// right tab via opsShell's existing location.hash handling -- the same
// mechanism every write-handler redirect (e.g. /admin#plants) already
// relies on.
templ navLink(tab string, icon string, label string) {
	<a class="nav-button" href={ templ.SafeURL("/admin#" + tab) }>
		<span class="nav-button-label">
			@components.Icon(icon)
			{ label }
		</span>
	</a>
}

// adminNavLinks is adminNav's tab list, link-flavored -- see navLink's own
// doc comment for why these two lists exist separately rather than one
// sharing logic, and adminPlantDetailContent for the one page that uses
// this instead of adminNav.
templ adminNavLinks() {
	<nav class="rail-nav" aria-label="Admin sections">
		@navLink("overview", "squares-four", "Overview")
		@navLink("applications", "list-checks", "Applications")
		@navLink("plants", "factory", "Plants")
		@navLink("activity", "clock-counter-clockwise", "Admin activity")
	</nav>
}

templ ownerDashboardContent(data OwnerDashboardData) {
	<div class="topline">
		<div>
			<div class="eyebrow">Plant owner console</div>
			<h1>{ data.PlantName }</h1>
			<div class="meta-row">
				<span>{ data.TodayLabel }</span>
				<span class="sep"></span>
				<span>{ data.PlantCity }</span>
				<span class="sep"></span>
				<span class="mono">{ data.PlantSlug }</span>
				<span class="sep"></span>
				<span>Domain { data.DomainStatus }</span>
			</div>
		</div>
		<div class="toolbar">
			<button class="btn primary" type="button" data-tab="settings">
				@components.Icon("gas-pump")
				Set price
			</button>
		</div>
	</div>
	if data.ErrorMessage != "" {
		<div class="owner-error">
			@components.Icon("warning-circle")
			{ data.ErrorMessage }
		</div>
	}
	<section class="tab-panel active" data-tab-panel="overview">
		<div class="kpi-row">
			<div class="kpi-item">@kpiLabel("wallet", "Money today")<div class="kpi">{ data.MoneyToday }</div><div class="kpi-small">{ data.SalesCount } sales recorded</div></div>
			<div class="kpi-item">@kpiLabel("gas-pump", "Gas sold")<div class="kpi">{ data.GasSoldKg }</div><div class="kpi-small">Paid ticket size</div></div>
			<div class="kpi-item">@kpiLabel("receipt", "Current price")<div class="kpi">{ data.CurrentPrice }</div><div class="kpi-small">Snapshot used for new tickets</div></div>
			<div class="kpi-item">@kpiLabel("bank", "Cash / electronic")<div class="kpi">{ data.CashTotal }</div><div class="kpi-small">Electronic { data.ElectronicTotal }</div></div>
		</div>
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Today's control</h2></div>
				<div class="stat-line">
					<div><div class="kpi-label">Gas paid for</div><strong class="mono">{ data.PaidForKg }</strong></div>
					<div><div class="kpi-label">Gas filled</div><strong class="mono">{ data.FilledKg }</strong></div>
					<div><div class="kpi-label">Difference</div><strong class="mono">{ data.DiffKg } · { data.DiffAmount }</strong></div>
				</div>
				<div class="section-title section-spaced"><h2>Recent activity</h2></div>
				<div class="timeline">
					if len(data.Activity) == 0 {
						@emptyState("activity", "No activity yet. Ticket, price, shift, and staff changes will appear here.")
					}
					for _, item := range data.Activity {
						<div class="timeline-item"><strong>{ item.Action }</strong><span class="muted">{ item.Detail }</span></div>
					}
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Plant basics</h2></div>
				<div class="split-list">
					<div class="info-row"><span>Address</span><strong>{ data.PlantAddress }</strong></div>
					<div class="info-row"><span>Phone</span><strong>{ data.PlantPhone }</strong></div>
					<div class="info-row"><span>Web address</span><strong class="mono">{ data.PlantSlug }</strong></div>
					<div class="info-row"><span>Domain status</span><strong>{ data.DomainStatus }</strong></div>
				</div>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="sales">
		<div class="section-title"><h2>Sales</h2></div>
		<div class="table-wrap">
			<table style="min-width:1240px">
				<thead><tr><th>Ticket</th><th>Customer</th><th>Code</th><th class="num">Paid kg</th><th class="num">Filled kg</th><th class="num">Amount</th><th>Channel</th><th>Pump</th><th>Status</th><th>Created</th><th></th></tr></thead>
				<tbody>
					if len(data.RecentTickets) == 0 {
						<tr><td colspan="11">@emptyState("sales", "No sales yet. Paid customer tickets will show reference, code, weight, payment method, pump, and status here.")</td></tr>
					}
					for _, row := range data.RecentTickets {
						<tr>
							<td class="mono" title={ row.Reference }>{ shortTicketRef(row.Reference, data.PlantSlug) }</td><td>{ row.Customer }<div class="muted mono">{ row.Phone }</div></td><td class="mono">{ row.Code }</td><td class="num">{ row.Kg }</td><td class="num">{ row.NetKg }</td><td class="num">{ row.Amount }</td><td>{ row.Channel }</td><td>{ row.Pump }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.When }</td>
							<td class="action-strip table-actions">
								if row.Status == "PENDING" || row.Status == "PAID" {
									<form
										method="post"
										action={ templ.SafeURL("/tickets/" + row.Reference + "/void") }
										data-confirm-title="Void this ticket?"
										data-confirm-desc="The code stops working right away and this sale won't count anymore. This can't be undone."
										data-confirm-label="Void ticket"
										data-confirm-tone="danger"
									>
										<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
										<button class="btn" type="submit">Void</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="reviews">
		<div class="kpi-row">
			<div class="kpi-item">@kpiLabel("check-circle", "Average rating")<div class="kpi">{ data.ReviewAverage }</div><div class="kpi-small">From submitted reviews</div></div>
			<div class="kpi-item">@kpiLabel("receipt", "Review count")<div class="kpi">{ strconv.FormatInt(data.ReviewCount, 10) }</div><div class="kpi-small">Customers who responded</div></div>
			<div class="kpi-item">@kpiLabel("gas-pump", "Trigger")<div class="kpi">Code</div><div class="kpi-small">Sent after dispensing starts</div></div>
			<div class="kpi-item">@kpiLabel("shield-check", "Privacy")<div class="kpi">Phone</div><div class="kpi-small">No login or account required</div></div>
		</div>
		<div class="section-title"><h2>Customer reviews</h2></div>
		<div class="table-wrap">
			<table style="min-width:900px">
				<thead><tr><th>Ticket</th><th>Customer phone</th><th>Rating</th><th>Message</th><th>Submitted</th></tr></thead>
				<tbody>
					if len(data.Reviews) == 0 {
						<tr><td colspan="5">@emptyState("activity", "No reviews yet. When customers submit review links, their ratings and notes will appear here.")</td></tr>
					}
					for _, row := range data.Reviews {
						<tr>
							<td class="mono">{ row.Ticket }</td>
							<td class="mono">{ row.Phone }</td>
							<td>
								<span class="review-stars">{ row.Stars }</span>
								<span class="muted mono">{ strconv.Itoa(row.Rating) }/5</span>
							</td>
							<td>{ row.Note }</td>
							<td>{ row.SubmittedAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="operations">
		<div>
			<div class="section-title"><h2>Cash drawer</h2></div>
			<p class="muted">Cash is recorded from the staff terminal: opening cash when a shift starts, cash sales during the shift, and closing cash when the shift ends.</p>
			<div class="table-wrap section-spaced">
				<table style="min-width:860px">
					<thead><tr><th>When</th><th>Kind</th><th class="num">Amount</th><th class="num">Counted</th><th>Recorded by</th><th>Ticket</th><th>Note</th></tr></thead>
					<tbody>
						if len(data.CashMovements) == 0 {
							<tr><td colspan="7">@emptyState("cash", "No cash entries yet. Opening cash, cash sales, and closing records from the terminal will appear here.")</td></tr>
						}
						for _, row := range data.CashMovements {
							<tr><td>{ row.When }</td><td>{ row.Kind }</td><td class="num">{ row.Amount }</td><td class="num">{ row.Counted }</td><td>{ row.Recorder }</td><td class="mono">{ row.Ticket }</td><td>{ row.Note }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		<div class="dashboard-grid section-spaced">
			<div>
				<div class="section-title"><h2>Opening hours</h2></div>
				<form method="post" action="/owner/hours">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="table-wrap">
						<table style="min-width:760px">
							<thead><tr><th>Day</th><th>First open</th><th>First close</th><th>Second open</th><th>Second close</th><th>Closed</th><th>Current</th></tr></thead>
							<tbody>
								for _, day := range data.Hours {
									<tr>
										<td><strong>{ day.Label }</strong></td>
										<td><input class="table-input mono" type="time" name={ "open_" + strconv.Itoa(day.DayOfWeek) + "_1" } value={ day.Open1 }/></td>
										<td><input class="table-input mono" type="time" name={ "close_" + strconv.Itoa(day.DayOfWeek) + "_1" } value={ day.Close1 }/></td>
										<td><input class="table-input mono" type="time" name={ "open_" + strconv.Itoa(day.DayOfWeek) + "_2" } value={ day.Open2 }/></td>
										<td><input class="table-input mono" type="time" name={ "close_" + strconv.Itoa(day.DayOfWeek) + "_2" } value={ day.Close2 }/></td>
										<td>
											<label class="check-row compact-check">
												if day.Closed {
													<input type="checkbox" name={ "closed_" + strconv.Itoa(day.DayOfWeek) } value="true" checked/>
												} else {
													<input type="checkbox" name={ "closed_" + strconv.Itoa(day.DayOfWeek) } value="true"/>
												}
												<span>Closed</span>
											</label>
										</td>
										<td>{ day.Summary }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					if data.CanManagePumps {
						<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("check") Save hours</button></div>
					} else {
						<p class="muted">Only the owner, or a manager granted pump-management permission, can save opening hours.</p>
					}
				</form>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Pumps</h2></div>
				<div class="split-list">
					if len(data.Pumps) == 0 {
						@emptyState("activity", "No pumps yet. Add the first pump below.")
					}
					for _, pump := range data.Pumps {
						<form method="post" action="/owner/pumps" class="pump-edit-row">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<input type="hidden" name="id" value={ pump.ID }/>
							<div class="field"><label>Name</label><input type="text" name="name" value={ pump.Name } required/></div>
							<div class="field"><label>Order</label><input type="number" name="sort_order" value={ strconv.Itoa(pump.SortOrder) } min="1"/></div>
							<div class="field">
								<label>Status</label>
								@themedSelect("status", []themedSelectOption{
									{Value: "working", Label: "Working"},
									{Value: "not_working", Label: "Not working"},
									{Value: "maintenance", Label: "Under maintenance"},
								}, pump.StatusRaw)
							</div>
							<div class="info-row"><span>Queue</span><strong>{ strconv.Itoa(pump.BusyCount) } unfilled</strong></div>
							if data.CanManagePumps {
								<button class="btn compact" type="submit">Save</button>
							}
						</form>
					}
				</div>
				if data.CanManagePumps {
					<form method="post" action="/owner/pumps" class="section-spaced">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="form-grid">
							<div class="field"><label>New pump name</label><input type="text" name="name" placeholder="Pump 2" required/></div>
							<div class="field"><label>Order</label><input type="number" name="sort_order" placeholder="2" min="1"/></div>
							<input type="hidden" name="status" value="working"/>
						</div>
						<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("plus") Add pump</button></div>
					</form>
				}
			</div>
		</div>
		<div class="section-title section-spaced"><h2>Shift register</h2></div>
		<div class="table-wrap">
			<table style="min-width:980px">
				<thead><tr><th>Staff</th><th>Device</th><th>Pump</th><th>Opened</th><th>Closed</th><th class="num">Tickets</th><th class="num">Tokens</th><th class="num">Opening</th><th class="num">Closing</th><th>Status</th><th>Notes</th></tr></thead>
				<tbody>
					if len(data.Shifts) == 0 {
						<tr><td colspan="11">@emptyState("shifts", "No shifts yet. Once a cashier opens a shift, cash float, token count, sales, and closing cash will appear here.")</td></tr>
					}
					for _, row := range data.Shifts {
						<tr><td>{ row.Staff }</td><td class="mono">{ row.Device }</td><td>{ row.Pump }</td><td>{ row.Opened }</td><td>{ row.Closed }</td><td class="num">{ row.Tickets }</td><td class="num">{ row.TokensIssued } / { row.TokensReturned }</td><td class="num">{ row.OpeningCash }</td><td class="num">{ row.ClosingCash }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.Notes }</td></tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="staff">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Staff access</h2></div>
				<div class="table-wrap">
					<table style="min-width:920px">
						<thead><tr><th>Name</th><th>Phone</th><th>Role</th><th>Status</th><th>Permissions</th><th class="num">Sales</th><th class="num">Shifts</th><th>Joined</th><th></th></tr></thead>
						<tbody>
							if len(data.Staff) == 0 {
								<tr><td colspan="9">@emptyState("staff", "No staff yet. Managers, cashiers, and operators will appear here.")</td></tr>
							}
							for _, row := range data.Staff {
								<tr>
									<td><strong>{ row.Name }</strong></td><td class="mono">{ row.Phone }</td><td>{ row.Role }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td>
									<td>
										if data.CanGrantManagerPermissions && row.IsManager {
											<div class="permission-control">
												<div class="permission-chips" aria-label="Current permissions">
													if row.CanEditPrice {
														<span class="permission-chip enabled">@components.Icon("check") Price</span>
													} else {
														<span class="permission-chip">Price</span>
													}
													if row.CanManageStaff {
														<span class="permission-chip enabled">@components.Icon("check") Staff</span>
													} else {
														<span class="permission-chip">Staff</span>
													}
													if row.CanManagePumps {
														<span class="permission-chip enabled">@components.Icon("check") Pumps</span>
													} else {
														<span class="permission-chip">Pumps</span>
													}
												</div>
												<details class="permission-menu">
													<summary>Manage</summary>
													<form style="display: flex; flex-direction: column; gap: 12px;" method="post" action={ templ.SafeURL("/owner/staff/" + row.ID + "/permissions") } class="permission-form">
														<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
														<label class="check-row">
															if row.CanEditPrice {
																<input type="checkbox" name="can_edit_price" value="true" checked/>
															} else {
																<input type="checkbox" name="can_edit_price" value="true"/>
															}
															<span><strong>Edit gas price: </strong><em>Can update the live customer and terminal rate.</em></span>
														</label>
														<label class="check-row">
															if row.CanManageStaff {
																<input type="checkbox" name="can_manage_staff" value="true" checked/>
															} else {
																<input type="checkbox" name="can_manage_staff" value="true"/>
															}
															<span><strong>Manage staff: </strong><em>Can create staff and deactivate terminal access.</em></span>
														</label>
														<label class="check-row">
															if row.CanManagePumps {
																<input type="checkbox" name="can_manage_pumps" value="true" checked/>
															} else {
																<input type="checkbox" name="can_manage_pumps" value="true"/>
															}
															<span><strong>Manage pumps: </strong><em>Can rename pumps, change pump status, and update opening hours.</em></span>
														</label>
														<button class="btn compact primary" type="submit">Save permission</button>
													</form>
												</details>
											</div>
										} else if row.IsManager {
											<div class="permission-chips muted-permissions">
												if row.CanEditPrice {
													<span class="permission-chip enabled">@components.Icon("check") Price</span>
												}
												if row.CanManageStaff {
													<span class="permission-chip enabled">@components.Icon("check") Staff</span>
												}
												if row.CanManagePumps {
													<span class="permission-chip enabled">@components.Icon("check") Pumps</span>
												}
												if !row.CanEditPrice && !row.CanManageStaff && !row.CanManagePumps {
													<span class="permission-chip">No extra access</span>
												}
											</div>
										} else {
											<span class="permission-chip terminal-only">Terminal only</span>
										}
									</td>
									<td class="num">{ row.SalesCount }</td><td class="num">{ row.ShiftsCount }</td><td>{ row.Joined }</td>
									<td class="action-strip table-actions">
										if data.CanManageStaff && row.CanToggleActive {
											if row.Active {
												<form
													method="post"
													action={ templ.SafeURL("/owner/staff/" + row.ID + "/status") }
													data-confirm-title={ "Deactivate " + row.Name + "?" }
													data-confirm-desc="They won't be able to log in or use the terminal until you reactivate them."
													data-confirm-label="Deactivate"
													data-confirm-tone="warning"
												>
													<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
													<input type="hidden" name="active" value="false"/>
													<button class="btn" type="submit">Deactivate</button>
												</form>
											} else {
												<form
													method="post"
													action={ templ.SafeURL("/owner/staff/" + row.ID + "/status") }
													data-confirm-title={ "Reactivate " + row.Name + "?" }
													data-confirm-desc="They'll be able to log in and use the terminal again right away."
													data-confirm-label="Activate"
													data-confirm-tone="ok"
												>
													<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
													<input type="hidden" name="active" value="true"/>
													<button class="btn" type="submit">Activate</button>
												</form>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Add staff</h2></div>
				if data.CanManageStaff {
					<form method="post" action="/owner/staff">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="form-grid">
							<div class="field"><label>Name</label><input type="text" name="name" placeholder="Full name" required/></div>
							<div class="field"><label>Phone</label><input type="tel" name="phone" placeholder="0803 000 0000" required/></div>
							<div class="field">
								<label>Role</label>
								@themedSelect("role", []themedSelectOption{
									{Value: "cashier", Label: "Cashier"},
									{Value: "operator", Label: "Operator"},
									{Value: "manager", Label: "Manager"},
								}, "")
							</div>
							<div class="field"><label>PIN</label><input type="text" name="pin" placeholder="4-digit PIN" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required/></div>
						</div>
						<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("plus") Create staff</button></div>
					</form>
				} else {
					<p class="muted">Only the owner, or a manager granted staff-management permission, can create staff.</p>
				}
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="settings">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Price history</h2></div>
				<div class="table-wrap">
					<table style="min-width:560px">
						<thead><tr><th>Effective from</th><th class="num">Price</th><th>Set by</th><th>Created</th></tr></thead>
						<tbody>
							if len(data.PriceHistory) == 0 {
								<tr><td colspan="4">@emptyState("prices", "No price history yet. Every price change is kept here instead of overwritten.")</td></tr>
							}
							for _, row := range data.PriceHistory {
								<tr><td>{ row.EffectiveFrom }</td><td class="num">{ row.Price }</td><td>{ row.SetBy }</td><td>{ row.CreatedAt }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Set new rate</h2></div>
				if data.CanEditPrice {
					<form method="post" action="/owner/prices">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="form-grid">
							<div class="field"><label>Price per kg</label><input type="text" name="price_per_kg" placeholder="1150" inputmode="decimal" required/></div>
							<div class="field"><label>Effective from</label><input type="text" value="Immediately" disabled/></div>
						</div>
						<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("check") Save new price</button></div>
					</form>
				} else {
					<p class="muted">Only the owner, or a manager granted price-editing permission, can set the gas price.</p>
				}
			</div>
		</div>
		<div class="dashboard-grid section-spaced">
			<div>
				<div class="section-title"><h2>Plant details</h2></div>
				<form method="post" action="/owner/settings" enctype="multipart/form-data" data-splash="Saving settings">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="form-grid">
						<div class="field"><label>Plant name</label><input type="text" name="name" value={ data.PlantNameValue } placeholder="Your LPG plant" required/></div>
						<div class="field"><label>City</label><input type="text" name="city" value={ data.PlantCityValue } placeholder="Plant city"/></div>
						<div class="field"><label>Phone</label><input type="tel" name="phone" value={ data.PlantPhoneValue } placeholder="0803 000 0000"/></div>
						<div class="field" style="grid-column: 1 / -1;"><label>Address</label><input type="text" name="address" value={ data.PlantAddressValue } placeholder="Plant address"/></div>
					</div>
					<div class="section-title section-spaced"><h2>Brand kit</h2></div>
					<div class="form-grid">
						@brandColorField("Primary color", "primary_color", data.PlantPrimaryColorValue, "#006B4D")
						@brandColorField("Button color", "button_color", data.PlantButtonColorValue, "#006B4D")
						@brandColorField("Secondary color", "secondary_color", data.PlantSecondaryColorValue, "#10B981")
						@brandColorField("Button text color", "button_text_color", data.PlantButtonTextColorValue, "#F8FAFC")
						<div class="field" style="grid-column: 1 / -1;">
							<label>Logo</label>
							<div class="file-field" data-file-input>
								<input type="file" id="owner-logo-input" name="logo" accept="image/png,image/jpeg,image/webp" class="file-native"/>
								<label class="btn file-trigger" for="owner-logo-input">Choose file</label>
								<span class="file-name" data-file-name>
									if data.PlantLogoPath != "" {
										Current logo saved
									} else {
										No file chosen
									}
								</span>
							</div>
							if data.PlantLogoPath != "" {
								<img class="brand-logo-preview" src={ data.PlantLogoPath } alt="Plant logo"/>
							}
						</div>
					</div>
					<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("check") Save settings</button></div>
				</form>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Locked records</h2></div>
				<div class="split-list">
					<div class="info-row"><span>Legal business name</span><strong>{ data.PlantLegalBusinessName }</strong></div>
					<div class="info-row"><span>State</span><strong>{ data.PlantState }</strong></div>
					<div class="info-row"><span>CAC number</span><strong class="mono">{ data.PlantCACNumber }</strong></div>
					<div class="info-row"><span>NMDPRA license</span><strong class="mono">{ data.PlantNMDPRALicense }</strong></div>
					<div class="info-row"><span>Settlement account</span><strong class="mono">{ data.PlantBankAccount }</strong></div>
					<div class="info-row"><span>Account name</span><strong>{ data.PlantBankAccountName }</strong></div>
				</div>
				<p class="muted" style="margin-top: 12px;">These identify the registered business and payout destination. Contact GatsToGo to change them.</p>
			</div>
		</div>
		<div class="section-title section-spaced"><h2>Account security</h2></div>
		<p class="muted">Change the password you use to sign in to this dashboard.</p>
		<form method="post" action="/owner/password" data-splash="Updating password" style="max-width:420px;">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="field"><label>Current password</label><input type="password" name="current_password" autocomplete="current-password" required/></div>
			<div class="field" style="margin-top:10px;"><label>New password</label><input type="password" name="new_password" autocomplete="new-password" required/></div>
			<div class="field" style="margin-top:10px;"><label>Confirm new password</label><input type="password" name="new_password_confirm" autocomplete="new-password" required/></div>
			<div class="action-strip" style="margin-top:16px; justify-content:flex-start;"><button class="btn primary" type="submit">Update password</button></div>
		</form>
	</section>
}

// statusConfirm is the confirmation modal's content for one
// plantStatusForm/staff-status transition -- see the shared script in
// opsShell for how the data-confirm-* attributes it becomes drive the
// actual modal.
type statusConfirm struct {
	Title string
	Desc  string
	Tone  string // "warning" | "danger" | "ok"
}

// plantStatusForm is a single small "change this plant's status" button,
// used once per applicable transition in the Plants table -- e.g. an
// active plant gets one Suspend form, a suspended plant gets both
// Reactivate and Close. Kept as its own component since the same
// three-line form shape repeats per row per available transition.
templ plantStatusForm(plantID string, newStatus string, label string, csrfToken string, confirm statusConfirm) {
	<form
		method="post"
		action={ templ.SafeURL("/admin/plants/" + plantID + "/status") }
		data-confirm-title={ confirm.Title }
		data-confirm-desc={ confirm.Desc }
		data-confirm-label={ label }
		data-confirm-tone={ confirm.Tone }
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="status" value={ newStatus }/>
		<button class={ "btn", templ.KV("primary", newStatus == "active") } type="submit">{ label }</button>
	</form>
}

templ adminConsoleContent(data AdminConsoleData) {
	<div class="topline">
		<div>
			<div class="eyebrow">Platform admin console</div>
			<h1>Applications and plants</h1>
			<div class="meta-row">
				<span class="meta-ok">{ data.ActiveCount } active</span>
				<span class="sep"></span>
				<span class="meta-warn">{ data.OnboardingCount } under review</span>
				<span class="sep"></span>
				<span class="meta-danger">{ data.SuspendedCount } suspended</span>
				<span class="sep"></span>
				<span>{ data.ClosedCount } closed</span>
			</div>
		</div>
		<div class="toolbar">
			<button class="btn primary" type="button" data-tab="applications">
				@components.Icon("list-checks")
				Review applications
			</button>
		</div>
	</div>
	if data.ErrorMessage != "" {
		<div class="owner-error">
			@components.Icon("warning-circle")
			{ data.ErrorMessage }
		</div>
	}
	<section class="tab-panel active" data-tab-panel="overview">
		<div class="kpi-row">
			<div class="kpi-item">@kpiLabel("factory", "Plants")<div class="kpi">{ data.PlantCount }</div><div class="kpi-small">All plants on GatsToGo</div></div>
			<div class="kpi-item">@kpiLabel("list-checks", "Applications")<div class="kpi">{ data.OnboardingCount }</div><div class="kpi-small">Waiting for verification</div></div>
			<div class="kpi-item">@kpiLabel("receipt", "Transactions 7d")<div class="kpi">{ data.TotalTickets7d }</div><div class="kpi-small">Across active plants</div></div>
			<div class="kpi-item">@kpiLabel("gas-pump", "Volume 30d")<div class="kpi">{ data.TotalVolume30d }</div><div class="kpi-small">Paid ticket weight</div></div>
		</div>
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>New applications</h2></div>
				if len(data.Applications) == 0 {
					@emptyState("plants", "No plant applications are waiting for review.")
				} else {
					<div class="timeline">
						for _, row := range data.Applications {
							<div class="timeline-item application-item">
								<strong>{ row.Name }</strong>
								<span class="muted">{ row.OwnerName } · { row.OwnerPhone } · submitted { row.CreatedAt }</span>
								<div class="application-actions">
									<a class="btn" href={ templ.SafeURL("/admin/plants/" + row.ID) }>Review</a>
									@plantStatusForm(row.ID, "active", "Activate", data.CSRFToken, statusConfirm{
										Title: "Activate " + row.Name + "?",
										Desc:  "Its customer page, staff terminal, and owner login all go live immediately.",
										Tone:  "ok",
									})
								</div>
							</div>
						}
					</div>
				}
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Review checklist</h2></div>
				<div class="split-list split-list-steps">
					<div class="info-row"><span>1</span><strong>Confirm CAC, NMDPRA, address, and phone details.</strong></div>
					<div class="info-row"><span>2</span><strong>Confirm settlement account belongs to the plant.</strong></div>
					<div class="info-row"><span>3</span><strong>Check the owner contact and opening price.</strong></div>
					<div class="info-row"><span>4</span><strong>Activate only when the plant is ready to sell.</strong></div>
				</div>
				<p class="muted" style="margin-top: 12px;">Until activation, their customer page says the plant is under review.</p>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="applications">
		<div class="section-title"><h2>Applications under review</h2></div>
		<div class="table-wrap">
			<table style="min-width:1160px">
				<thead><tr><th>Plant</th><th>Owner</th><th>Business</th><th>Location</th><th>Web address</th><th>Submitted</th><th></th></tr></thead>
				<tbody>
					if len(data.Applications) == 0 {
						<tr><td colspan="7">@emptyState("plants", "No pending applications. New /get-started submissions will appear here with status under review.")</td></tr>
					}
					for _, row := range data.Applications {
						<tr>
							<td><strong><a class="plant-name-link" href={ templ.SafeURL("/admin/plants/" + row.ID) }>{ row.Name }</a></strong><div class="muted mono">{ row.Phone }</div></td>
							<td>{ row.OwnerName }<div class="muted mono">{ row.OwnerPhone }</div><div class="muted">{ row.OwnerEmail }</div></td>
							<td>{ row.LegalName }<div class="muted mono">{ row.CACNumber }</div><div class="muted mono">{ row.NMDPRALicense }</div></td>
							<td>{ row.City }<div class="muted">{ row.Address }</div></td>
							<td class="mono">{ row.Slug }</td>
							<td>{ row.CreatedAt }</td>
							<td class="action-strip table-actions">
								<a class="btn" href={ templ.SafeURL("/admin/plants/" + row.ID) }>Review</a>
								@plantStatusForm(row.ID, "active", "Activate", data.CSRFToken, statusConfirm{
									Title: "Activate " + row.Name + "?",
									Desc:  "Its customer page, staff terminal, and owner login all go live immediately.",
									Tone:  "ok",
								})
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="plants">
		<div class="section-title"><h2>Plants</h2></div>
		<div class="table-wrap">
			<table style="min-width:1300px">
				<thead><tr><th>Plant</th><th>Location</th><th>Web address</th><th>Status</th><th>Domain</th><th class="num">Staff</th><th class="num">Prices</th><th class="num">Open shifts</th><th class="num">Txns 7d</th><th class="num">Volume 30d</th><th>Last txn</th><th></th></tr></thead>
				<tbody>
					if len(data.Plants) == 0 {
						<tr><td colspan="12">@emptyState("plants", "No plants yet. Plant records with domain, staff, price, shift, and transaction health will appear here.")</td></tr>
					}
					for _, row := range data.Plants {
						<tr>
							<td><strong><a class="plant-name-link" href={ templ.SafeURL("/admin/plants/" + row.ID) }>{ row.Name }</a></strong><div class="muted mono">{ row.Phone }</div></td><td>{ row.City }<div class="muted">{ row.Address }</div></td><td class="mono" title={ row.Slug }>{ row.Slug }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.Domain }<div><span class={ "badge " + row.DomainBadge }>{ row.DomainStatus }</span></div></td><td class="num">{ row.StaffCount }</td><td class="num">{ row.PriceCount }</td><td class="num">{ row.OpenShifts }</td><td class="num">{ row.Txns7d }</td><td class="num">{ row.Volume30d }</td><td>{ row.LastTxn }</td>
							<td class="action-strip table-actions">
								<a class="btn" href={ templ.SafeURL("/admin/plants/" + row.ID) }>View</a>
								switch row.RawStatus {
									case "active":
										@plantStatusForm(row.ID, "suspended", "Suspend", data.CSRFToken, statusConfirm{
											Title: "Suspend " + row.Name + "?",
											Desc:  "Its customer page, staff terminal, and owner login all go offline immediately. You can reactivate it any time.",
											Tone:  "warning",
										})
									case "suspended":
										@plantStatusForm(row.ID, "active", "Reactivate", data.CSRFToken, statusConfirm{
											Title: "Reactivate " + row.Name + "?",
											Desc:  "Its customer page, staff terminal, and owner login all come back online immediately.",
											Tone:  "ok",
										})
										@plantStatusForm(row.ID, "closed", "Close", data.CSRFToken, statusConfirm{
											Title: "Close " + row.Name + "?",
											Desc:  "Like suspending, this takes everything offline immediately. Unlike suspending, there's no reactivate button for a closed plant in this console.",
											Tone:  "danger",
										})
									case "provisioning":
										@plantStatusForm(row.ID, "active", "Activate", data.CSRFToken, statusConfirm{
											Title: "Activate " + row.Name + "?",
											Desc:  "Its customer page, staff terminal, and owner login all go live immediately.",
											Tone:  "ok",
										})
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="activity">
		<div style="max-width: 640px;">
			<div class="section-title"><h2>Admin activity</h2></div>
			<div class="timeline">
				if len(data.RecentActivity) == 0 {
					@emptyState("activity", "No admin actions yet. Plant approvals, suspensions, and closures will appear here.")
				}
				for _, item := range data.RecentActivity {
					<div class="timeline-item"><strong>{ item.Action }</strong><span class="muted">{ item.Detail }</span></div>
				}
			</div>
		</div>
	</section>
}
