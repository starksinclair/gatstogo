package pages

import (
	"strconv"
	"strings"

	"gatstogo/internal/payments"
	"gatstogo/internal/plants"
	"gatstogo/web/templates/components"
)

// themedSelectOption is one <option> for themedSelect below.
type themedSelectOption struct {
	Value string
	Label string
}

// themedSelect renders a real <select name="..."> -- untouched, still
// exactly what a normal r.FormValue(name) read expects, still fully
// functional with zero JS -- plus a custom trigger button and listbox
// that gets progressively enhanced in. CSS alone can restyle a <select>'s
// closed box but never its open dropdown list cross-browser
// (owner-admin.css's/marketing.css's own .field select rules already
// handle the former; the wiring script below handles the latter).
// data-select is the one hook that script looks for -- this exact
// structure (.select-native/.select-trigger/.select-value/.select-list/
// [role=option]) is shared by every surface that has a <select> of its
// own: the admin console (opsShell's own script, this file) and the
// public signup form (marketingPageShell's copy of the same wiring,
// marketing_shell.templ) alike, each with their own CSS matching their
// own page's visual language (boxed vs. underline fields).
//
// selected is the option Value that should start pre-chosen -- "" means
// "the first option" (options[0]), the original behavior every admin-form
// call site (Role, cash movement Kind) still relies on, since those forms
// never echo a previous selection back. The public signup form
// (signup.templ) passes the visitor's own previously-submitted value
// instead, so a validation error on an unrelated field doesn't silently
// reset their State/Bank choice back to the top of the list.
templ themedSelect(name string, options []themedSelectOption, selected string) {
	{{ selectedIndex := themedSelectIndexOf(options, selected) }}
	<div class="select-shell" data-select>
		<select name={ name } class="select-native" required>
			for i, opt := range options {
				<option value={ opt.Value } selected?={ i == selectedIndex }>{ opt.Label }</option>
			}
		</select>
		<button type="button" class="select-trigger" aria-haspopup="listbox" aria-expanded="false">
			<span class="select-value">{ options[selectedIndex].Label }</span>
			@components.Icon("caret-down")
		</button>
		<ul class="select-list" role="listbox" hidden>
			for i, opt := range options {
				<li role="option" data-value={ opt.Value } aria-selected={ strconv.FormatBool(i == selectedIndex) } class={ templ.KV("selected", i == selectedIndex) }>{ opt.Label }</li>
			}
		</ul>
	</div>
}

// themedSelectIndexOf returns the index of the option whose Value matches
// selected, or 0 (the first option) if selected is empty or matches
// nothing -- see themedSelect's own doc comment.
func themedSelectIndexOf(options []themedSelectOption, selected string) int {
	if selected != "" {
		for i, opt := range options {
			if opt.Value == selected {
				return i
			}
		}
	}
	return 0
}

func colorInputValue(value string, fallback string) string {
	value = strings.TrimSpace(value)
	if len(value) == 6 {
		value = "#" + value
	}
	if validOwnerHexColor(value) {
		return value
	}
	return fallback
}

func validOwnerHexColor(value string) bool {
	value = strings.TrimSpace(value)
	if len(value) != 7 || !strings.HasPrefix(value, "#") {
		return false
	}
	for _, r := range value[1:] {
		if !((r >= '0' && r <= '9') || (r >= 'a' && r <= 'f') || (r >= 'A' && r <= 'F')) {
			return false
		}
	}
	return true
}

templ brandColorField(label string, name string, value string, fallback string) {
	<div class="field color-field" data-color-field>
		<label>{ label }</label>
		<div class="color-input-row">
			<input
				class="color-text"
				type="text"
				name={ name }
				value={ value }
				placeholder={ fallback }
				pattern="#?[0-9A-Fa-f]{6}"
				maxlength="7"
				title="Use a 6-digit hex color, like #006B4D or 006B4D"
				data-color-text
			/>
			<input
				class="color-picker"
				type="color"
				value={ colorInputValue(value, fallback) }
				aria-label={ label + " picker" }
				data-color-picker
			/>
		</div>
	</div>
}

// stateSelectOptions builds the "Create plant" panel's State dropdown from
// plants.NigerianStates -- the single source of truth also used to
// validate the submitted value server-side (internal/plants.go's
// validate). A leading placeholder is included since, unlike the Role
// dropdown's "Cashier" default, there's no sensible state to default to.
func stateSelectOptions() []themedSelectOption {
	opts := make([]themedSelectOption, 0, len(plants.NigerianStates)+1)
	opts = append(opts, themedSelectOption{Value: "", Label: "Select state"})
	for _, s := range plants.NigerianStates {
		opts = append(opts, themedSelectOption{Value: s, Label: s})
	}
	return opts
}

// bankSelectOptions builds the "Create plant" panel's Bank dropdown from a
// live-fetched (with fallback) bank list -- see AdminConsoleData.Banks and
// payments.Client.BanksWithFallback for where banks actually comes from.
// Converted to themedSelectOption here, inside this package, rather than
// exporting themedSelectOption for cmd/server to build directly -- keeps
// the handler layer's data (AdminConsoleData.Banks, plain []payments.Bank)
// decoupled from this page's own internal select-widget shape.
func bankSelectOptions(banks []payments.Bank) []themedSelectOption {
	opts := make([]themedSelectOption, 0, len(banks)+1)
	opts = append(opts, themedSelectOption{Value: "", Label: "Select bank"})
	for _, b := range banks {
		opts = append(opts, themedSelectOption{Value: b.Code, Label: b.Name})
	}
	return opts
}

