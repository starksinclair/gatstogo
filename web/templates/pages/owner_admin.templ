package pages

import (
	"strconv"
	"strings"

	"gatstogo/web/templates/components"
)

// themedSelectOption is one <option> for themedSelect below.
type themedSelectOption struct {
	Value string
	Label string
}

// themedSelect renders a real <select name="..."> -- untouched, still
// exactly what cmd/server/owner_write.go reads via r.FormValue(name),
// still fully functional with zero JS -- plus a custom trigger button
// and listbox that opsShell's shared script progressively enhances it
// into. See that script's own comment for why: CSS alone can restyle a
// <select>'s closed box but never its open dropdown list cross-
// browser (owner-admin.css's .field select already handled the
// former; this handles the latter). data-select is the one hook the
// script looks for -- this exact structure (.select-native/
// .select-trigger/.select-value/.select-list/[role=option]) is the
// reusable pattern to copy if another surface (customer pages,
// terminal, marketing) ever needs a <select> of its own; none of them
// have one today, so their own CSS/script don't carry this dead
// weight for nothing to style.
templ themedSelect(name string, options []themedSelectOption) {
	<div class="select-shell" data-select>
		<select name={ name } class="select-native">
			for _, opt := range options {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
		<button type="button" class="select-trigger" aria-haspopup="listbox" aria-expanded="false">
			<span class="select-value">{ options[0].Label }</span>
			@components.Icon("caret-down")
		</button>
		<ul class="select-list" role="listbox" hidden>
			for i, opt := range options {
				<li role="option" data-value={ opt.Value } aria-selected={ strconv.FormatBool(i == 0) } class={ templ.KV("selected", i == 0) }>{ opt.Label }</li>
			}
		</ul>
	</div>
}

type OwnerDashboardData struct {
	PlantName       string
	PlantSlug       string
	PlantCity       string
	PlantAddress    string
	PlantPhone      string
	DomainStatus    string
	TodayLabel      string
	CurrentPrice    string
	MoneyToday      string
	SalesCount      int64
	GasSoldKg       string
	ElectronicTotal string
	CashTotal       string
	PaidForKg       string
	FilledKg        string
	DiffKg          string
	DiffAmount      string
	RecentTickets   []OwnerTicketRow
	Staff           []OwnerStaffRow
	Shifts          []OwnerShiftRow
	CashMovements   []OwnerCashRow
	PriceHistory    []OwnerPriceRow
	Activity        []OwnerActivityRow
	CSRFToken       string
	ErrorMessage    string
	HasOpenShift    bool
}

type OwnerTicketRow struct {
	Reference string
	Code      string
	Customer  string
	Phone     string
	Kg        string
	NetKg     string
	Rate      string
	Amount    string
	Channel   string
	Status    string
	When      string
	PaidAt    string
	FilledAt  string
	BadgeCSS  string
}

// shortTicketRef trims a ticket reference's redundant plant-slug prefix
// for table display -- every reference on this one-plant dashboard
// already shares the same slug (tickets.NewReference always mints
// "{slug}-{suffix}"), so repeating "sunrise-" on every single row was
// pure noise, and also happened to be the single widest column in the
// table. Falls back to the untouched reference if it doesn't start with
// the expected prefix, so this only ever removes known redundancy, never
// hides real data. The void-ticket form still posts the full row.Reference
// unchanged -- this affects display only.
func shortTicketRef(reference, plantSlug string) string {
	prefix := plantSlug + "-"
	if trimmed := strings.TrimPrefix(reference, prefix); trimmed != reference {
		return trimmed
	}
	return reference
}

type OwnerStaffRow struct {
	ID          string
	Name        string
	Phone       string
	Role        string
	Status      string
	Active      bool
	// CanToggleActive is false for the owner's own row (and any
	// platform-admin row that happens to share this plant_id) --
	// internal/staff.SetActive already refuses those server-side, but the
	// button shouldn't be offered at all where it could only ever fail,
	// and specifically not where clicking it could lock the owner out of
	// their own dashboard.
	CanToggleActive bool
	SalesCount      int64
	ShiftsCount     int64
	Joined          string
	BadgeCSS        string
}

type OwnerShiftRow struct {
	Staff          string
	Device         string
	Opened         string
	Closed         string
	Tickets        int64
	TokensIssued   int
	TokensReturned string
	OpeningCash    string
	ClosingCash    string
	Notes          string
	Status         string
	BadgeCSS       string
}

type OwnerCashRow struct {
	When     string
	Kind     string
	Amount   string
	Counted  string
	Recorder string
	Ticket   string
	Note     string
}

type OwnerPriceRow struct {
	EffectiveFrom string
	Price         string
	SetBy         string
	CreatedAt     string
}

type OwnerActivityRow struct {
	Action  string
	Subject string
	When    string
}

type AdminConsoleData struct {
	PlantCount        int64
	ActiveCount       int64
	OnboardingCount   int64
	SuspendedCount    int64
	ClosedCount       int64
	DomainPending     int64
	DomainBroken      int64
	TotalTickets7d    int64
	TotalVolume30d    string
	Plants            []AdminPlantRow
	RecentActivity    []OwnerActivityRow
	ReservedSlugs     []string
	PlatformStaff     []AdminStaffRow
	SystemTables      []AdminSystemTable
	CSRFToken         string
	ErrorMessage      string
}

type AdminPlantRow struct {
	ID            string
	RawStatus     string
	Name          string
	City          string
	Address       string
	Phone         string
	Slug          string
	Status        string
	Domain        string
	DomainStatus  string
	FirstTxn      string
	Txns7d        int64
	Volume30d     string
	LastTxn       string
	StaffCount    int64
	PriceCount    int64
	OpenShifts    int64
	ActivityCount int64
	CreatedAt     string
	UpdatedAt     string
	BadgeCSS      string
	DomainBadge   string
}

type AdminStaffRow struct {
	Name   string
	Phone  string
	Status string
	Plants int64
}

type AdminSystemTable struct {
	Name        string // the real, internal data-store name -- never shown, only used to run the count query
	Label       string
	Role        string
	Records     int64
	Description string
}

templ OwnerDashboard(data OwnerDashboardData) {
	@opsShell(data.PlantName+" owner dashboard", "Owner", ownerNav(), ownerDashboardContent(data), "/owner/logout", data.CSRFToken)
}

templ AdminConsole(data AdminConsoleData) {
	@opsShell("GatsToGo admin console", "Admin", adminNav(), adminConsoleContent(data), "/admin/logout", data.CSRFToken)
}

templ opsShell(title string, railLabel string, nav templ.Component, content templ.Component, logoutAction string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/static/images/gatstogo.png"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/owner-admin.css"/>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					document.querySelectorAll("[data-tabs]").forEach(function (root) {
						function show(tab) {
							root.querySelectorAll("[data-tab]").forEach(function (button) {
								button.classList.toggle("active", button.dataset.tab === tab);
							});
							root.querySelectorAll("[data-tab-panel]").forEach(function (panel) {
								panel.classList.toggle("active", panel.dataset.tabPanel === tab);
							});
						}

						// Mobile off-canvas drawer -- the exact same .rail markup
						// used on desktop, just toggled via a fixed-position
						// transform below the 1020px breakpoint (see owner-
						// admin.css). Replaces what used to be a <select>
						// dropdown standing in for the whole sidebar on mobile.
						//
						// body.rail-locked's own overflow:hidden (owner-admin.css)
						// isn't enough on its own on real mobile browsers -- iOS
						// Safari in particular still lets the page scroll behind a
						// fixed element despite overflow:hidden on <body>. The
						// robust fix is to also pin <body> itself with
						// position:fixed and a negative top offset equal to the
						// current scroll position while the drawer is open, then
						// undo that and restore the exact scroll position on
						// close -- the standard technique for this, not a novel
						// one. Without it, a page scrolled down before opening the
						// drawer leaves the (still torso still scrollable)
						// background moving underneath a supposedly-fixed drawer,
						// which is exactly the "sidebar drifts away while
						// scrolling" bug this replaces.
						var lockedScrollY = 0;
						function openDrawer() {
							lockedScrollY = window.scrollY;
							document.body.classList.add("rail-locked");
							document.body.style.top = (-lockedScrollY) + "px";
							root.classList.add("rail-open");
						}
						function closeDrawer() {
							root.classList.remove("rail-open");
							document.body.classList.remove("rail-locked");
							document.body.style.top = "";
							window.scrollTo(0, lockedScrollY);
						}
						root.querySelectorAll("[data-rail-toggle]").forEach(function (button) {
							button.addEventListener("click", function () {
								root.classList.contains("rail-open") ? closeDrawer() : openDrawer();
							});
						});
						var backdrop = root.querySelector("[data-rail-backdrop]");
						if (backdrop) backdrop.addEventListener("click", closeDrawer);
						document.addEventListener("keydown", function (event) {
							if (event.key === "Escape") closeDrawer();
						});

						root.querySelectorAll("[data-tab]").forEach(function (button) {
							button.addEventListener("click", function () {
								show(button.dataset.tab);
								// A nav click on mobile is navigation, not just a
								// state change -- close the drawer the same way
								// tapping a link in any mobile nav drawer would.
								closeDrawer();
							});
						});

						// Themed <select> replacement (see themedSelect in
						// owner_admin.templ for the markup this wires up and why:
						// CSS alone can restyle a <select>'s closed box but never
						// its open dropdown list cross-browser). Progressive
						// enhancement -- the real <select name="..."> stays in
						// the DOM and is still exactly what actually gets
						// submitted with the form; owner-admin.css only hides it
						// (in favor of the custom trigger+listbox) once a shell
						// has the js-ready class this loop adds, so a page where
						// this script fails to run still has a fully working,
						// if plainer, native dropdown instead of nothing.
						root.querySelectorAll("[data-select]").forEach(function (shell) {
							var nativeSelect = shell.querySelector(".select-native");
							var trigger = shell.querySelector(".select-trigger");
							var valueLabel = shell.querySelector(".select-value");
							var list = shell.querySelector(".select-list");
							var items = Array.prototype.slice.call(list ? list.querySelectorAll('[role="option"]') : []);
							if (!nativeSelect || !trigger || !list || !items.length) return;

							var highlighted = 0;

							function syncFromNative() {
								items.forEach(function (li, i) {
									var isSelected = li.dataset.value === nativeSelect.value;
									li.setAttribute("aria-selected", isSelected ? "true" : "false");
									li.classList.toggle("selected", isSelected);
									if (isSelected) {
										valueLabel.textContent = li.textContent;
										highlighted = i;
									}
								});
							}
							function highlightItem(index) {
								items.forEach(function (li, i) { li.classList.toggle("highlighted", i === index); });
								if (items[index].scrollIntoView) items[index].scrollIntoView({ block: "nearest" });
							}
							function openList() {
								document.querySelectorAll(".select-shell.open").forEach(function (openShell) {
									if (openShell !== shell) closeList(openShell);
								});
								shell.classList.add("open");
								trigger.setAttribute("aria-expanded", "true");
								list.hidden = false;
								highlightItem(highlighted);
							}
							function closeList(target) {
								target = target || shell;
								target.classList.remove("open");
								target.querySelector(".select-trigger").setAttribute("aria-expanded", "false");
								target.querySelector(".select-list").hidden = true;
							}
							function selectItem(index) {
								var li = items[index];
								if (!li) return;
								nativeSelect.value = li.dataset.value;
								nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
								syncFromNative();
								closeList();
								trigger.focus();
							}

							trigger.addEventListener("click", function () {
								shell.classList.contains("open") ? closeList() : openList();
							});
							trigger.addEventListener("keydown", function (event) {
								if (event.key === "ArrowDown" || event.key === "ArrowUp") {
									event.preventDefault();
									if (!shell.classList.contains("open")) { openList(); return; }
									var dir = event.key === "ArrowDown" ? 1 : -1;
									highlighted = (highlighted + dir + items.length) % items.length;
									highlightItem(highlighted);
								} else if (event.key === "Enter" || event.key === " ") {
									event.preventDefault();
									shell.classList.contains("open") ? selectItem(highlighted) : openList();
								} else if (event.key === "Escape" && shell.classList.contains("open")) {
									event.preventDefault();
									event.stopPropagation(); // don't also close the mobile drawer
									closeList();
								}
							});
							items.forEach(function (li, i) {
								li.addEventListener("click", function () { selectItem(i); });
								li.addEventListener("mouseenter", function () { highlighted = i; highlightItem(i); });
							});
							document.addEventListener("click", function (event) {
								if (shell.classList.contains("open") && !shell.contains(event.target)) closeList();
							});

							syncFromNative();
							// Only once the custom trigger+listbox is actually
							// wired up and taking over does the native select
							// get pulled out of the tab order and accessibility
							// tree -- it's still what's found first (and works
							// fully natively) if this script never runs at all.
							nativeSelect.setAttribute("tabindex", "-1");
							nativeSelect.setAttribute("aria-hidden", "true");
							shell.classList.add("js-ready");
						});

						// A write action (set price, add staff, ...) redirects back
						// to #<tab> so the owner lands back where they were, not on
						// Overview -- see cmd/server/owner_write.go.
						var hashTab = location.hash.replace("#", "");
						var hashTarget = hashTab && root.querySelector('[data-tab-panel="' + hashTab + '"]');
						var initial = root.querySelector("[data-tab].active");
						show(hashTarget ? hashTab : (initial ? initial.dataset.tab : "overview"));
					});
				});
			</script>
		</head>
		<body>
			<div class="shell" data-tabs>
				<div class="mobile-topbar">
					<button class="rail-toggle" type="button" data-rail-toggle aria-label="Open menu">
						@components.Icon("list")
					</button>
					<div class="brand"><img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/><span>{ railLabel } workspace</span></div>
				</div>
				<div class="rail-backdrop" data-rail-backdrop></div>
				<aside class="rail">
					<div class="brand">
						<img class="mark" src="/static/images/gatstogo.png" alt="GatsToGo"/>
						<span>GATSTOGO</span>
						<button class="rail-close" type="button" data-rail-toggle aria-label="Close menu">
							@components.Icon("x")
						</button>
					</div>
					<div class="rail-label">{ railLabel } workspace</div>
					@nav
					<div class="rail-note">
						<strong>Real numbers only.</strong>
						Everything on this dashboard reflects what's actually happened. Sections stay empty until there's something real to show.
					</div>
					<form method="post" action={ templ.SafeURL(logoutAction) } class="rail-signout">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="nav-button" type="submit">
							<span class="nav-button-label">
								@components.Icon("sign-out")
								Sign out
							</span>
						</button>
					</form>
				</aside>
				<main class="main">
					@content
				</main>
			</div>
		</body>
	</html>
}

templ kpiLabel(icon string, label string) {
	<div class="kpi-label">
		@components.Icon(icon)
		{ label }
	</div>
}

templ navButton(active bool, tab string, icon string, label string) {
	<button class={ "nav-button", templ.KV("active", active) } type="button" data-tab={ tab }>
		<span class="nav-button-label">
			@components.Icon(icon)
			{ label }
		</span>
	</button>
}

templ ownerNav() {
	<nav class="rail-nav" aria-label="Owner sections">
		@navButton(true, "overview", "squares-four", "Overview")
		@navButton(false, "sales", "receipt", "Sales and receipts")
		@navButton(false, "cash", "money", "Cash drawer")
		@navButton(false, "shifts", "clock", "Shifts")
		@navButton(false, "staff", "users", "Staff")
		@navButton(false, "prices", "gas-pump", "Prices")
		@navButton(false, "activity", "clock-counter-clockwise", "Activity")
	</nav>
}

templ adminNav() {
	<nav class="rail-nav" aria-label="Admin sections">
		@navButton(true, "overview", "squares-four", "Overview")
		@navButton(false, "plants", "factory", "Plants")
		@navButton(false, "onboarding", "plus", "Onboarding")
		@navButton(false, "domains", "list-checks", "Domains and web addresses")
		@navButton(false, "activity", "clock-counter-clockwise", "Activity")
		@navButton(false, "system", "gear", "System")
	</nav>
}

templ ownerDashboardContent(data OwnerDashboardData) {
	<div class="topline">
		<div>
			<div class="eyebrow">Plant owner console</div>
			<h1>{ data.PlantName }</h1>
			<div class="meta-row">
				<span>{ data.TodayLabel }</span>
				<span class="sep"></span>
				<span>{ data.PlantCity }</span>
				<span class="sep"></span>
				<span class="mono">{ data.PlantSlug }</span>
				<span class="sep"></span>
				<span>Domain { data.DomainStatus }</span>
			</div>
		</div>
		<div class="toolbar">
			<button class="btn primary" type="button" data-tab="prices">
				@components.Icon("gas-pump")
				Set price
			</button>
		</div>
	</div>
	if data.ErrorMessage != "" {
		<div class="owner-error">
			@components.Icon("warning-circle")
			{ data.ErrorMessage }
		</div>
	}
	<section class="tab-panel active" data-tab-panel="overview">
		<div class="kpi-row">
			<div class="kpi-item">@kpiLabel("wallet", "Money today")<div class="kpi">{ data.MoneyToday }</div><div class="kpi-small">{ data.SalesCount } sales recorded</div></div>
			<div class="kpi-item">@kpiLabel("gas-pump", "Gas sold")<div class="kpi">{ data.GasSoldKg }</div><div class="kpi-small">Paid ticket size</div></div>
			<div class="kpi-item">@kpiLabel("receipt", "Current price")<div class="kpi">{ data.CurrentPrice }</div><div class="kpi-small">Snapshot used for new tickets</div></div>
			<div class="kpi-item">@kpiLabel("bank", "Cash / electronic")<div class="kpi">{ data.CashTotal }</div><div class="kpi-small">Electronic { data.ElectronicTotal }</div></div>
		</div>
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Reconciliation board</h2></div>
				<div class="stat-line">
					<div><div class="kpi-label">Gas paid for</div><strong class="mono">{ data.PaidForKg }</strong></div>
					<div><div class="kpi-label">Gas filled</div><strong class="mono">{ data.FilledKg }</strong></div>
					<div><div class="kpi-label">Difference</div><strong class="mono">{ data.DiffKg } · { data.DiffAmount }</strong></div>
				</div>
				<div class="meter">
					<div class="section-title"><h3>Daily control check</h3><span class="muted">Example only</span></div>
					<div class="meter-track"><div class="meter-fill"></div></div>
					<div class="muted">When live tank data is added, this line can compare expected gas against actual dispensing.</div>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Plant profile</h2></div>
				<div class="split-list">
					<div class="info-row"><span>Address</span><strong>{ data.PlantAddress }</strong></div>
					<div class="info-row"><span>Phone</span><strong>{ data.PlantPhone }</strong></div>
					<div class="info-row"><span>Web address</span><strong class="mono">{ data.PlantSlug }</strong></div>
					<div class="info-row"><span>Domain status</span><strong>{ data.DomainStatus }</strong></div>
				</div>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="sales">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Sales and receipts</h2></div>
				<div class="table-wrap">
					<table style="min-width:1240px">
						<thead><tr><th>Ticket</th><th>Customer</th><th>Code</th><th class="num">Paid kg</th><th class="num">Filled kg</th><th class="num">Amount</th><th>Channel</th><th>Status</th><th>Created</th><th></th></tr></thead>
						<tbody>
							if len(data.RecentTickets) == 0 {
								<tr><td colspan="10"><div class="empty">No sales yet. A paid customer ticket will show its reference, code, weight, payment method, and status here.</div></td></tr>
							}
							for _, row := range data.RecentTickets {
								<tr>
									<td class="mono" title={ row.Reference }>{ shortTicketRef(row.Reference, data.PlantSlug) }</td><td>{ row.Customer }<div class="muted mono">{ row.Phone }</div></td><td class="mono">{ row.Code }</td><td class="num">{ row.Kg }</td><td class="num">{ row.NetKg }</td><td class="num">{ row.Amount }</td><td>{ row.Channel }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.When }</td>
									<td>
										if row.Status == "PENDING" || row.Status == "PAID" {
											<form method="post" action={ templ.SafeURL("/tickets/" + row.Reference + "/void") } onsubmit="return confirm('Void this ticket? This cannot be undone.')">
												<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
												<button class="btn" type="submit">Void</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Receipt preview</h2></div>
				if len(data.RecentTickets) == 0 {
					<div class="empty">
						@components.Icon("receipt")
						No sales yet. The latest paid ticket's code will appear here.
					</div>
				} else {
					<div class="receipt-code">{ data.RecentTickets[0].Code }</div>
					<div><strong>{ data.RecentTickets[0].Kg }</strong> paid at { data.RecentTickets[0].Rate } by { data.RecentTickets[0].Channel }.</div>
					<div class="muted">Paid { data.RecentTickets[0].PaidAt } · Filled { data.RecentTickets[0].FilledAt }</div>
				}
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="cash">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Cash drawer</h2></div>
				<div class="table-wrap">
					<table style="min-width:860px">
						<thead><tr><th>When</th><th>Kind</th><th class="num">Amount</th><th class="num">Counted</th><th>Recorded by</th><th>Ticket</th><th>Note</th></tr></thead>
						<tbody>
							if len(data.CashMovements) == 0 {
								<tr><td colspan="7"><div class="empty">No cash entries yet. Opening float, cash sales, payouts, counts, and closing records will appear here.</div></td></tr>
							}
							for _, row := range data.CashMovements {
								<tr><td>{ row.When }</td><td>{ row.Kind }</td><td class="num">{ row.Amount }</td><td class="num">{ row.Counted }</td><td>{ row.Recorder }</td><td class="mono">{ row.Ticket }</td><td>{ row.Note }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Record cash count</h2></div>
				if data.HasOpenShift {
					<form method="post" action="/owner/cash-movements">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<div class="form-grid">
							<div class="field"><label>Counted cash</label><input type="text" name="amount" placeholder="0" inputmode="decimal" required/></div>
							<div class="field">
								<label>Kind</label>
								@themedSelect("kind", []themedSelectOption{
									{Value: "count", Label: "Closing count"},
									{Value: "deposit", Label: "Deposit"},
									{Value: "payout", Label: "Payout"},
								})
							</div>
							<div class="field" style="grid-column: 1 / -1;"><label>Note</label><textarea name="note" placeholder="Optional note for the owner"></textarea></div>
						</div>
						<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("check") Save count</button></div>
					</form>
				} else {
					<p class="muted">No shift is open right now. A cash entry needs an open shift to attach to. This targets the most recently opened shift if more than one is open at once.</p>
				}
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="shifts">
		<div class="section-title"><h2>Shift register</h2></div>
		<div class="table-wrap">
			<table style="min-width:980px">
				<thead><tr><th>Staff</th><th>Device</th><th>Opened</th><th>Closed</th><th class="num">Tickets</th><th class="num">Tokens</th><th class="num">Opening</th><th class="num">Closing</th><th>Status</th><th>Notes</th></tr></thead>
				<tbody>
					if len(data.Shifts) == 0 {
						<tr><td colspan="10"><div class="empty">No shifts yet. Once a cashier opens a shift, cash float, token count, sales, and closing cash will appear here.</div></td></tr>
					}
					for _, row := range data.Shifts {
						<tr><td>{ row.Staff }</td><td class="mono">{ row.Device }</td><td>{ row.Opened }</td><td>{ row.Closed }</td><td class="num">{ row.Tickets }</td><td class="num">{ row.TokensIssued } / { row.TokensReturned }</td><td class="num">{ row.OpeningCash }</td><td class="num">{ row.ClosingCash }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.Notes }</td></tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="staff">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Staff access</h2></div>
				<div class="table-wrap">
					<table style="min-width:760px">
						<thead><tr><th>Name</th><th>Phone</th><th>Role</th><th>Status</th><th class="num">Sales</th><th class="num">Shifts</th><th>Joined</th><th></th></tr></thead>
						<tbody>
							if len(data.Staff) == 0 {
								<tr><td colspan="8"><div class="empty">No staff yet. Owners, managers, cashiers, and operators will appear here.</div></td></tr>
							}
							for _, row := range data.Staff {
								<tr>
									<td><strong>{ row.Name }</strong></td><td class="mono">{ row.Phone }</td><td>{ row.Role }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td class="num">{ row.SalesCount }</td><td class="num">{ row.ShiftsCount }</td><td>{ row.Joined }</td>
									<td>
										if row.CanToggleActive {
											<form method="post" action={ templ.SafeURL("/owner/staff/" + row.ID + "/status") }>
												<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
												if row.Active {
													<input type="hidden" name="active" value="false"/>
													<button class="btn" type="submit">Deactivate</button>
												} else {
													<input type="hidden" name="active" value="true"/>
													<button class="btn" type="submit">Activate</button>
												}
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Add staff</h2></div>
				<form method="post" action="/owner/staff">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="form-grid">
						<div class="field"><label>Name</label><input type="text" name="name" placeholder="Full name" required/></div>
						<div class="field"><label>Phone</label><input type="tel" name="phone" placeholder="0803 000 0000" required/></div>
						<div class="field">
							<label>Role</label>
							@themedSelect("role", []themedSelectOption{
								{Value: "cashier", Label: "Cashier"},
								{Value: "operator", Label: "Operator"},
								{Value: "manager", Label: "Manager"},
							})
						</div>
						<div class="field"><label>PIN</label><input type="text" name="pin" placeholder="4-digit PIN" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required/></div>
					</div>
					<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("plus") Create staff</button></div>
				</form>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="prices">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Price history</h2></div>
				<div class="table-wrap">
					<table style="min-width:560px">
						<thead><tr><th>Effective from</th><th class="num">Price</th><th>Set by</th><th>Created</th></tr></thead>
						<tbody>
							if len(data.PriceHistory) == 0 {
								<tr><td colspan="4"><div class="empty">No price history yet. Every price change is kept here instead of overwritten.</div></td></tr>
							}
							for _, row := range data.PriceHistory {
								<tr><td>{ row.EffectiveFrom }</td><td class="num">{ row.Price }</td><td>{ row.SetBy }</td><td>{ row.CreatedAt }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Set new rate</h2></div>
				<form method="post" action="/owner/prices">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="form-grid">
						<div class="field"><label>Price per kg</label><input type="text" name="price_per_kg" placeholder="1150" inputmode="decimal" required/></div>
						<div class="field"><label>Effective from</label><input type="text" value="Immediately" disabled/></div>
					</div>
					<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("check") Save new price</button></div>
				</form>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="activity">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Activity trail</h2></div>
				<div class="timeline">
					if len(data.Activity) == 0 {
						<div class="empty">No activity yet. Ticket, price, shift, and staff changes will appear here.</div>
					}
					for _, item := range data.Activity {
						<div class="timeline-item"><strong>{ item.Action }</strong><span class="muted">{ item.Subject } · { item.When }</span></div>
					}
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Audit guide</h2></div>
				<div class="split-list">
					<div class="info-row"><span>Tickets</span><strong>Check customer proof and voids first.</strong></div>
					<div class="info-row"><span>Cash</span><strong>Match movements against shift close.</strong></div>
					<div class="info-row"><span>Prices</span><strong>Confirm the rate used at sale time.</strong></div>
				</div>
			</div>
		</div>
	</section>
}

// plantStatusForm is a single small "change this plant's status" button,
// used once per applicable transition in the Plants table -- e.g. an
// active plant gets one Suspend form, a suspended plant gets both
// Reactivate and Close. Kept as its own component since the same
// three-line form shape repeats per row per available transition.
templ plantStatusForm(plantID string, newStatus string, label string, csrfToken string) {
	<form method="post" action={ templ.SafeURL("/admin/plants/" + plantID + "/status") }>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="status" value={ newStatus }/>
		<button class="btn" type="submit">{ label }</button>
	</form>
}

templ adminConsoleContent(data AdminConsoleData) {
	<div class="topline">
		<div>
			<div class="eyebrow">Platform admin console</div>
			<h1>Plant network</h1>
			<div class="meta-row">
				<span class="meta-ok">{ data.ActiveCount } active</span>
				<span class="sep"></span>
				<span class="meta-warn">{ data.OnboardingCount } onboarding</span>
				<span class="sep"></span>
				<span class="meta-danger">{ data.SuspendedCount } suspended</span>
				<span class="sep"></span>
				<span>{ data.ClosedCount } closed</span>
			</div>
		</div>
		<div class="toolbar">
			<button class="btn primary" type="button" data-tab="onboarding">
				@components.Icon("plus")
				Onboard a plant
			</button>
		</div>
	</div>
	if data.ErrorMessage != "" {
		<div class="owner-error">
			@components.Icon("warning-circle")
			{ data.ErrorMessage }
		</div>
	}
	<section class="tab-panel active" data-tab-panel="overview">
		<div class="kpi-row">
			<div class="kpi-item">@kpiLabel("factory", "Plants")<div class="kpi">{ data.PlantCount }</div><div class="kpi-small">All plants on GatsToGo</div></div>
			<div class="kpi-item">@kpiLabel("list-checks", "Transactions 7d")<div class="kpi">{ data.TotalTickets7d }</div><div class="kpi-small">Across all plants</div></div>
			<div class="kpi-item">@kpiLabel("gas-pump", "Volume 30d")<div class="kpi">{ data.TotalVolume30d }</div><div class="kpi-small">Paid ticket weight</div></div>
			<div class="kpi-item">@kpiLabel("warning-circle", "Domain issues")<div class="kpi">{ data.DomainBroken }</div><div class="kpi-small">{ data.DomainPending } pending checks</div></div>
		</div>
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Launch queue</h2></div>
				<div class="split-list">
					<div class="info-row"><span>Plant record</span><strong>Name, web address, location, status, colors, and domain.</strong></div>
					<div class="info-row"><span>Owner access</span><strong>Create the first owner user and verify phone.</strong></div>
					<div class="info-row"><span>Opening price</span><strong>Add a price row before the customer page goes live.</strong></div>
					<div class="info-row"><span>First sale</span><strong>Watch ticket, cash, shift, and activity records arrive.</strong></div>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Platform staff</h2></div>
				<div class="timeline">
					if len(data.PlatformStaff) == 0 {
						<div class="empty">No platform admin users found yet.</div>
					}
					for _, row := range data.PlatformStaff {
						<div class="timeline-item"><strong>{ row.Name }</strong><span class="muted">{ row.Phone } · { row.Status } · { row.Plants } plant links</span></div>
					}
				</div>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="plants">
		<div class="section-title"><h2>Plants</h2></div>
		<div class="table-wrap">
			<table style="min-width:1300px">
				<thead><tr><th>Plant</th><th>Location</th><th>Web address</th><th>Status</th><th>Domain</th><th class="num">Staff</th><th class="num">Prices</th><th class="num">Open shifts</th><th class="num">Txns 7d</th><th class="num">Volume 30d</th><th>Last txn</th><th></th></tr></thead>
				<tbody>
					if len(data.Plants) == 0 {
						<tr><td colspan="12"><div class="empty">No plants yet. Plant records with domain, staff, price, shift, and transaction health will appear here.</div></td></tr>
					}
					for _, row := range data.Plants {
						<tr>
							<td><strong>{ row.Name }</strong><div class="muted mono">{ row.Phone }</div></td><td>{ row.City }<div class="muted">{ row.Address }</div></td><td class="mono" title={ row.Slug }>{ row.Slug }</td><td><span class={ "badge " + row.BadgeCSS }>{ row.Status }</span></td><td>{ row.Domain }<div><span class={ "badge " + row.DomainBadge }>{ row.DomainStatus }</span></div></td><td class="num">{ row.StaffCount }</td><td class="num">{ row.PriceCount }</td><td class="num">{ row.OpenShifts }</td><td class="num">{ row.Txns7d }</td><td class="num">{ row.Volume30d }</td><td>{ row.LastTxn }</td>
							<td class="action-strip">
								switch row.RawStatus {
									case "active":
										@plantStatusForm(row.ID, "suspended", "Suspend", data.CSRFToken)
									case "suspended":
										@plantStatusForm(row.ID, "active", "Reactivate", data.CSRFToken)
										@plantStatusForm(row.ID, "closed", "Close", data.CSRFToken)
									case "provisioning":
										@plantStatusForm(row.ID, "active", "Activate", data.CSRFToken)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="onboarding">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Create plant</h2></div>
				<form method="post" action="/admin/plants">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<div class="form-grid">
						<div class="field"><label>Plant name</label><input type="text" name="name" placeholder="Sunrise Gas Plant" required/></div>
						<div class="field"><label>Web address</label><input type="text" name="slug" placeholder="sunrise" pattern="[a-z0-9-]+" required/></div>
						<div class="field"><label>City</label><input type="text" name="city" placeholder="Owerri"/></div>
						<div class="field"><label>Phone</label><input type="tel" name="phone" placeholder="0803 000 0000"/></div>
						<div class="field" style="grid-column: 1 / -1;"><label>Address</label><input type="text" name="address" placeholder="Plant address"/></div>
						<div class="field"><label>Primary color</label><input type="text" name="primary_color" placeholder="#006B4D"/></div>
						<div class="field"><label>Button color</label><input type="text" name="button_color" placeholder="#006B4D"/></div>
						<div class="field"><label>Starting price per kg</label><input type="text" name="starting_price" placeholder="1150" inputmode="decimal" required/></div>
						<div class="field"><label>Owner name</label><input type="text" name="owner_name" placeholder="Full name" required/></div>
						<div class="field"><label>Owner phone</label><input type="tel" name="owner_phone" placeholder="0803 000 0000" required/></div>
						<div class="field"><label>Owner temporary password</label><input type="text" name="owner_password" placeholder="Set a temporary password" required/></div>
					</div>
					<div class="action-strip"><button class="btn primary" type="submit">@components.Icon("plus") Create plant</button></div>
				</form>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Onboarding checklist</h2></div>
				<div class="split-list">
					<div class="info-row"><span>1</span><strong>Reserve the web address and create the plant record.</strong></div>
					<div class="info-row"><span>2</span><strong>Add owner user and temporary password.</strong></div>
					<div class="info-row"><span>3</span><strong>Set starting price per kg.</strong></div>
					<div class="info-row"><span>4</span><strong>Test customer site, receipt page, and staff terminal.</strong></div>
				</div>
				<p class="muted" style="margin-top: 12px;">Steps 1-3 all happen from the one "Create plant" form. Step 4 is still on you.</p>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="domains">
		<div class="dashboard-grid">
			<div>
				<div class="section-title"><h2>Domain health</h2></div>
				<div class="table-wrap">
					<table style="min-width:800px">
						<thead><tr><th>Plant</th><th>Web address</th><th>Custom domain</th><th>Domain status</th><th>Created</th><th>Updated</th></tr></thead>
						<tbody>
							if len(data.Plants) == 0 {
								<tr><td colspan="6"><div class="empty">No domains to check yet.</div></td></tr>
							}
							for _, row := range data.Plants {
								<tr><td>{ row.Name }</td><td class="mono">{ row.Slug }</td><td>{ row.Domain }</td><td><span class={ "badge " + row.DomainBadge }>{ row.DomainStatus }</span></td><td>{ row.CreatedAt }</td><td>{ row.UpdatedAt }</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="dash-aside">
				<div class="section-title"><h2>Reserved web addresses</h2></div>
				<div class="timeline">
					if len(data.ReservedSlugs) == 0 {
						<div class="empty">No reserved words found yet. Protected web addresses like admin, api, and support appear here.</div>
					}
					for _, slug := range data.ReservedSlugs {
						<div class="timeline-item"><strong class="mono">{ slug }</strong><span class="muted">Protected web address</span></div>
					}
				</div>
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="activity">
		<div style="max-width: 640px;">
			<div class="section-title"><h2>Platform activity</h2></div>
			<div class="timeline">
				if len(data.RecentActivity) == 0 {
					<div class="empty">No platform activity yet. Plant setup, suspension, price, and domain changes will appear here.</div>
				}
				for _, item := range data.RecentActivity {
					<div class="timeline-item"><strong>{ item.Action }</strong><span class="muted">{ item.Subject } · { item.When }</span></div>
				}
			</div>
		</div>
	</section>
	<section class="tab-panel" data-tab-panel="system">
		<div class="section-title"><h2>System overview</h2></div>
		<div class="table-wrap">
			<table style="min-width:720px">
				<thead><tr><th>Data area</th><th>What it controls</th><th class="num">Entries</th><th>Notes</th></tr></thead>
				<tbody>
					if len(data.SystemTables) == 0 {
						<tr><td colspan="4"><div class="empty">No table stats available yet.</div></td></tr>
					}
					for _, row := range data.SystemTables {
						<tr><td><strong>{ row.Label }</strong></td><td>{ row.Role }</td><td class="num">{ row.Records }</td><td>{ row.Description }</td></tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}
