package pages

import "gatstogo/web/templates/components"

// OwnerChangePassword is the dedicated "change password" page for an owner
// who is already signed in (GET /owner/password). Settings links here
// rather than embedding the form, so changing a password is its own
// focused flow: form -> inline errors on this page -> a clear "Password
// updated" confirmation. done switches to that confirmation.
templ OwnerChangePassword(plantName string, errorMsg string, done bool, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Change password · { plantName }</title>
			@components.BrandFavicons()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ cssURL("tokens.css") }/>
			<link rel="stylesheet" href={ cssURL("owner-admin.css") }/>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					// Loading overlay on submit (same as the other auth pages).
					var splashOverlay = document.querySelector("[data-splash-overlay]");
					var splashMessage = splashOverlay && splashOverlay.querySelector("[data-splash-message]");
					document.querySelectorAll("form[data-splash]").forEach(function (form) {
						form.addEventListener("submit", function () {
							if (!splashOverlay) return;
							if (splashMessage) splashMessage.textContent = form.dataset.splash;
							splashOverlay.hidden = false;
							requestAnimationFrame(function () { splashOverlay.classList.add("open"); });
						});
					});

					// Show / hide password.
					document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
						var input = document.getElementById(button.dataset.passwordToggle);
						if (!input) return;
						button.addEventListener("click", function () {
							var show = input.type === "password";
							input.type = show ? "text" : "password";
							button.classList.toggle("is-shown", show);
							button.setAttribute("aria-label", show ? "Hide password" : "Show password");
						});
					});

					// Live checklist. The server checks the same rules again.
					var form = document.querySelector("[data-change-password]");
					if (!form) return;
					var current = form.querySelector("#current-password");
					var next = form.querySelector("#new-password");
					var confirm = form.querySelector("#new-password-confirm");
					var submit = form.querySelector("[type=submit]");
					function update() {
						var rules = {
							length: next.value.length >= 8,
							different: next.value !== "" && next.value !== current.value,
							match: confirm.value !== "" && confirm.value === next.value
						};
						var all = true;
						Object.keys(rules).forEach(function (key) {
							var item = form.querySelector('[data-rule="' + key + '"]');
							if (item) item.classList.toggle("is-met", rules[key]);
							if (!rules[key]) all = false;
						});
						submit.disabled = !(all && current.value !== "");
					}
					[current, next, confirm].forEach(function (el) { el.addEventListener("input", update); });
					update();
				});
			</script>
		</head>
		<body class="account-body">
			<header class="account-top">
				<a class="account-back" href="/owner#settings">
					<span class="icon-flip">@components.Icon("arrow-right")</span>
					Back to settings
				</a>
				<div class="account-brand">
					@components.BrandMark("mark", "primary", "")
					<span>{ plantName }</span>
				</div>
			</header>
			<main class="account-main">
				if done {
					<div class="account-card account-done">
						<div class="account-done-icon">@components.Icon("check-circle")</div>
						<h1>Password updated</h1>
						<p class="login-sub">Use your new password the next time you sign in to this dashboard.</p>
						<a class="btn primary full-width" href="/owner">Back to dashboard</a>
						<a class="account-secondary-link" href="/owner#settings">Return to settings</a>
					</div>
				} else {
					<form class="account-card" method="post" action="/owner/password" data-splash="Updating password" data-change-password>
						<div>
							<div class="eyebrow">Account security</div>
							<h1>Change password</h1>
							<p class="login-sub">You'll use the new password the next time you sign in.</p>
						</div>
						if errorMsg != "" {
							<div class="owner-error login-error" role="alert">
								@components.Icon("warning-circle")
								{ errorMsg }
							</div>
						}
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="field">
							<label for="current-password">Current password</label>
							@passwordInput("current-password", "current_password", "current-password", true)
						</div>
						<div class="account-divider" role="presentation"></div>
						<div class="field">
							<label for="new-password">New password</label>
							@passwordInput("new-password", "new_password", "new-password", false)
						</div>
						<div class="field">
							<label for="new-password-confirm">Confirm new password</label>
							@passwordInput("new-password-confirm", "new_password_confirm", "new-password", false)
						</div>
						<ul class="pw-rules" aria-label="Password requirements">
							<li data-rule="length">@components.Icon("check-circle") At least 8 characters</li>
							<li data-rule="different">@components.Icon("check-circle") Different from your current password</li>
							<li data-rule="match">@components.Icon("check-circle") Both new passwords match</li>
						</ul>
						<button class="btn primary full-width" type="submit">Update password</button>
						<a class="account-secondary-link" href="/owner#settings">Cancel</a>
					</form>
				}
			</main>
			@splashOverlay()
		</body>
	</html>
}

// passwordInput is a password field with a show/hide toggle; both icons
// are rendered and CSS shows the right one (.is-shown on the button).
templ passwordInput(id string, name string, autocomplete string, autofocus bool) {
	<div class="field-password">
		<input id={ id } type="password" name={ name } autocomplete={ autocomplete } required autofocus?={ autofocus }/>
		<button type="button" class="field-password-toggle" data-password-toggle={ id } aria-label="Show password">
			<span class="when-hidden">@components.Icon("eye")</span>
			<span class="when-shown">@components.Icon("eye-slash")</span>
		</button>
	</div>
}
