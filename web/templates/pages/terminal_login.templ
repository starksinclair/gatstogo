package pages

import (
	"gatstogo/internal/domain"
	"strings"
)

type LoginEmployeeRow struct {
	ID        string
	Name      string
	Initials  string
	RoleLabel string
	CardClass string
}

type LoginCardData struct {
	Employees       []LoginEmployeeRow
	ErrorMsg        string
	ErrorClass      string
	Locked          bool
}

var pinKeys = []struct {
	Label  string
	Action string
	Soft   bool
}{
	{"1", "1", false}, {"2", "2", false}, {"3", "3", false},
	{"4", "4", false}, {"5", "5", false}, {"6", "6", false},
	{"7", "7", false}, {"8", "8", false}, {"9", "9", false},
	{"Clear", "clear", true}, {"0", "0", false}, {"Back", "back", true},
}

func terminalPlantName(plant *domain.Plant) string {
	if plant == nil || strings.TrimSpace(plant.Name) == "" {
		return "Gas plant"
	}
	return strings.TrimSpace(plant.Name)
}

templ StaffTerminalLogin(plant *domain.Plant, data LoginCardData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ terminalPlantName(plant) } staff terminal</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@500;600;700;800&family=IBM+Plex+Mono:wght@600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/terminal.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body>
			<div class="terminal-page">
				<div class="screen">
					<main class="start-grid">
						@LoginCard(plant, data)
					</main>
				</div>
			</div>
		</body>
	</html>
}

templ LoginCard(plant *domain.Plant, data LoginCardData) {
	<section class="terminal-card start-card" id="login-card">
		<div class="section-kicker">Shift start</div>
		<h1>Start terminal shift</h1>
		<p class="strong-help">Select your name, enter your PIN, then count opening cash.</p>
		<form hx-post="/terminal/start-shift" hx-target="#login-card" hx-swap="outerHTML">
			<div class="staff-grid" role="radiogroup" aria-label="Select employee">
				for _, e := range data.Employees {
					<label class={ e.CardClass }>
						<input type="radio" name="employee_id" value={ e.ID } class="visually-hidden-input"/>
						<span>{ e.Initials }</span>
						<strong>{ e.Name }</strong>
						<em>{ e.RoleLabel }</em>
					</label>
				}
			</div>
			if data.ErrorMsg != "" {
				<div class={ "state-message", data.ErrorClass }>{ data.ErrorMsg }</div>
			}
			<label class="field-label" for="opening-cash">Opening cash drawer</label>
			<input id="opening-cash" name="opening_cash" class="terminal-input mono" placeholder="20000" inputmode="numeric" autocomplete="off"/>
			<input type="hidden" name="pin" id="pin-value"/>
			<div class="pin-dots">
				<span></span>
				<span></span>
				<span></span>
				<span></span>
			</div>
			<div class="keypad small">
				for _, k := range pinKeys {
					if k.Soft {
						<button class="key key-soft" type="button" data-pin-key={ k.Action }>{ k.Label }</button>
					} else {
						<button class="key" type="button" data-pin-key={ k.Action }>{ k.Label }</button>
					}
				}
			</div>
			<button class="primary-action" type="submit">Start shift</button>
		</form>
	</section>
	<script>
		(function () {
			var card = document.getElementById("login-card");
			if (!card) return;
			var pinInput = card.querySelector("#pin-value");
			var dots = card.querySelectorAll(".pin-dots span");
			card.querySelectorAll("[data-pin-key]").forEach(function (btn) {
				btn.addEventListener("click", function () {
					var action = btn.dataset.pinKey;
					var value = pinInput.value;
					if (action === "back") value = value.slice(0, -1);
					else if (action === "clear") value = "";
					else if (value.length < 4) value += action;
					pinInput.value = value;
					dots.forEach(function (dot, i) {
						dot.classList.toggle("filled", i < value.length);
					});
				});
			});
		})();
	</script>
}
