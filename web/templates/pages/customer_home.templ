package pages

import (
	"gatstogo/internal/domain"
	"gatstogo/web/templates/components"
	"strconv"
	"strings"
)

type customerHomeTheme struct {
	Name       string
	Address    string
	City       string
	Phone      string
	PhoneHref  string
	LogoPath   string
	Primary    string
	Secondary  string
	Button     string
	ButtonText string
	Tint       string
	SubtleTint string
}

const (
	customerDefaultName        = "Your LPG plant"
	customerDefaultAddress     = "Plant location coming soon"
	customerSamplePhone        = "0803 000 0000"
	customerDefaultPrimary     = "#006B4D"
	customerDefaultSecondary   = "#10B981"
	customerDefaultButton      = "#006B4D"
	customerDefaultButtonText  = "#F8FAFC"
	customerDefaultText        = "#0F172A"
	customerDefaultPlaceholder = "Coming soon"
)

func customerTheme(plant *domain.Plant) customerHomeTheme {
	name := customerDefaultName
	if plant != nil && strings.TrimSpace(plant.Name) != "" {
		name = strings.TrimSpace(plant.Name)
	}

	address := customerDefaultAddress
	if plant != nil {
		parts := make([]string, 0, 2)
		if plant.Address != nil && strings.TrimSpace(*plant.Address) != "" {
			parts = append(parts, strings.TrimSpace(*plant.Address))
		}
		if plant.City != nil && strings.TrimSpace(*plant.City) != "" {
			parts = append(parts, strings.TrimSpace(*plant.City))
		}
		if len(parts) > 0 {
			address = strings.Join(parts, ", ")
		}
	}

	city := customerDefaultPlaceholder
	if plant != nil && plant.City != nil && strings.TrimSpace(*plant.City) != "" {
		city = strings.TrimSpace(*plant.City)
	}

	phone := customerSamplePhone
	if plant != nil && plant.Phone != nil && strings.TrimSpace(*plant.Phone) != "" {
		phone = strings.TrimSpace(*plant.Phone)
	}

	logoPath := ""
	if plant != nil && plant.LogoPath != nil && strings.TrimSpace(*plant.LogoPath) != "" {
		logoPath = strings.TrimSpace(*plant.LogoPath)
	}

	primary := customerDefaultPrimary
	secondary := customerDefaultSecondary
	button := customerDefaultButton
	buttonText := customerDefaultButtonText
	if plant != nil {
		primary = validHexColorOr(plant.PrimaryColor, customerDefaultPrimary)
		secondary = validHexColorOr(plant.SecondaryColor, customerDefaultSecondary)
		button = validHexColorOr(plant.ButtonColor, primary)
		if validHexColor(plant.ButtonTextColor) {
			buttonText = strings.TrimSpace(plant.ButtonTextColor)
		} else {
			buttonText = readableTextColor(button)
		}
	}

	return customerHomeTheme{
		Name:       name,
		Address:    address,
		City:       city,
		Phone:      phone,
		PhoneHref:  whatsappHref(phone),
		LogoPath:   logoPath,
		Primary:    primary,
		Secondary:  secondary,
		Button:     button,
		ButtonText: buttonText,
		Tint:       mixHex(primary, "#FFFFFF", 0.92),
		SubtleTint: mixHex(primary, "#FFFFFF", 0.96),
	}
}

func validHexColorOr(value string, fallback string) string {
	value = strings.TrimSpace(value)
	if validHexColor(value) {
		return value
	}
	return fallback
}

func validHexColor(value string) bool {
	value = strings.TrimSpace(value)
	if len(value) != 4 && len(value) != 7 {
		return false
	}
	if !strings.HasPrefix(value, "#") {
		return false
	}
	for _, r := range value[1:] {
		if !((r >= '0' && r <= '9') || (r >= 'a' && r <= 'f') || (r >= 'A' && r <= 'F')) {
			return false
		}
	}
	return true
}

func whatsappHref(phone string) string {
	digits := make([]rune, 0, len(phone))
	for _, r := range phone {
		if r >= '0' && r <= '9' {
			digits = append(digits, r)
		}
	}
	if len(digits) == 0 {
		return "#"
	}
	return "https://wa.me/" + string(digits)
}

func readableTextColor(hex string) string {
	r, g, b, ok := hexToRGB(hex)
	if !ok {
		return customerDefaultButtonText
	}
	luminance := (0.299 * float64(r)) + (0.587 * float64(g)) + (0.114 * float64(b))
	if luminance > 150 {
		return customerDefaultText
	}
	return customerDefaultButtonText
}

func mixHex(hex string, target string, amount float64) string {
	ar, ag, ab, okA := hexToRGB(hex)
	br, bg, bb, okB := hexToRGB(target)
	if !okA || !okB {
		return "#F8FAFC"
	}
	r := int(float64(ar) + (float64(br)-float64(ar))*amount)
	g := int(float64(ag) + (float64(bg)-float64(ag))*amount)
	b := int(float64(ab) + (float64(bb)-float64(ab))*amount)
	return "rgb(" + strconv.Itoa(r) + "," + strconv.Itoa(g) + "," + strconv.Itoa(b) + ")"
}

func hexToRGB(hex string) (int64, int64, int64, bool) {
	hex = strings.TrimPrefix(strings.TrimSpace(hex), "#")
	if len(hex) == 3 {
		hex = string(hex[0]) + string(hex[0]) + string(hex[1]) + string(hex[1]) + string(hex[2]) + string(hex[2])
	}
	if len(hex) != 6 {
		return 0, 0, 0, false
	}
	r, errR := strconv.ParseInt(hex[0:2], 16, 64)
	g, errG := strconv.ParseInt(hex[2:4], 16, 64)
	b, errB := strconv.ParseInt(hex[4:6], 16, 64)
	return r, g, b, errR == nil && errG == nil && errB == nil
}

func customerCSSVars(theme customerHomeTheme) string {
	return "--brand:" + theme.Primary +
		";--brand-secondary:" + theme.Secondary +
		";--brand-button:" + theme.Button +
		";--brand-button-text:" + theme.ButtonText +
		";--brand-tint:" + theme.Tint +
		";--brand-subtle:" + theme.SubtleTint
}

// buyGasAlpineInit passes the live price per kg to the client-side kg
// preview. Converted to whole naira (the Alpine component's own unit,
// matching its formatNaira helper) with integer division -- this only
// affects the live preview text; the actual amount charged is computed
// server-side from the precise kobo value (cmd/server/tickets.go).
func buyGasAlpineInit(pricePerKgKobo int64) string {
	return "buyGasForm(" + strconv.FormatInt(pricePerKgKobo/100, 10) + ")"
}

// formatPricePerKg and formatThousands mirror cmd/server/main.go's
// formatNaira/formatWholeNumber. They can't be shared directly -- main.go
// is package main -- so this is a small, deliberate duplication rather
// than a shared internal/format package for two ~10-line helpers.
func formatPricePerKg(kobo int64) string {
	if kobo <= 0 {
		return "Price coming soon"
	}
	return "₦" + formatThousands(kobo/100)
}

func formatThousands(n int64) string {
	s := strconv.FormatInt(n, 10)
	if len(s) <= 3 {
		return s
	}
	var out []byte
	prefix := len(s) % 3
	if prefix == 0 {
		prefix = 3
	}
	out = append(out, s[:prefix]...)
	for i := prefix; i < len(s); i += 3 {
		out = append(out, ',')
		out = append(out, s[i:i+3]...)
	}
	return string(out)
}

templ CustomerHome(plant *domain.Plant, pricePerKgKobo int64, csrfToken string, errorMsg string) {
	{{ theme := customerTheme(plant) }}
	@customerPageShell(theme, theme.Name+" | Buy gas", customerHomeContent(theme, pricePerKgKobo, csrfToken, errorMsg))
}

// ReceiptListItem is one row in a customer's receipt list -- populated by
// cmd/server/receipts.go from tickets.ReceiptSummary, the same
// DB-row-to-view-model conversion loadOwnerTickets already does for the
// owner dashboard's ticket table.
type ReceiptListItem struct {
	Reference   string
	Href        string
	Kg          string
	Amount      string
	When        string
	Selected    bool
	StatusLabel string
	BadgeCSS    string
}

// ReceiptDetail is the full detail panel for one selected ticket --
// populated from tickets.Receipt.
type ReceiptDetail struct {
	Reference     string
	Code          string
	StatusLabel   string
	BadgeCSS      string
	Kg            string
	NetKg         string
	Rate          string
	Amount        string
	Channel       string
	When          string
	ConfirmedAt   string // "" if not yet confirmed
	CanConfirm    bool
	ConfirmAction string
	CSRFToken     string // session-derived CSRF token for the confirm form
}

// ReceiptsViewData drives all three states GET /receipts can render:
// "lookup" (no session yet -- phone entry), "verify" (a code was just
// sent, waiting for the customer to enter it), and "list" (a valid
// receipts session -- the ticket list + detail panel).
type ReceiptsViewData struct {
	Plant     *domain.Plant
	View      string
	CSRFToken string
	ErrorMsg  string
	Phone     string // the phone number just entered/verified, for display and to prefill the verify form
	Tickets   []ReceiptListItem
	Selected  *ReceiptDetail
}

func receiptItemClass(selected bool) string {
	if selected {
		return "receipt-item receipt-item-selected"
	}
	return "receipt-item"
}

templ CustomerReceipts(data ReceiptsViewData) {
	{{ theme := customerTheme(data.Plant) }}
	@customerPageShell(theme, theme.Name+" | Receipts", customerReceiptsContent(theme, data))
}

templ customerPageShell(theme customerHomeTheme, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<script>
				function buyGasForm(pricePerKg) {
					return {
						amount: '',
						// Tracks the same radio group the server reads via
						// name="channel" -- this is purely an additional
						// client-side read for the live order-summary sidebar
						// (see .summary-card), not a replacement for the
						// native radios' own name/value/checked, which are
						// still what actually gets submitted.
						channel: 'transfer',
						pricePerKg: pricePerKg,
						get naira() {
							var n = Number(this.amount);
							return Number.isFinite(n) && n > 0 ? Math.round(n) : 0;
						},
						get kg() {
							return this.naira > 0 ? this.naira / this.pricePerKg : 0;
						},
						get channelLabel() {
							if (this.channel === 'transfer') return 'Bank transfer';
							if (this.channel === 'terminal') return 'POS terminal';
							if (this.channel === 'ussd') return 'USSD';
							return '';
						},
						formatNaira: function (n) {
							return '₦' + Number(n).toLocaleString('en-NG');
						},
						formatKg: function (n) {
							return n.toFixed(2) + ' kg';
						}
					};
				}

				// Copy-to-clipboard for a real redemption code (ticket
				// confirmation, receipt detail -- never the buy-gas page's
				// illustrative placeholder, which never renders a
				// .copy-button at all). One delegated listener rather than
				// per-button wiring, so it works for however many
				// .copy-button elements a given page has, present or future.
				document.addEventListener("click", function (event) {
					var btn = event.target.closest(".copy-button");
					if (!btn) return;
					var code = btn.dataset.copy;
					if (!code) return;

					var label = btn.querySelector(".copy-label");
					function markCopied() {
						btn.classList.add("is-copied");
						if (label) label.textContent = "Copied";
						clearTimeout(btn._copyResetTimer);
						btn._copyResetTimer = setTimeout(function () {
							btn.classList.remove("is-copied");
							if (label) label.textContent = "Copy";
						}, 1600);
					}
					function fallbackCopy() {
						var ta = document.createElement("textarea");
						ta.value = code;
						ta.style.position = "fixed";
						ta.style.opacity = "0";
						document.body.appendChild(ta);
						ta.focus();
						ta.select();
						try { document.execCommand("copy"); markCopied(); } catch (e) {}
						document.body.removeChild(ta);
					}

					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(code).then(markCopied, fallbackCopy);
					} else {
						fallbackCopy();
					}
				});

				// Live countdown on the receipts one-time-code verify step
				// (data-code-timer, seconds). This script tag sits in <head>,
				// before the elements it targets are parsed, so the lookup
				// itself has to wait for DOMContentLoaded -- unlike the two
				// listeners above, which attach to `document` and don't need
				// the target elements to exist yet. Mirrors receipts.CodeTTL
				// (10 minutes) server-side; purely cosmetic; the server is
				// still the one authority on whether a code is actually still
				// valid; a stopped clock here never extends or shortens that.
				document.addEventListener("DOMContentLoaded", function () {
					var timers = document.querySelectorAll("[data-code-timer]");
					for (var i = 0; i < timers.length; i++) {
						(function (el) {
							var seconds = parseInt(el.dataset.codeTimer, 10);
							if (!seconds || seconds <= 0) return;
							var valueEl = el.querySelector(".code-timer-value");
							function render() {
								var m = Math.floor(seconds / 60);
								var s = seconds % 60;
								if (valueEl) valueEl.textContent = m + ":" + (s < 10 ? "0" : "") + s;
							}
							render();
							var interval = setInterval(function () {
								seconds -= 1;
								if (seconds <= 0) {
									clearInterval(interval);
									el.classList.add("is-expired");
									el.textContent = "";
									el.append("This code has expired. Request a new one.");
									return;
								}
								render();
							}, 1000);
						})(timers[i]);
					}
				});
			</script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/customer-home.css"/>
		</head>
		<body style={ customerCSSVars(theme) }>
			@content
			@siteFooter()
		</body>
	</html>
}

// siteFooter is deliberately minimal -- one hairline-topped row, not a
// multi-column marketing footer (that belongs on the marketing site
// itself, see marketing_shell.templ's marketingFooter). /terms and
// /privacy are registered directly on the top-level router (see
// rootOrTenant's doc comment in cmd/server/marketing.go), so these links
// resolve correctly regardless of which tenant subdomain this page is
// served from -- unlike "/", which is host-conditional, so the wordmark
// links to /about (also host-unconditional) rather than a bare "/" that
// would just loop back to this same plant's own homepage.
templ siteFooter() {
	<footer class="site-footer">
		<div class="wrap site-footer-inner">
			<a class="site-footer-brand" href="/about">Powered by GatsToGo</a>
			<nav class="site-footer-links">
				<a href="/terms">Terms</a>
				<a href="/privacy">Privacy</a>
			</nav>
		</div>
	</footer>
}

// customerBrand renders the plant's identity as a wordmark: the name set
// as text, never a placeholder. A fabricated logo (a colored square with
// the plant's first letter in it, standing in for a real one) read as
// unprofessional and got removed entirely -- if a plant has actually
// uploaded a logo image it's shown small and plain; if not, there's just
// no mark at all, not a substitute for one.
templ customerBrand(theme customerHomeTheme) {
	<div class="brand-lockup">
		if theme.LogoPath != "" {
			<img class="brand-logo" src={ theme.LogoPath } alt=""/>
		}
		<div>
			<div class="brand-name">{ theme.Name }</div>
			<div class="brand-meta">
				<span>{ theme.Address }</span>
				<span class="sep" aria-hidden="true"></span>
				<a href={ theme.PhoneHref } target="_blank" rel="noreferrer">{ theme.Phone }</a>
			</div>
		</div>
	</div>
}

templ customerHomeContent(theme customerHomeTheme, pricePerKgKobo int64, csrfToken string, errorMsg string) {
	<div class="page has-sticky-pay">
		<div class="wrap">
			<header class="site-header">
				@customerBrand(theme)
				<nav class="site-nav">
					<a href="/receipts">
						@components.Icon("receipt")
						Receipts
					</a>
				</nav>
			</header>
			<main class="buy-layout" x-data={ buyGasAlpineInit(pricePerKgKobo) }>
				<div class="buy-form-col">
					<h1 class="page-headline">Buy gas</h1>
					<p class="lede">No signup. Enter how much you want to spend, then your name and phone.</p>
					if errorMsg != "" {
						<div class="inline-alert">
							@components.Icon("warning-circle")
							{ errorMsg }
						</div>
					}
					<form id="buy-form" method="post" action="/tickets">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="field-step">
							<div class="step-index">01</div>
							<div class="step-body">
								<label class="step-title" for="amount">How much do you want to buy?</label>
								<div class="amount-field">
									<span class="amount-prefix">₦</span>
									<input
										id="amount"
										type="number"
										name="amount"
										inputmode="numeric"
										min="1"
										step="1"
										placeholder="14375"
										x-model="amount"
										aria-label="Amount in naira"
										required
									/>
								</div>
								<p class="kg-preview">
									<span x-show="naira <= 0">Enter an amount to see how many kg you will get.</span>
									<span x-show="naira > 0" x-cloak>
										You will get <strong x-text="formatKg(kg)">0.00 kg</strong>.
									</span>
								</p>
							</div>
						</div>
						<div class="field-step">
							<div class="step-index">02</div>
							<div class="step-body">
								<div class="step-title">Your details</div>
								<div class="field-grid">
									<div class="field-underline">
										<label for="name">Full name</label>
										<input id="name" type="text" name="name" placeholder="e.g. Ada Obi" autocomplete="name" required/>
									</div>
									<div class="field-underline">
										<label for="phone">Phone number</label>
										<input id="phone" type="tel" name="phone" placeholder="0803 000 0000" autocomplete="tel" required/>
									</div>
								</div>
							</div>
						</div>
						<div class="field-step">
							<div class="step-index">03</div>
							<div class="step-body">
								<div class="step-title">How will you pay?</div>
								<div class="payment-list" role="radiogroup" aria-label="Payment method">
									<label class="payment">
										<input type="radio" name="channel" value="transfer" class="sr-only" x-model="channel" checked/>
										@components.Icon("bank")
										<span>Bank transfer</span>
									</label>
									<label class="payment">
										<input type="radio" name="channel" value="terminal" class="sr-only" x-model="channel"/>
										@components.Icon("credit-card")
										<span>POS terminal</span>
									</label>
									<label class="payment">
										<input type="radio" name="channel" value="ussd" class="sr-only" x-model="channel"/>
										@components.Icon("device-mobile")
										<span>USSD</span>
									</label>
								</div>
							</div>
						</div>
					</form>
				</div>
				<aside class="buy-summary-col">
					<div class="section-eyebrow">Order summary</div>
					<div class="summary-price">
						@components.Icon("gas-pump")
						{ formatPricePerKg(pricePerKgKobo) } <span>/kg</span>
					</div>
					<div class="summary-rows">
						<div class="summary-row">
							<span>Amount</span>
							<strong x-text="naira > 0 ? formatNaira(naira) : '—'">—</strong>
						</div>
						<div class="summary-row">
							<span>Gas you'll get</span>
							<strong x-text="naira > 0 ? formatKg(kg) : '—'">—</strong>
						</div>
						<div class="summary-row">
							<span>Paying by</span>
							<strong x-text="channelLabel">Bank transfer</strong>
						</div>
					</div>
					<div class="summary-paybar">
						<button
							class="button-primary full-width"
							form="buy-form"
							type="submit"
							:disabled="naira <= 0"
							x-text="naira > 0 ? 'Pay ' + formatNaira(naira) : 'Enter amount to pay'"
						>
							Enter amount to pay
						</button>
					</div>
					<p class="fine-print">Your purchase is linked to this phone number. Keep the SMS receipt as proof of the weight you received.</p>
					<div class="after-payment">
						<div class="section-eyebrow">
							@components.Icon("hourglass-medium")
							After payment
						</div>
						<div class="code-preview code-preview-placeholder" aria-hidden="true">– – – –</div>
						<p class="fine-print">Join the queue as normal. Read this code to the attendant when you reach the front.</p>
					</div>
				</aside>
			</main>
		</div>
	</div>
}

templ customerReceiptsContent(theme customerHomeTheme, data ReceiptsViewData) {
	<div class="page">
		<div class="wrap">
			<header class="site-header">
				@customerBrand(theme)
				<nav class="site-nav">
					<a href="/">
						@components.Icon("gas-pump")
						Buy gas
					</a>
				</nav>
			</header>
			if data.ErrorMsg != "" {
				<div class="inline-alert">
					@components.Icon("warning-circle")
					{ data.ErrorMsg }
				</div>
			}
			switch data.View {
				case "list":
					@receiptsListView(data)
				case "verify":
					@receiptsVerifyView(data)
				default:
					@receiptsLookupView(data)
			}
		</div>
	</div>
}

templ receiptsLookupView(data ReceiptsViewData) {
	<main class="lookup-layout">
		<div class="lookup-icon">
			@components.Icon("receipt")
		</div>
		<h1 class="page-headline">Receipts</h1>
		<p class="lede">Enter the phone number you used to buy gas. We'll text you a 6-digit code to confirm it's you.</p>
		<form method="post" action="/receipts/lookup">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="field-underline">
				<label for="phone">Phone number</label>
				<input id="phone" type="tel" name="phone" placeholder="0803 000 0000" autocomplete="tel" required autofocus/>
			</div>
			<button class="button-primary full-width" type="submit">
				Send code
				@components.Icon("arrow-right")
			</button>
		</form>
	</main>
}

templ receiptsVerifyView(data ReceiptsViewData) {
	<main class="lookup-layout">
		<div class="lookup-icon">
			@components.Icon("shield-check")
		</div>
		<h1 class="page-headline">Enter your code</h1>
		<p class="lede">We sent a 6-digit code by SMS to { data.Phone }.</p>
		<p class="code-timer" data-code-timer="600" role="status" aria-live="polite">
			@components.Icon("clock")
			<span>Expires in <span class="code-timer-value">10:00</span></span>
		</p>
		<form method="post" action="/receipts/verify">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name="phone" value={ data.Phone }/>
			<div class="field-underline">
				<label for="code">6-digit code</label>
				<input id="code" type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" autocomplete="one-time-code" autofocus required/>
			</div>
			<button class="button-primary full-width" type="submit">
				Verify
				@components.Icon("arrow-right")
			</button>
		</form>
		<form method="post" action="/receipts/lookup" class="resend-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name="phone" value={ data.Phone }/>
			<button class="text-button full-width" type="submit">Resend code</button>
		</form>
	</main>
}

templ receiptsListView(data ReceiptsViewData) {
	<main class="receipts-layout">
		<aside class="receipts-list-col">
			<div class="section-eyebrow">Receipts</div>
			<p class="lede">Recent purchases linked to { data.Phone }.</p>
			if len(data.Tickets) == 0 {
				<div class="empty-state">
					@components.Icon("receipt")
					<strong>No purchases yet</strong>
					<p>Receipts for anything bought with this phone number will show up here.</p>
					<a class="text-button" href="/">Buy gas</a>
				</div>
			} else {
				<div class="receipt-list">
					for _, item := range data.Tickets {
						<a class={ receiptItemClass(item.Selected) } href={ item.Href }>
							<div><strong>{ item.Kg }</strong><span class="muted">{ item.When }</span></div>
							<div class="receipt-item-end">
								<span class={ "status-tag " + item.BadgeCSS }>{ item.StatusLabel }</span>
								<strong>{ item.Amount }</strong>
							</div>
						</a>
					}
				</div>
			}
		</aside>
		if data.Selected != nil {
			@receiptDetailView(*data.Selected)
		}
	</main>
}

templ receiptDetailView(d ReceiptDetail) {
	<section class="receipt-detail-col" aria-label="Receipt proof">
		<div class="detail-top">
			<div>
				<div class="section-eyebrow">{ d.StatusLabel }</div>
				<div class="muted">{ d.When } · Ticket { d.Reference }</div>
			</div>
			<span class={ "status-tag " + d.BadgeCSS }>{ d.StatusLabel }</span>
		</div>
		<div class="big-figure">
			<span class="big-figure-label">Gas you bought</span>
			<span class="big-figure-value">{ d.Kg }</span>
		</div>
		<div class="detail-rows">
			<div class="detail-row"><span>Weight received</span><span>{ d.NetKg }</span></div>
			<div class="detail-row"><span>Rate per kg</span><span>{ d.Rate }</span></div>
			<div class="detail-row"><span>Amount paid</span><span>{ d.Amount }</span></div>
			<div class="detail-row"><span>Paid by</span><span>{ d.Channel }</span></div>
		</div>
		<div class="after-payment">
			<div class="section-eyebrow">Redemption code</div>
			<div class="code-row">
				<div class="code-preview">{ d.Code }</div>
				<button type="button" class="copy-button" data-copy={ d.Code } aria-label="Copy code">
					@components.Icon("copy")
					<span class="copy-label">Copy</span>
				</button>
			</div>
			<p class="fine-print">Show this code to the attendant to collect your gas.</p>
		</div>
		if d.ConfirmedAt != "" {
			<div class="confirmed-strip">
				@components.Icon("check-circle")
				Confirmed { d.ConfirmedAt }
			</div>
		}
		<div class="detail-actions">
			if d.CanConfirm {
				<form method="post" action={ d.ConfirmAction }>
					<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
					<button class="button-primary" type="submit">
						@components.Icon("check")
						Confirm received
					</button>
				</form>
			}
			<a class="text-button" href="/">Buy again</a>
		</div>
	</section>
}
