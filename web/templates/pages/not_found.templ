package pages

import "gatstogo/web/templates/components"

// NotFound is the one branded 404 used everywhere this app previously
// returned a bare http.Error(w, "Plant not found", ...) text response --
// an unresolved tenant subdomain (middleware.Tenant), a genuinely
// unmatched route (chi's router.NotFound), and the several handlers that
// used to write that same string directly. Deliberately tenant-agnostic
// (no plant/theme passed in) and self-contained rather than nested inside
// marketingPageShell -- an error page doesn't need a full nav/footer, the
// same reasoning web/templates/pages/owner_login.templ's authShell
// already applies.
templ NotFound() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Page not found | GatsToGo</title>
			@components.BrandFavicons()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ cssURL("tokens.css") }/>
			<link rel="stylesheet" href={ cssURL("marketing.css") }/>
			<script src="https://cdn.jsdelivr.net/npm/@lottiefiles/lottie-player@2.0.12/dist/lottie-player.js" defer></script>
		</head>
		<body class="error-body">
			<header class="error-top">
				<a class="brand-lockup" href="/">
					@components.BrandMark("brand-mark", "primary", "GatsToGo")
					<strong>GATSTOGO</strong>
				</a>
				<a class="button-primary" href="/">Go to homepage</a>
			</header>
			<main class="error-page">
				<lottie-player class="error-lottie" src="/static/lottie/404.json" autoplay loop aria-hidden="true"></lottie-player>
				<h1>We couldn't find that page</h1>
				<p>The link may be mistyped, or that plant is no longer active.</p>
			</main>
		</body>
	</html>
}
