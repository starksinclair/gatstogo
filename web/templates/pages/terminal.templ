package pages

import (
	"gatstogo/internal/domain"
	"gatstogo/web/templates/components"
)

// init is passed through to templ.JSONScript untyped (any) rather than a
// named pages type -- cmd/server/terminal.go's terminalInitPayload is the
// one and only shape that's ever rendered here, and templ.JSONScript just
// needs something encoding/json can marshal, not a type this package has
// any other use for.
templ StaffTerminal(plant *domain.Plant, init any) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ terminalPlantName(plant) } staff terminal</title>
			@components.BrandFavicons()
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ cssURL("tokens.css") }/>
			<link rel="stylesheet" href={ cssURL("terminal.css") }/>
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					var root = document.querySelector("[data-terminal]");
					var init = JSON.parse(document.getElementById("terminal-init").textContent);
					var staff = init.staff || [];
					var manageStaff = init.manageStaff || [];
					var pumps = init.pumps || [];
					var reviews = init.reviews || [];
					var reviewAverage = init.reviewAverage || "No reviews yet";
					var reviewCount = init.reviewCount || 0;
					var pricePerKgNaira = init.pricePerKgKobo / 100;
					// Keep in sync with components.BrandMarkReversed (dark terminal chrome).
					var brandMarkReversed = "/static/images/gatstogo-logo/svg/gatstogo-mark-reversed.svg";

					// This whole screen is built by concatenating strings into HTML
					// and assigning it via .innerHTML (see render()/root.innerHTML
					// near the bottom of this script) rather than through templ's
					// own auto-escaping -- so anything interpolated into one of
					// those strings that didn't originate as a hardcoded literal in
					// this file must be escaped by hand here, or it's a stored XSS.
					// init.plantName (plant owner-set, and reachable via the public
					// /get-started signup form before any admin review) and every
					// staff member's own name (m.name/state.name, owner-set) both
					// go through this before ever reaching an HTML string -- this
					// page has no login wall at all (GET /terminal is public), so
					// an unescaped name here would execute in the browser of
					// literally any visitor who loads it, not just staff.
					function escapeHtml(value) {
						return String(value == null ? "" : value)
							.replace(/&/g, "&amp;")
							.replace(/</g, "&lt;")
							.replace(/>/g, "&gt;")
							.replace(/"/g, "&quot;")
							.replace(/'/g, "&#39;");
					}

					// state.* below is UI-local; every fact about what actually
					// happened (a fill confirmed, cash recorded, a shift open)
					// comes back from the server on each fetch() response and
					// overwrites the corresponding field here -- nothing about a
					// real transaction is computed or assumed client-side.
					var state = {
						screen: "start",
						employeeId: "",
						pumpId: "",
						pumpName: "",
						pin: "",
						openingCash: "",
						busy: false,
						startError: "",
						startNotice: "",
						lockedUntil: 0,
						lockTimer: null,

						// populated by a successful POST /terminal/pin:
						sessionCsrfToken: "",
						shiftId: "",
						userId: "",
						name: "",
						role: "",
						config: "combined",
						canEditPrice: false,
						canManageStaff: false,
						canManagePumps: false,
						priceInput: String(Math.round(pricePerKgNaira || 0)),

						tab: "fill",
						code: "",
						revealed: null,
						message: "",
						messageKind: "",
						messageTab: "",

						fills: 0,
						gramsDispensed: 0,
						cashHeldKobo: 0,
						pumpQueue: [],
						closeNote: "",
						newPumpName: "",
						newPumpStatus: "working",
						newPumpSort: "",
						cashAmount: "",
						phone: "",
						closingCash: "",
						shiftNotes: ""
					};

					function naira(kobo) {
						return "₦" + Math.round(kobo / 100).toLocaleString("en-NG");
					}
					function kg(grams) {
						var n = grams / 1000;
						return n.toFixed(n % 1 === 0 ? 0 : 2) + " kg";
					}
					function parseNairaInputToKobo(s) {
						var n = parseFloat((s || "").toString().replace(/[^0-9.]/g, ""));
						return Number.isFinite(n) ? Math.round(n * 100) : 0;
					}
					function gasGramsFromCashAmount() {
						var amountNaira = parseNairaInputToKobo(state.cashAmount) / 100;
						return pricePerKgNaira > 0 ? Math.round((amountNaira / pricePerKgNaira) * 1000) : 0;
					}
					function updateCashPreview() {
						var output = root.querySelector("[data-cash-kg]");
						if (output) output.textContent = kg(gasGramsFromCashAmount());
						var button = root.querySelector('[data-action="record-cash"]');
						if (button) {
							var blocked = state.cashHeldKobo >= blockLimitKobo;
							button.disabled = parseNairaInputToKobo(state.cashAmount) <= 0 || blocked || state.busy;
						}
					}
					function configForRole(role) {
						if (role === "cashier") return "cashier";
						if (role === "operator") return "operator";
						return "combined"; // manager
					}
					function applySessionData(d) {
						state.sessionCsrfToken = d.csrf_token;
						state.shiftId = d.shift_id;
						state.userId = d.user_id;
						state.name = d.name;
						state.role = d.role;
						state.config = configForRole(d.role);
						state.canEditPrice = !!d.can_edit_price;
						state.canManageStaff = !!d.can_manage_staff;
						state.canManagePumps = !!d.can_manage_pumps;
						state.priceInput = String(Math.round(pricePerKgNaira || 0));
						state.pumpId = d.pump_id || state.pumpId;
						state.pumpName = d.pump_name || state.pumpName;
						state.tab = d.role === "operator" ? "queue" : "fill";
						state.fills = d.fills_completed || 0;
						state.gramsDispensed = d.grams_dispensed || 0;
						state.cashHeldKobo = d.cash_held_kobo || 0;
						state.openingCash = d.opening_cash_kobo ? String(Math.round(d.opening_cash_kobo / 100)) : state.openingCash;
						state.screen = "main";
						state.startNotice = "";
					}
					function roleLabel(role) {
						if (role === "cashier") return "Cashier";
						if (role === "operator") return "Operator";
						if (role === "manager") return "Manager";
						return role;
					}
					// A small, hand-copied subset of the same Phosphor icon path
					// data web/templates/components/icon_paths.go embeds for
					// every templ-rendered page -- this page's UI is built by
					// string-concatenating HTML in JS instead (see render()
					// below), so it can't reach that Go-side component; this is
					// the deliberate JS-side equivalent, kept to only the icons
					// this page actually uses.
					var ICONS = {
						"check-circle": '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"/></svg>',
						"x-circle": '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M165.66,101.66,139.31,128l26.35,26.34a8,8,0,0,1-11.32,11.32L128,139.31l-26.34,26.35a8,8,0,0,1-11.32-11.32L116.69,128,90.34,101.66a8,8,0,0,1,11.32-11.32L128,116.69l26.34-26.35a8,8,0,0,1,11.32,11.32ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"/></svg>',
						"warning-circle": '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-8-80V80a8,8,0,0,1,16,0v56a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,172Z"/></svg>',
						"sign-out": '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M120,216a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V40a8,8,0,0,1,8-8h64a8,8,0,0,1,0,16H56V208h56A8,8,0,0,1,120,216Zm109.66-93.66-40-40a8,8,0,0,0-11.32,11.32L204.69,120H112a8,8,0,0,0,0,16h92.69l-26.35,26.34a8,8,0,0,0,11.32,11.32l40-40A8,8,0,0,0,229.66,122.34Z"/></svg>',
						"shield-check": '<svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208,40H48A16,16,0,0,0,32,56v56c0,52.72,25.52,84.67,46.93,102.19,23.06,18.86,46,25.26,47,25.53a8,8,0,0,0,4.2,0c1-.27,23.91-6.67,47-25.53C198.48,196.67,224,164.72,224,112V56A16,16,0,0,0,208,40Zm0,72c0,37.07-13.66,67.16-40.6,89.42A129.3,129.3,0,0,1,128,223.62a128.25,128.25,0,0,1-38.92-21.81C61.82,179.51,48,149.3,48,112l0-56,160,0ZM82.34,141.66a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32l-56,56a8,8,0,0,1-11.32,0Z"/></svg>'
					};
					function icon(name) { return ICONS[name] || ""; }
					// Maps a state.messageKind ("confirmed"/"wrong"/"used"/"locked")
					// to the icon that best matches its existing .state-message.*
					// color treatment in terminal.css -- success green for
					// confirmed, danger red for wrong, amber for used/locked/
					// anything else.
					function stateMessageIcon(kind) {
						if (kind === "confirmed") return icon("check-circle");
						if (kind === "wrong") return icon("x-circle");
						return icon("warning-circle");
					}
					function setMessage(tab, message, kind) {
						state.messageTab = tab;
						state.message = message;
						state.messageKind = kind || "confirmed";
					}
					function clearMessage(tab) {
						if (!tab || state.messageTab === tab) {
							state.message = "";
							state.messageKind = "";
							state.messageTab = "";
						}
					}
					function messageHtml(tab, fallbackKind) {
						if (!state.message || state.messageTab !== tab) return "";
						var kind = state.messageKind || fallbackKind || "confirmed";
						return '<div class="state-message ' + kind + '">' + stateMessageIcon(kind) + escapeHtml(state.message) + '</div>';
					}

					async function postForm(path, fields) {
						var body = new URLSearchParams();
						Object.keys(fields || {}).forEach(function (k) { body.set(k, fields[k]); });
						var headers = { "Content-Type": "application/x-www-form-urlencoded" };
						if (state.sessionCsrfToken) headers["X-CSRF-Token"] = state.sessionCsrfToken;
						var res = await fetch(path, { method: "POST", headers: headers, body: body.toString() });
						var data = {};
						try { data = await res.json(); } catch (e) {}
						return { ok: res.ok, status: res.status, data: data };
					}

					function selectedEmployee() {
						return staff.find(function (m) { return m.id === state.employeeId; }) || null;
					}
					function selectedRole() {
						var selected = selectedEmployee();
						return selected ? selected.role : "";
					}
					function pumpRequiredForStart() {
						return selectedRole() === "operator";
					}
					function canStartShift() {
						return state.employeeId !== "" && (!pumpRequiredForStart() || state.pumpId !== "") && state.pin.length === 4 && state.openingCash.trim() !== "" && !state.busy && Date.now() >= state.lockedUntil;
					}
					function syncStartButton() {
						var button = root.querySelector('[data-action="start-shift"]');
						if (button) button.disabled = !canStartShift();
					}

					function startLockCountdown() {
						clearInterval(state.lockTimer);
						state.lockTimer = setInterval(function () {
							if (Date.now() >= state.lockedUntil) {
								clearInterval(state.lockTimer);
								state.startError = "";
							}
							render();
						}, 250);
					}
					function lockSecondsRemaining() {
						return Math.max(0, Math.ceil((state.lockedUntil - Date.now()) / 1000));
					}

					async function startShift() {
						if (!canStartShift()) return;
						state.busy = true;
						state.startError = "";
						render();

						var result = await postForm("/terminal/pin", {
							user_id: state.employeeId,
							pump_id: state.pumpId,
							pin: state.pin,
							opening_cash: state.openingCash,
							device_id: "",
							csrf_token: init.csrfToken
						});

						state.busy = false;
						if (result.status === 429) {
							var retryAfter = (result.data && result.data.retry_after_seconds) || 20;
							state.lockedUntil = Date.now() + retryAfter * 1000;
							state.startError = "Too many attempts. Terminal locked.";
							state.pin = "";
							startLockCountdown();
							render();
							return;
						}
						if (!result.ok) {
							state.startError = (result.data && result.data.error) || "Incorrect PIN.";
							state.pin = "";
							render();
							return;
						}

						applySessionData(result.data);
						render();
					}

					function setEmployee(id) {
						state.employeeId = id;
						if (selectedRole() !== "operator") {
							state.startError = "";
						}
						render();
					}
					function setPump(id) {
						state.pumpId = id;
						var p = pumps.find(function (pump) { return pump.id === id; });
						state.pumpName = p ? p.name : "";
						render();
					}
					function setTab(tab) {
						// Operators have no cash-sale UI (the nav bar doesn't
						// even render that tab button for them -- see
						// renderMain), so this only matters as a defensive
						// backstop against reaching "cash" some other way.
						// It must NOT block "end" -- every role can end
						// their own shift; this used to say `tab !== "fill"`,
						// which silently broke the End shift button for
						// operators (setTab("end") was refused the same as
						// setTab("cash") would have been).
						if (state.config === "operator" && (tab === "cash" || tab === "fill")) return;
						if (tab === "queue" && (!state.pumpId || !(state.role === "manager" || state.role === "operator"))) return;
						if (tab === "price" && !(state.role === "manager" && state.canEditPrice)) return;
						if (tab === "pumps" && !(state.role === "manager" && state.canManagePumps)) return;
						if (tab === "staff" && !(state.role === "manager" && state.canManageStaff)) return;
						if (tab === "reviews" && state.role !== "manager") return;
						if (state.messageTab && state.messageTab !== tab) clearMessage();
						state.tab = tab;
						render();
						if (tab === "queue") loadPumpQueue();
					}
					function appendPin(value) {
						if (state.pin.length < 4) state.pin += value;
						render();
					}
					function backPin() {
						state.pin = state.pin.slice(0, -1);
						render();
					}

					function appendCode(value) {
						if (state.busy || state.code.length >= 4 || state.revealed) return;
						state.code += value;
						render();
						if (state.code.length === 4) submitCode();
					}
					function backCode() {
						if (state.busy || state.revealed) return;
						state.code = state.code.slice(0, -1);
						clearMessage("fill");
						render();
					}
					function clearCode() {
						state.code = "";
						state.revealed = null;
						clearMessage("fill");
						render();
					}

					async function submitCode() {
						state.busy = true;
						render();
						var result = await postForm("/terminal/redeem", { code: state.code });
						state.busy = false;

						if (result.ok) {
							state.revealed = result.data;
							clearMessage("fill");
							render();
							return;
						}
						if (result.status === 409) {
							setMessage("fill", "This code has already been filled.", "used");
						} else {
							setMessage("fill", "Incorrect code.", "wrong");
						}
						state.code = "";
						render();
						setTimeout(function () {
							if (state.messageTab === "fill" && (state.messageKind === "used" || state.messageKind === "wrong")) {
								clearMessage("fill");
								render();
							}
						}, 1200);
					}

					async function confirmFill() {
						if (!state.revealed || state.busy) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/fill", { ticket_id: state.revealed.ticket_id });
						state.busy = false;

						if (!result.ok) {
							setMessage("fill", (result.data && result.data.error) || "Could not confirm fill.", "wrong");
							render();
							return;
						}
						state.revealed = null;
						state.code = "";
						setMessage("fill", "Dispensing started. Ready for the next customer.", "confirmed");
						render();
						setTimeout(function () {
							if (state.messageTab === "fill" && state.messageKind === "confirmed") { clearMessage("fill"); render(); }
						}, 1600);
					}

					async function recordCash() {
						if (state.busy || parseNairaInputToKobo(state.cashAmount) <= 0) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/cash-sale", {
							amount_naira: state.cashAmount,
							phone: state.phone
						});
						state.busy = false;

						if (!result.ok) {
							setMessage("cash", (result.data && result.data.error) || "Could not record cash sale.", "wrong");
							render();
							return;
						}
						var d = result.data;
						state.cashHeldKobo = d.cash_held_kobo;
						state.phone = "";
						state.cashAmount = "";
						setMessage("cash", "Cash recorded for " + d.size_kg + ". Code: " + d.code + ". Pump: " + (d.pump || "assigned") + ".", "confirmed");
						render();
						setTimeout(function () {
							if (state.messageTab === "cash" && state.messageKind === "confirmed") { clearMessage("cash"); render(); }
						}, 3200);
					}

					async function loadPumpQueue() {
						if (!state.sessionCsrfToken || !state.pumpId) return;
						var res = await fetch("/terminal/pump-queue", { headers: { "X-CSRF-Token": state.sessionCsrfToken } });
						var data = {};
						try { data = await res.json(); } catch (e) {}
						if (res.ok) {
							state.pumpQueue = data.tickets || [];
							render();
						}
					}

					async function closeReceipt(ticketId) {
						if (state.busy) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/receipt/close", { ticket_id: ticketId, note: state.closeNote });
						state.busy = false;
						if (!result.ok) {
							setMessage("queue", (result.data && result.data.error) || "Could not close receipt.", "wrong");
							render();
							return;
						}
						state.fills = result.data.fills_completed;
						state.gramsDispensed = result.data.grams_dispensed;
						state.closeNote = "";
						setMessage("queue", "Receipt closed.", "confirmed");
						await loadPumpQueue();
					}

					async function bulkCloseReceipts() {
						if (state.busy || !state.pumpQueue.length) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/receipt/bulk-close", { note: state.closeNote });
						state.busy = false;
						if (!result.ok) {
							setMessage("queue", (result.data && result.data.error) || "Could not close receipts.", "wrong");
							render();
							return;
						}
						state.fills = result.data.fills_completed;
						state.gramsDispensed = result.data.grams_dispensed;
						state.closeNote = "";
						setMessage("queue", "Closed " + result.data.count + " receipts.", "confirmed");
						await loadPumpQueue();
					}

					async function savePrice() {
						if (state.busy || !(state.role === "manager" && state.canEditPrice)) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/price", { price_per_kg: state.priceInput });
						state.busy = false;
						if (!result.ok) {
							setMessage("price", (result.data && result.data.error) || "Could not save price.", "wrong");
							render();
							return;
						}
						pricePerKgNaira = result.data.price_per_kg_kobo / 100;
						init.pricePerKgKobo = result.data.price_per_kg_kobo;
						state.priceInput = String(Math.round(pricePerKgNaira));
						setMessage("price", "Price updated to " + result.data.price + ".", "confirmed");
						render();
					}

					function pumpStatusLabel(status) {
						if (status === "not_working") return "Not working";
						if (status === "maintenance") return "Maintenance";
						return "Working";
					}

					function updatePumpsFromResponse(data) {
						pumps = data.pumps || pumps;
						var active = pumps.find(function (p) { return p.id === state.pumpId; });
						if (active) state.pumpName = active.name;
					}

					function updateManageStaffFromResponse(data) {
						manageStaff = data.manage_staff || manageStaff;
						staff = manageStaff.filter(function (m) {
							return !!m.active;
						}).map(function (m) {
							return { id: m.id, name: m.name, role: m.role };
						});
					}

					async function savePump(id) {
						if (state.busy || !(state.role === "manager" && state.canManagePumps)) return;
						var p = id ? pumps.find(function (pump) { return pump.id === id; }) : {
							id: "",
							name: state.newPumpName,
							status: state.newPumpStatus,
							sort_order: state.newPumpSort
						};
						if (!p) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/pumps", {
							pump_id: p.id || "",
							name: p.name || "",
							status: p.status || "working",
							sort_order: p.sort_order || ""
						});
						state.busy = false;
						if (!result.ok) {
							setMessage("pumps", (result.data && result.data.error) || "Could not save pump.", "wrong");
							render();
							return;
						}
						updatePumpsFromResponse(result.data || {});
						if (!id) {
							state.newPumpName = "";
							state.newPumpStatus = "working";
							state.newPumpSort = "";
						}
						setMessage("pumps", "Pump saved.", "confirmed");
						render();
					}

					async function saveStaffStatus(id, active) {
						if (state.busy || !(state.role === "manager" && state.canManageStaff) || id === state.userId) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/staff/status", {
							user_id: id,
							active: active ? "true" : "false"
						});
						state.busy = false;
						if (!result.ok) {
							setMessage("staff", (result.data && result.data.error) || "Could not update staff.", "wrong");
							render();
							return;
						}
						updateManageStaffFromResponse(result.data || {});
						setMessage("staff", active ? "Staff member reactivated." : "Staff member deactivated.", "confirmed");
						render();
					}

					async function logoutTerminal() {
						if (state.busy) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/logout", {});
						state.busy = false;
						if (!result.ok) {
							setMessage(state.tab || "fill", (result.data && result.data.error) || "Could not log out.", "wrong");
							render();
							return;
						}
						resetToStart("Logged out. Your shift is still open; sign in again to continue or close it.");
					}

					async function finishShift() {
						if (state.busy) return;
						state.busy = true;
						render();
						var result = await postForm("/terminal/shift/end", { closing_cash: state.closingCash, notes: state.shiftNotes });
						state.busy = false;

						if (!result.ok) {
							setMessage("end", (result.data && result.data.error) || "Could not close shift.", "wrong");
							render();
							return;
						}
						resetToStart();
					}

					function resetToStart(notice) {
						clearInterval(state.lockTimer);
						state = {
							screen: "start", employeeId: "", pin: "", openingCash: "", busy: false, startError: "", startNotice: notice || "",
							lockedUntil: 0, lockTimer: null,
							sessionCsrfToken: "", shiftId: "", userId: "", name: "", role: "", config: "combined", canEditPrice: false, canManageStaff: false, canManagePumps: false, priceInput: String(Math.round(pricePerKgNaira || 0)),
							pumpId: "", pumpName: "",
							tab: "fill", code: "", revealed: null, message: "", messageKind: "", messageTab: "",
							fills: 0, gramsDispensed: 0, cashHeldKobo: 0, pumpQueue: [], closeNote: "", newPumpName: "", newPumpStatus: "working", newPumpSort: "", cashAmount: "", phone: "",
							closingCash: "", shiftNotes: ""
						};
						render();
					}

					var amberLimitKobo = 15000000; // ₦150,000
					var blockLimitKobo = 30000000; // ₦300,000
					function cashClass() {
						if (state.cashHeldKobo >= blockLimitKobo) return "danger";
						if (state.cashHeldKobo >= amberLimitKobo) return "warn";
						return "ok";
					}

					function keypad(type) {
						var labels = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "clear", "0", "back"];
						return labels.map(function (label) {
							if (label === "clear") return '<button class="key key-soft" type="button" data-action="' + type + '-clear">Clear</button>';
							if (label === "back") return '<button class="key key-soft" type="button" data-action="' + type + '-back">Back</button>';
							return '<button class="key" type="button" data-action="' + type + '-digit" data-value="' + label + '">' + label + '</button>';
						}).join("");
					}

					function renderStart() {
						var canStart = canStartShift();
						var locked = Date.now() < state.lockedUntil;
						var needsPump = pumpRequiredForStart();
						return '<main class="term-layout term-start">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Shift start</div>' +
								'<h1>Start terminal shift</h1>' +
								'<p class="helper-text">Pick your name, enter your PIN, then count opening cash. Operators must choose their pump.</p>' +
								(staff.length === 0 ? '<p class="helper-text">No staff are set up for this plant yet. Ask an owner to add staff from the owner dashboard.</p>' : '<div class="staff-grid">' + staff.map(employeeButton).join("") + '</div>') +
								'<div class="section-eyebrow section-spaced">Pump ' + (needsPump ? '<span class="required-note">Required</span>' : '<span class="required-note">Optional</span>') + '</div>' +
								(pumps.length === 0 ? '<p class="helper-text">No pumps are set up yet. Ask an owner to add a pump.</p>' : '<div class="staff-grid pump-grid">' + pumps.map(pumpButton).join("") + '</div>') +
								(state.startNotice ? '<div class="state-message confirmed">' + icon("check-circle") + state.startNotice + '</div>' : '') +
								'<div class="term-field">' +
									'<label class="field-label" for="opening-cash">Opening cash drawer</label>' +
									'<input id="opening-cash" class="term-input mono" value="' + state.openingCash + '" placeholder="₦20,000" inputmode="numeric" data-action="opening-cash" ' + (locked ? "disabled" : "") + '/>' +
								'</div>' +
								'<div class="start-actions">' +
									(state.startError ? '<div class="state-message wrong">' + icon("x-circle") + state.startError + (locked ? ' (' + lockSecondsRemaining() + 's)' : '') + '</div>' : '') +
									'<button class="primary-action" type="button" data-action="start-shift" ' + (canStart ? "" : "disabled") + '>' + (state.busy ? "Starting…" : "Start shift") + '</button>' +
								'</div>' +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Employee PIN</div>' +
								'<div class="pin-dots">' + [0,1,2,3].map(function (i) { return '<span class="' + (i < state.pin.length ? "filled" : "") + '"></span>'; }).join("") + '</div>' +
								'<div class="keypad small">' + keypad("pin") + '</div>' +
							'</aside>' +
						'</main>' +
						'<div class="term-meta">' + escapeHtml(init.plantName) + '<span class="sep"></span>' + init.todayLabel + '<span class="sep"></span>Selling at ' + naira(init.pricePerKgKobo) + '/kg today</div>';
					}
					function employeeButton(m) {
						return '<button class="staff-tile ' + (state.employeeId === m.id ? "active" : "") + '" type="button" data-action="employee" data-value="' + m.id + '"><span class="avatar avatar-logo"><img src="' + escapeHtml(init.plantLogo) + '" alt=""></span><strong>' + escapeHtml(m.name) + '</strong><em>' + roleLabel(m.role) + '</em>' + (m.shiftOpenSince ? '<span class="shift-open-note">Open since ' + escapeHtml(m.shiftOpenSince) + '</span>' : '') + '</button>';
					}
					function pumpButton(p) {
						var disabled = p.status !== "working";
						var detail = p.status === "working" ? (p.open_shift ? "In use" : (p.busy_count || 0) + " unfilled") : p.status.replace("_", " ");
						return '<button class="staff-tile ' + (state.pumpId === p.id ? "active" : "") + '" type="button" data-action="pump" data-value="' + p.id + '" ' + (disabled ? "disabled" : "") + '><span class="avatar avatar-logo"><img src="' + escapeHtml(init.plantLogo) + '" alt=""></span><strong>' + escapeHtml(p.name) + '</strong><em>' + escapeHtml(detail) + '</em></button>';
					}

					function renderMain() {
						return '<header class="terminal-top">' +
							'<div class="brand-row"><img class="brand-mark" src="' + brandMarkReversed + '" alt="GatsToGo"><strong>GATSTOGO</strong><span class="plant-name">' + escapeHtml(init.plantName) + '</span></div>' +
							'<div class="shift-strip">' +
								'<div class="stat"><span>Staff</span><strong>' + escapeHtml(state.name) + '</strong></div>' +
								'<div class="stat"><span>Pump</span><strong>' + escapeHtml(state.pumpName || "Pump") + '</strong></div>' +
								'<div class="stat"><span>Fills</span><strong class="mono">' + state.fills + '</strong></div>' +
								'<div class="stat"><span>Dispensed</span><strong class="mono">' + kg(state.gramsDispensed) + '</strong></div>' +
								'<button type="button" data-action="logout">' + icon("sign-out") + 'Log out</button>' +
								'<button type="button" data-action="end-screen">' + icon("sign-out") + 'End shift</button>' +
							'</div>' +
						'</header>' +
						'<nav class="terminal-tabs">' +
							(state.config === "operator" ? "" : tabButton("fill", "Fill")) +
							(state.config === "operator" ? "" : tabButton("cash", "Cash sale")) +
							(state.pumpId && (state.role === "manager" || state.role === "operator") ? tabButton("queue", "Pump receipts") : "") +
							(state.role === "manager" && state.canEditPrice ? tabButton("price", "Set price") : "") +
							(state.role === "manager" && state.canManagePumps ? tabButton("pumps", "Pumps") : "") +
							(state.role === "manager" && state.canManageStaff ? tabButton("staff", "Staff") : "") +
							(state.role === "manager" ? tabButton("reviews", "Reviews") : "") +
							tabButton("end", "End shift") +
						'</nav>' +
						'<main>' + (state.tab === "fill" ? renderFill() : state.tab === "cash" ? renderCash() : state.tab === "queue" ? renderQueue() : state.tab === "price" ? renderPrice() : state.tab === "pumps" ? renderPumps() : state.tab === "staff" ? renderStaff() : state.tab === "reviews" ? renderReviews() : renderEnd()) + '</main>';
					}
					function tabButton(id, label) {
						return '<button class="' + (state.tab === id ? "active" : "") + '" type="button" data-action="tab" data-value="' + id + '">' + label + '</button>';
					}

					function renderFill() {
						if (state.revealed) {
							var t = state.revealed;
							return '<div class="term-layout">' +
								'<div class="term-main fill-result">' +
									'<div class="section-eyebrow">' + icon("check-circle") + 'Authorised fill</div>' +
									'<div class="initials">' + (t.initials || "—") + '</div>' +
									'<div class="weight mono">' + t.size_kg + '</div>' +
									'<div class="proof-row"><span>Amount paid</span><strong class="mono">' + t.amount + '</strong></div>' +
									'<div class="proof-row"><span>Method</span><strong>' + t.channel + '</strong></div>' +
									'<div class="proof-row"><span>Pump</span><strong>' + escapeHtml(t.pump || "Assigned pump") + '</strong></div>' +
									'<button class="primary-action valve" type="button" data-action="confirm-fill" ' + (state.busy ? "disabled" : "") + '>' + (state.busy ? "Starting…" : "Start dispensing") + '</button>' +
								'</div>' +
								'<aside class="term-aside">' +
									'<div class="section-eyebrow">Privacy</div>' +
									'<p class="privacy-note">' + icon("shield-check") + 'No customer name, phone number, or ticket reference appears on this terminal.</p>' +
									'<button class="secondary-action" type="button" data-action="code-clear">Try another code</button>' +
								'</aside>' +
							'</div>';
						}
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Fill</div>' +
								'<h1>Enter customer code</h1>' +
								'<div class="code-boxes">' + [0,1,2,3].map(function (i) { return '<span class="mono' + (state.code[i] ? " filled" : "") + '">' + (state.code[i] || "–") + '</span>'; }).join("") + '</div>' +
								messageHtml("fill") +
								'<div class="keypad">' + keypad("code") + '</div>' +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Shift summary</div>' +
								'<div class="stat-block"><div class="stat-value mono">' + state.fills + '</div><div class="stat-label">Fills completed</div></div>' +
								'<div class="stat-block"><div class="stat-value mono">' + kg(state.gramsDispensed) + '</div><div class="stat-label">Kg dispensed</div></div>' +
							'</aside>' +
						'</div>';
					}

					function renderCash() {
						var amountKobo = parseNairaInputToKobo(state.cashAmount);
						var gasGrams = gasGramsFromCashAmount();
						var blocked = state.cashHeldKobo >= blockLimitKobo;
						var canRecord = amountKobo > 0 && !blocked && !state.busy;
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Cash sale</div>' +
								'<h1>Record cash and queue fill</h1>' +
								'<div class="term-field">' +
									'<label class="field-label" for="cash-amount">Cash received</label>' +
									'<input id="cash-amount" class="term-input mono" value="' + escapeHtml(state.cashAmount) + '" placeholder="₦5,000" inputmode="decimal" data-action="cash-amount"/>' +
								'</div>' +
								'<div class="term-field">' +
									'<label class="field-label" for="phone">Phone number optional</label>' +
									'<input id="phone" class="term-input mono" value="' + escapeHtml(state.phone) + '" placeholder="0803 000 0000" inputmode="tel" data-action="phone"/>' +
								'</div>' +
								'<div class="amount-row">' +
									'<span class="label">Gas at ' + naira(pricePerKgNaira * 100) + '/kg<em class="note">Published rate</em></span>' +
									'<strong class="value mono" data-cash-kg>' + kg(gasGrams) + '</strong>' +
								'</div>' +
								(blocked ? '<div class="state-message used">' + icon("warning-circle") + 'Cash limit reached. Record a deposit before taking more cash.</div>' : '') +
								'<button class="primary-action" type="button" data-action="record-cash" ' + (canRecord ? "" : "disabled") + '>' + (state.busy ? "Recording…" : "Record cash and queue fill") + '</button>' +
								messageHtml("cash") +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Cash holding</div>' +
								'<div class="cash-held ' + cashClass() + '"><strong class="mono">' + naira(state.cashHeldKobo) + '</strong><span>' + (cashClass() === "ok" ? "Normal" : cashClass() === "warn" ? "Deposit soon" : "Deposit required") + '</span></div>' +
								'<p class="helper-text">Cash sales create a customer code for the fill queue.</p>' +
							'</aside>' +
						'</div>';
					}
					function renderQueue() {
						var rows = state.pumpQueue || [];
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Pump receipts</div>' +
								'<h1>' + escapeHtml(state.pumpName || "Pump") + '</h1>' +
								'<p class="helper-text">Close receipts after dispensing is done. Notes are optional and saved on the receipt.</p>' +
								'<div class="term-field">' +
									'<label class="field-label" for="close-note">Close note optional</label>' +
									'<textarea id="close-note" class="term-input term-textarea" placeholder="Optional note for these receipts" data-action="close-note">' + escapeHtml(state.closeNote) + '</textarea>' +
								'</div>' +
								(rows.length === 0 ? '<div class="state-message confirmed">' + icon("check-circle") + 'No dispensing receipts for this pump.</div>' : '<div class="queue-list">' + rows.map(queueRow).join("") + '</div>') +
								messageHtml("queue") +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Bulk close</div>' +
								'<div class="stat-block"><div class="stat-value mono">' + rows.length + '</div><div class="stat-label">Open receipts</div></div>' +
								'<button class="primary-action" type="button" data-action="bulk-close" ' + (!rows.length || state.busy ? "disabled" : "") + '>Close all for this pump</button>' +
								'<button class="secondary-action" type="button" data-action="refresh-queue">Refresh</button>' +
							'</aside>' +
						'</div>';
					}
					function queueRow(row) {
						return '<div class="queue-row">' +
							'<div><strong class="mono">' + escapeHtml(row.code) + '</strong><span>' + escapeHtml(row.initials || "—") + ' · ' + escapeHtml(row.size_kg) + ' · ' + escapeHtml(row.amount) + '</span></div>' +
							'<button class="btn-like" type="button" data-action="close-receipt" data-value="' + escapeHtml(row.ticket_id) + '">' + icon("check-circle") + 'Filled</button>' +
						'</div>';
					}
					function renderPrice() {
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Manager permission</div>' +
								'<h1>Set gas price</h1>' +
								'<div class="term-field">' +
									'<label class="field-label" for="price-per-kg">Price per kg</label>' +
									'<input id="price-per-kg" class="term-input mono" value="' + escapeHtml(state.priceInput) + '" placeholder="1150" inputmode="decimal" data-action="price-input"/>' +
								'</div>' +
								'<div class="amount-row">' +
									'<span class="label">Current published price<em class="note">Used for cash sales and customer checkout</em></span>' +
									'<strong class="value mono">' + naira(pricePerKgNaira * 100) + '/kg</strong>' +
								'</div>' +
								messageHtml("price") +
								'<button class="primary-action" type="button" data-action="save-price" ' + (state.busy ? "disabled" : "") + '>' + (state.busy ? "Saving…" : "Save gas price") + '</button>' +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Tracked action</div>' +
								'<p class="privacy-note">' + icon("shield-check") + 'Every price change is saved to the plant activity log with your staff account.</p>' +
							'</aside>' +
						'</div>';
					}
					function renderPumps() {
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Manager permission</div>' +
								'<h1>Pump management</h1>' +
								'<p class="helper-text">Rename pumps and take a pump out of rotation when it is not working.</p>' +
								(pumps.length === 0 ? '<div class="state-message used">' + icon("warning-circle") + 'No pumps found. Add the first pump below.</div>' : '<div class="queue-list">' + pumps.map(pumpManageRow).join("") + '</div>') +
								messageHtml("pumps") +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Add pump</div>' +
								'<div class="term-field"><label class="field-label" for="new-pump-name">Pump name</label><input id="new-pump-name" class="term-input" value="' + escapeHtml(state.newPumpName) + '" placeholder="Pump 2" data-action="new-pump-name"/></div>' +
								'<div class="term-field"><label class="field-label" for="new-pump-status">Status</label><select id="new-pump-status" class="term-input" data-action="new-pump-status">' + statusOptions(state.newPumpStatus) + '</select></div>' +
								'<div class="term-field"><label class="field-label" for="new-pump-sort">Order</label><input id="new-pump-sort" class="term-input mono" value="' + escapeHtml(state.newPumpSort) + '" placeholder="' + (pumps.length + 1) + '" inputmode="numeric" data-action="new-pump-sort"/></div>' +
								'<button class="primary-action" type="button" data-action="save-new-pump" ' + (state.busy || state.newPumpName.trim() === "" ? "disabled" : "") + '>Add pump</button>' +
								'<p class="privacy-note">' + icon("shield-check") + 'Every pump change is saved to the plant activity log.</p>' +
							'</aside>' +
						'</div>';
					}
					function statusOptions(selected) {
						var opts = [
							["working", "Working"],
							["not_working", "Not working"],
							["maintenance", "Maintenance"]
						];
						return opts.map(function (opt) {
							return '<option value="' + opt[0] + '" ' + (selected === opt[0] ? "selected" : "") + '>' + opt[1] + '</option>';
						}).join("");
					}
					function pumpManageRow(p) {
						return '<div class="queue-row pump-manage-row">' +
							'<div class="pump-manage-fields">' +
								'<input class="term-input" value="' + escapeHtml(p.name) + '" placeholder="Pump name" data-action="pump-name" data-value="' + escapeHtml(p.id) + '"/>' +
								'<select class="term-input" data-action="pump-status" data-value="' + escapeHtml(p.id) + '">' + statusOptions(p.status) + '</select>' +
								'<input class="term-input mono" value="' + escapeHtml(p.sort_order || "") + '" placeholder="Order" inputmode="numeric" data-action="pump-sort" data-value="' + escapeHtml(p.id) + '"/>' +
							'</div>' +
							'<div><strong>' + escapeHtml(pumpStatusLabel(p.status)) + '</strong><span>' + (p.open_shift ? "In use now" : ((p.busy_count || 0) + " unfilled")) + '</span></div>' +
							'<button class="btn-like" type="button" data-action="save-pump" data-value="' + escapeHtml(p.id) + '">' + icon("check-circle") + 'Save</button>' +
						'</div>';
					}
					function renderStaff() {
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Manager permission</div>' +
								'<h1>Staff access</h1>' +
								'<p class="helper-text">Deactivate staff who should no longer use the terminal. You cannot deactivate your own account here.</p>' +
								(manageStaff.length === 0 ? '<div class="state-message used">' + icon("warning-circle") + 'No terminal staff found.</div>' : '<div class="queue-list">' + manageStaff.map(staffManageRow).join("") + '</div>') +
								messageHtml("staff") +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Tracked action</div>' +
								'<p class="privacy-note">' + icon("shield-check") + 'Every staff access change is saved to the plant activity log.</p>' +
							'</aside>' +
						'</div>';
					}
					function staffManageRow(row) {
						var self = row.id === state.userId;
						var nextActive = !row.active;
						var label = row.active ? "Deactivate" : "Activate";
						var statusClass = row.active ? "confirmed" : "used";
						return '<div class="queue-row staff-manage-row">' +
							'<div><strong>' + escapeHtml(row.name) + '</strong><span>' + roleLabel(row.role) + ' · ' + (row.active ? "Active" : "Inactive") + '</span></div>' +
							'<div class="state-message ' + statusClass + '">' + (row.active ? icon("check-circle") + 'Active' : icon("warning-circle") + 'Inactive') + '</div>' +
							'<button class="btn-like" type="button" data-action="staff-status" data-value="' + escapeHtml(row.id) + '" data-active="' + (nextActive ? "true" : "false") + '" ' + (self || state.busy ? "disabled" : "") + '>' + label + '</button>' +
						'</div>';
					}
					function renderReviews() {
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Customer feedback</div>' +
								'<h1>Reviews</h1>' +
								'<p class="helper-text">Ratings customers submit after their dispensing starts.</p>' +
								(reviews.length === 0 ? '<div class="state-message used">' + icon("warning-circle") + 'No customer reviews yet.</div>' : '<div class="queue-list">' + reviews.map(reviewRow).join("") + '</div>') +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Average</div>' +
								'<div class="stat-block"><div class="stat-value mono">' + escapeHtml(reviewAverage) + '</div><div class="stat-label">Customer rating</div></div>' +
								'<div class="stat-block"><div class="stat-value mono">' + reviewCount + '</div><div class="stat-label">Submitted reviews</div></div>' +
							'</aside>' +
						'</div>';
					}
					function reviewRow(row) {
						return '<div class="queue-row review-row">' +
							'<div><strong class="review-stars">' + escapeHtml(row.stars || "") + '</strong><span>' + escapeHtml(row.ticket || "Ticket") + ' · ' + escapeHtml(row.phone || "No phone") + ' · ' + escapeHtml(row.submitted_at || "") + '</span></div>' +
							'<p>' + escapeHtml(row.note || "No note") + '</p>' +
						'</div>';
					}
					function renderEnd() {
						var expectedKobo = state.cashHeldKobo + parseNairaInputToKobo(state.openingCash);
						if (!state.closingCash) state.closingCash = String(Math.round(expectedKobo / 100));
						return '<div class="term-layout">' +
							'<div class="term-main">' +
								'<div class="section-eyebrow">Shift end</div>' +
								'<h1>Count and close shift</h1>' +
								'<p class="helper-text">Use Log out if you only want to leave the terminal. This button closes the shift.</p>' +
								'<div class="term-field">' +
									'<label class="field-label" for="closing-cash">Closing cash count</label>' +
									'<input id="closing-cash" class="term-input mono" value="' + state.closingCash + '" placeholder="' + naira(expectedKobo) + '" inputmode="numeric" data-action="closing-cash"/>' +
								'</div>' +
								'<div class="term-field">' +
									'<label class="field-label" for="shift-notes">Shift note optional</label>' +
									'<textarea id="shift-notes" class="term-input term-textarea" placeholder="Short note for owner dashboard" data-action="shift-notes">' + escapeHtml(state.shiftNotes) + '</textarea>' +
								'</div>' +
								messageHtml("end", "wrong") +
								'<button class="primary-action" type="button" data-action="finish-shift" ' + (state.busy ? "disabled" : "") + '>' + (state.busy ? "Closing…" : "Submit and end shift") + '</button>' +
							'</div>' +
							'<aside class="term-aside">' +
								'<div class="section-eyebrow">Summary</div>' +
								'<div class="proof-row"><span>Fills completed</span><strong class="mono">' + state.fills + '</strong></div>' +
								'<div class="proof-row"><span>Kg dispensed</span><strong class="mono">' + kg(state.gramsDispensed) + '</strong></div>' +
								'<div class="proof-row"><span>Cash recorded</span><strong class="mono">' + naira(state.cashHeldKobo) + '</strong></div>' +
								'<div class="proof-row"><span>Expected close</span><strong class="mono">' + naira(expectedKobo) + '</strong></div>' +
							'</aside>' +
						'</div>';
					}

					function render() {
						root.innerHTML = '<div class="screen">' + (state.screen === "start" ? renderStart() : renderMain()) + '</div>';
					}

					root.addEventListener("click", function (event) {
						var target = event.target.closest("[data-action]");
						if (!target) return;
						var action = target.dataset.action;
						var value = target.dataset.value;
						if (action === "employee") setEmployee(value);
						if (action === "pump") setPump(value);
						if (action === "start-shift") startShift();
						if (action === "tab") setTab(value);
						if (action === "pin-digit") appendPin(value);
						if (action === "pin-back") backPin();
						if (action === "pin-clear") { state.pin = ""; render(); }
						if (action === "code-digit") appendCode(value);
						if (action === "code-back") backCode();
						if (action === "code-clear") clearCode();
						if (action === "confirm-fill") confirmFill();
						if (action === "record-cash") recordCash();
						if (action === "save-price") savePrice();
						if (action === "save-pump") savePump(value);
						if (action === "save-new-pump") savePump("");
						if (action === "staff-status") saveStaffStatus(value, target.dataset.active === "true");
						if (action === "refresh-queue") loadPumpQueue();
						if (action === "close-receipt") closeReceipt(value);
						if (action === "bulk-close") bulkCloseReceipts();
						if (action === "logout") logoutTerminal();
						if (action === "end-screen") setTab("end");
						if (action === "finish-shift") finishShift();
					});
					root.addEventListener("input", function (event) {
						var action = event.target.dataset.action;
						if (action === "opening-cash") { state.openingCash = event.target.value; syncStartButton(); }
						if (action === "cash-amount") { state.cashAmount = event.target.value; updateCashPreview(); }
						if (action === "phone") state.phone = event.target.value;
						if (action === "price-input") state.priceInput = event.target.value;
						if (action === "pump-name" || action === "pump-status" || action === "pump-sort") {
							var pump = pumps.find(function (p) { return p.id === event.target.dataset.value; });
							if (pump && action === "pump-name") pump.name = event.target.value;
							if (pump && action === "pump-status") pump.status = event.target.value;
							if (pump && action === "pump-sort") pump.sort_order = event.target.value;
						}
						if (action === "new-pump-name") state.newPumpName = event.target.value;
						if (action === "new-pump-status") state.newPumpStatus = event.target.value;
						if (action === "new-pump-sort") state.newPumpSort = event.target.value;
						if (action === "close-note") state.closeNote = event.target.value;
						if (action === "closing-cash") state.closingCash = event.target.value;
						if (action === "shift-notes") state.shiftNotes = event.target.value;
					});
					root.addEventListener("change", function (event) {
						var action = event.target.dataset.action;
						if (action === "pump-status") {
							var pump = pumps.find(function (p) { return p.id === event.target.dataset.value; });
							if (pump) pump.status = event.target.value;
						}
						if (action === "new-pump-status") state.newPumpStatus = event.target.value;
					});

					if (init.currentSession) {
						applySessionData(init.currentSession);
						if (state.tab === "queue") loadPumpQueue();
					}
					render();
				});
			</script>
		</head>
		<body>
			<div class="terminal-page">
				@templ.JSONScript("terminal-init", init)
				<div data-terminal data-plant={ terminalPlantName(plant) }></div>
			</div>
		</body>
	</html>
}
